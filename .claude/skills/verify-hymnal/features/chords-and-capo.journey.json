{
  "feature": "chords-and-capo",
  "platform": "ios",
  "steps": [
    {
      "name": "off",
      "action": "open",
      "link": "hymns/100",
      "expect": [
        { "shows": "id=key-button" },
        { "hides": "id=chord-1-1-1" },
        { "hides": "role=statictext label=KEY" }
      ],
      "receipt": "snapshot"
    },
    {
      "name": "chords",
      "action": "hold",
      "target": "id=key-button",
      "settle": 2,
      "expect": [{ "shows": "id=chord-1-1-1" }]
    },
    {
      "name": "chords-key",
      "action": "tap",
      "target": "id=key-button",
      "expect": [
        { "shows": "id=dial-key" },
        { "shows": "id=dial-capo" },
        { "hides": "label=Reset" }
      ]
    },
    {
      "name": "transpose",
      "action": "gesture",
      "from": "id=dial-key",
      "dx": -52,
      "dy": 0,
      "expect": [{ "shows": "label=Reset" }]
    },
    {
      "name": "chords-reset",
      "action": "tap",
      "target": "label=Reset",
      "expect": [{ "shows": "id=chord-1-1-1" }]
    },
    {
      "name": "reset-home",
      "action": "tap",
      "target": "id=key-button",
      "expect": [{ "shows": "id=dial-key" }, { "hides": "label=Reset" }]
    },
    {
      "name": "dials-close",
      "action": "tap",
      "target": "id=key-button",
      "expect": [{ "shows": "id=chord-1-1-1" }]
    },
    {
      "name": "chords-kept",
      "action": "relaunch"
    },
    {
      "name": "kept-after-relaunch",
      "action": "open",
      "link": "hymns/100",
      "expect": [{ "shows": "id=chord-1-1-1" }]
    },
    {
      "name": "chords-levels",
      "action": "open",
      "link": "hymns/181",
      "expect": [{ "shows": "label=No chords for this hymn yet." }, { "hides": "id=chord-1-1-1" }]
    },
    {
      "name": "chords-simple",
      "action": "open",
      "link": "hymns/3",
      "expect": [{ "shows": "id=chord-1-1-5" }, { "hides": "id=chord-1-1-6" }]
    },
    {
      "name": "chords-tap",
      "action": "tap",
      "target": "id=chord-1-1-1",
      "expect": [
        { "shows": "id=chord-sheet" },
        { "shows": "id=chord-box-0" },
        { "shows": "label=Done" }
      ]
    },
    {
      "name": "chord-sheet-done",
      "action": "tap",
      "target": "label=Done",
      "expect": [{ "shows": "id=key-button" }, { "hides": "id=chord-sheet" }]
    },
    {
      "name": "chords-off",
      "action": "hold",
      "target": "id=key-button",
      "expect": [{ "hides": "id=chord-1-1-1" }]
    },
    {
      "name": "chords-mode-simple",
      "action": "open",
      "link": "hymns/100",
      "expect": [
        { "shows": "id=key-button" },
        { "hides": "role=statictext label=KEY" },
        { "hides": "id=chord-1-1-1" }
      ],
      "receipt": "snapshot"
    },
    {
      "name": "chords-mode-simple-sheet",
      "action": "tap",
      "target": "label=Open player",
      "expect": [{ "shows": "label=Sheet Grabber" }, { "shows": "id=dial-tempo" }],
      "receipt": "snapshot"
    },
    {
      "name": "chords-mode-simple-switch",
      "action": "scroll",
      "target": "role=switch label=Chords",
      "direction": "down",
      "expect": [
        { "shows": "role=switch label=Chords" },
        { "hides": "id=dial-key" },
        { "hides": "id=dial-capo" },
        { "hides": "id=dial-placement" }
      ],
      "receipt": "snapshot"
    },
    {
      "name": "chords-mode-simple-close",
      "action": "gesture",
      "from": "role=button label=Sheet Grabber",
      "dx": 0,
      "dy": 760,
      "ms": 400,
      "expect": [{ "shows": "id=key-button" }, { "hides": "label=Sheet Grabber" }],
      "receipt": "none"
    },
    {
      "name": "chords-mode-on",
      "action": "tap",
      "target": "id=key-button",
      "expect": [
        { "shows": "id=chord-1-1-1" },
        { "shows": "id=key-face" },
        { "hides": "id=dials" }
      ],
      "receipt": "snapshot"
    },
    {
      "name": "chords-mode-on-sheet",
      "action": "tap",
      "target": "label=Open player",
      "expect": [{ "shows": "label=Sheet Grabber" }],
      "receipt": "none"
    },
    {
      "name": "chords-mode-on-dials",
      "action": "scroll",
      "target": "id=dial-placement",
      "direction": "down",
      "expect": [
        { "shows": "role=switch label=Chords" },
        { "shows": "id=dial-key" },
        { "shows": "id=dial-capo" },
        { "shows": "id=dial-placement" }
      ],
      "receipt": "snapshot"
    },
    {
      "name": "chords-mode-off",
      "action": "tap",
      "target": "role=switch label=Chords",
      "expect": [
        { "hides": "id=dial-key" },
        { "hides": "id=dial-capo" },
        { "hides": "id=dial-placement" }
      ],
      "receipt": "snapshot"
    },
    {
      "name": "chords-mode-off-close",
      "action": "gesture",
      "from": "role=button label=Sheet Grabber",
      "dx": 0,
      "dy": 760,
      "ms": 400,
      "expect": [
        { "shows": "id=key-button" },
        { "hides": "label=Sheet Grabber" },
        { "hides": "id=chord-1-1-1" }
      ],
      "receipt": "snapshot"
    },
    {
      "name": "chords-mode-kept-on",
      "action": "tap",
      "target": "id=key-button",
      "expect": [{ "shows": "id=chord-1-1-1" }],
      "receipt": "none"
    },
    {
      "name": "chords-mode-kept-relaunch",
      "action": "relaunch",
      "receipt": "none"
    },
    {
      "name": "chords-mode-kept",
      "action": "open",
      "link": "hymns/100",
      "expect": [{ "shows": "id=chord-1-1-1" }, { "shows": "id=key-face" }],
      "receipt": "snapshot"
    },
    {
      "name": "chords-mode-kept-off",
      "action": "hold",
      "target": "id=key-button",
      "expect": [{ "hides": "id=chord-1-1-1" }],
      "receipt": "snapshot"
    }
  ]
}
