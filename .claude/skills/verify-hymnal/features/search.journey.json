{
  "feature": "search",
  "platform": "ios",
  "steps": [
    {
      "name": "home",
      "action": "open",
      "link": "/",
      "expect": [{ "shows": "id=find-search" }, { "hides": "id=find-box" }]
    },
    {
      "name": "search",
      "action": "tap",
      "target": "id=find-search",
      "expect": [{ "shows": "id=find-box" }, { "shows": "id=find-cancel" }]
    },
    {
      "name": "search-number",
      "action": "fill",
      "target": "id=find-box",
      "value": "no 100",
      "expect": [{ "shows": "label=100, Great Is Thy Faithfulness" }]
    },
    {
      "name": "search-number-forms",
      "action": "fill",
      "target": "id=find-box",
      "value": "#100",
      "expect": [{ "shows": "label=100, Great Is Thy Faithfulness" }]
    },
    {
      "name": "search-number-hymn",
      "action": "fill",
      "target": "id=find-box",
      "value": "Hymn #100",
      "expect": [{ "shows": "label=100, Great Is Thy Faithfulness" }]
    },
    {
      "name": "search-about",
      "action": "fill",
      "target": "id=find-box",
      "value": "hymns about the second coming",
      "timeout": 15,
      "expect": [{ "shows": "label=Hymns about this" }]
    },
    {
      "name": "search-scripture",
      "action": "fill",
      "target": "id=find-box",
      "value": "Psalm 23",
      "expect": [{ "shows": "label=Cancel" }]
    },
    {
      "name": "search-number-again",
      "action": "fill",
      "target": "id=find-box",
      "value": "no 100",
      "expect": [
        { "shows": "label=100, Great Is Thy Faithfulness" },
        { "hides": "label=Hymns about this" }
      ]
    },
    {
      "name": "search-open",
      "action": "tap",
      "target": "label=100, Great Is Thy Faithfulness",
      "expect": [{ "shows": "label=Stanza 1" }]
    },
    {
      "name": "query-kept",
      "action": "back",
      "expect": [{ "shows": "label=Cancel" }, { "shows": "label=100, Great Is Thy Faithfulness" }]
    },
    {
      "name": "search-empty",
      "action": "fill",
      "target": "id=find-box",
      "value": "zzzz",
      "expect": [{ "shows": "label=No hymn matches “zzzz”." }]
    },
    {
      "name": "search-cancel",
      "action": "tap",
      "target": "id=find-cancel",
      "expect": [{ "shows": "id=find-search" }, { "hides": "id=find-cancel" }]
    },
    {
      "name": "search-in-hymn",
      "action": "open",
      "link": "hymns/8",
      "expect": [
        { "shows": "id=find-bar" },
        { "shows": "id=find-search" },
        { "shows": "id=find-number" },
        { "shows": "id=key-button" }
      ]
    },
    {
      "name": "search-in-hymn-box",
      "action": "tap",
      "target": "id=find-search",
      "expect": [
        { "shows": "id=find-box" },
        { "shows": "id=find-cancel" },
        { "hides": "id=key-button" }
      ]
    },
    {
      "name": "search-in-hymn-fill",
      "action": "fill",
      "target": "id=find-box",
      "value": "100",
      "expect": [{ "shows": "label=100, Great Is Thy Faithfulness" }]
    },
    {
      "name": "search-in-hymn-open",
      "action": "tap",
      "target": "label=100, Great Is Thy Faithfulness",
      "expect": [
        { "shows": "label=Play hymn 100" },
        { "shows": "id=find-search" },
        { "hides": "id=find-box" }
      ]
    },
    {
      "name": "search-in-hymn-back",
      "action": "back",
      "expect": [{ "shows": "id=find-box" }, { "shows": "id=find-cancel" }]
    },
    {
      "name": "search-in-hymn-cancel",
      "action": "tap",
      "target": "id=find-cancel",
      "expect": [
        { "shows": "id=find-search" },
        { "shows": "id=key-button" },
        { "hides": "id=find-cancel" }
      ]
    },
    {
      "name": "search-in-hymn-number",
      "action": "tap",
      "target": "id=find-number",
      "expect": [{ "shows": "id=find-drums" }, { "shows": "id=find-open" }]
    },
    {
      "name": "search-in-hymn-dialled",
      "action": "tap",
      "target": "id=find-open",
      "expect": [{ "shows": "id=find-search" }, { "hides": "id=find-drums" }]
    }
  ]
}
