{
  "feature": "settings",
  "platform": "ios",
  "steps": [
    {
      "name": "home",
      "action": "open",
      "link": "/",
      "expect": [{ "shows": "role=button label=Settings" }],
      "receipt": "none"
    },
    {
      "name": "settings",
      "action": "open",
      "link": "settings",
      "expect": [
        { "shows": "label=Appearance" },
        { "shows": "label=Dark" },
        { "shows": "label=System" }
      ]
    },
    {
      "name": "dark",
      "action": "tap",
      "target": "label=Dark",
      "expect": [{ "shows": "label=Dark" }]
    },
    {
      "name": "leave",
      "action": "gesture",
      "from": "role=button label=Sheet Grabber",
      "dx": 0,
      "dy": 400,
      "ms": 300,
      "expect": [{ "shows": "role=button label=Settings" }, { "hides": "label=Sheet Grabber" }]
    },
    {
      "name": "second-view",
      "action": "tap",
      "target": "role=button label=Settings",
      "expect": [{ "shows": "label=Dark" }]
    },
    {
      "name": "system",
      "action": "tap",
      "target": "label=System",
      "expect": [{ "shows": "label=System" }]
    },
    {
      "name": "about",
      "action": "scroll",
      "target": "screen",
      "direction": "down",
      "expect": [{ "shows": "label=Sounds and haptics" }]
    },
    {
      "name": "settings-chords",
      "action": "tap",
      "target": "label=Advanced",
      "expect": [{ "shows": "label=Advanced" }]
    },
    {
      "name": "settings-feel",
      "action": "tap",
      "target": "role=switch label=Sounds and haptics",
      "expect": [{ "shows": "label=Sounds and haptics" }]
    },
    {
      "name": "relaunch",
      "action": "relaunch"
    },
    {
      "name": "kept",
      "action": "open",
      "link": "settings",
      "expect": [{ "shows": "label=Advanced" }]
    },
    {
      "name": "style-put-back",
      "action": "tap",
      "target": "label=Simple",
      "expect": [{ "shows": "label=Simple" }]
    },
    {
      "name": "kept-feel",
      "action": "scroll",
      "target": "role=switch label=Sounds and haptics",
      "direction": "down",
      "expect": [{ "shows": "label=Sounds and haptics" }]
    },
    {
      "name": "feel-put-back",
      "action": "tap",
      "target": "role=switch label=Sounds and haptics",
      "expect": [{ "shows": "label=Sounds and haptics" }]
    },
    {
      "name": "close",
      "action": "gesture",
      "from": "role=button label=Sheet Grabber",
      "dx": 0,
      "dy": 760,
      "ms": 400,
      "expect": [{ "shows": "role=button label=Settings" }, { "hides": "label=Sheet Grabber" }]
    }
  ]
}
