{
  "feature": "hymn-list",
  "platform": "ios",
  "steps": [
    {
      "name": "hymn-list",
      "action": "relaunch",
      "timeout": 30,
      "expect": [
        { "shows": "role=link label=1, Praise to the Lord" },
        { "shows": "role=link label=2, All Creatures of Our God and King" }
      ]
    },
    {
      "name": "past-recent",
      "action": "scroll",
      "target": "screen",
      "direction": "down",
      "expect": [{ "hides": "label=Recent, see all" }]
    },
    {
      "name": "scroll",
      "action": "scroll",
      "target": "role=link label=31, Tell Out My Soul",
      "direction": "down",
      "expect": [{ "shows": "role=link label=31, Tell Out My Soul" }]
    },
    {
      "name": "open-row",
      "action": "tap",
      "target": "role=link label=31, Tell Out My Soul",
      "expect": [{ "shows": "label=Stanza 1" }, { "shows": "label=Play hymn 31" }]
    },
    {
      "name": "back-keeps-place",
      "action": "back",
      "expect": [
        { "shows": "role=link label=31, Tell Out My Soul" },
        { "hides": "role=link label=1, Praise to the Lord" }
      ]
    },
    {
      "name": "list-top",
      "action": "scroll",
      "target": "role=other label=Sections",
      "direction": "up",
      "expect": [{ "shows": "role=other label=Sections" }]
    },
    {
      "name": "down-1",
      "action": "scroll",
      "target": "screen",
      "direction": "down"
    },
    {
      "name": "down-2",
      "action": "scroll",
      "target": "screen",
      "direction": "down"
    },
    {
      "name": "down-3",
      "action": "scroll",
      "target": "screen",
      "direction": "down"
    },
    {
      "name": "list-tabs-hide",
      "action": "scroll",
      "target": "screen",
      "direction": "down",
      "expect": [{ "hides": "role=other label=Sections" }]
    },
    {
      "name": "list-tabs-reveal",
      "action": "scroll",
      "target": "screen",
      "direction": "up",
      "expect": [
        { "shows": "role=other label=Sections" },
        { "hides": "label=Number, title or first line" }
      ]
    },
    {
      "name": "list-tabs-tap",
      "action": "tap",
      "target": "role=other label=Lists",
      "expect": [{ "shows": "role=other label=Lists" }]
    },
    {
      "name": "list-tabs-back",
      "action": "tap",
      "target": "role=other label=Sections",
      "expect": [{ "shows": "role=other label=Sections" }]
    },
    {
      "name": "list-tabs-gone",
      "action": "scroll",
      "target": "screen",
      "direction": "down",
      "expect": [{ "hides": "role=other label=Sections" }]
    }
  ]
}
