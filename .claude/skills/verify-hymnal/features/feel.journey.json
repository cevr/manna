{
  "feature": "feel",
  "platform": "ios",
  "steps": [
    {
      "name": "feel-voice",
      "action": "open",
      "link": "hymns/100",
      "expect": [{ "shows": "id=key-button" }]
    },
    {
      "name": "chords-on",
      "action": "hold",
      "target": "id=key-button",
      "settle": 2,
      "expect": [{ "shows": "id=chord-1-1-1" }]
    },
    {
      "name": "dials",
      "action": "tap",
      "target": "id=key-button",
      "expect": [{ "shows": "id=dial-capo" }]
    },
    {
      "name": "feel-cues",
      "action": "gesture",
      "from": "id=dial-capo",
      "dx": -52,
      "dy": 0,
      "expect": [{ "shows": "label=Reset" }]
    },
    {
      "name": "capo-down",
      "action": "gesture",
      "from": "id=dial-capo",
      "dx": 52,
      "dy": 0,
      "expect": [{ "shows": "id=dial-capo" }]
    },
    {
      "name": "key-up",
      "action": "gesture",
      "from": "id=dial-key",
      "dx": -52,
      "dy": 0,
      "expect": [{ "shows": "label=Reset" }]
    },
    {
      "name": "reset",
      "action": "tap",
      "target": "label=Reset",
      "expect": [{ "shows": "id=key-button" }]
    },
    {
      "name": "settings",
      "action": "open",
      "link": "settings",
      "expect": [{ "shows": "label=Sounds and haptics" }]
    },
    {
      "name": "feel-off",
      "action": "tap",
      "target": "label=Sounds and haptics",
      "expect": [{ "shows": "label=Sounds and haptics" }]
    },
    {
      "name": "hymn-off",
      "action": "open",
      "link": "hymns/100",
      "expect": [{ "shows": "id=chord-1-1-1" }]
    },
    {
      "name": "dials-off",
      "action": "tap",
      "target": "id=key-button",
      "expect": [{ "shows": "id=dial-capo" }]
    },
    {
      "name": "capo-off",
      "action": "gesture",
      "from": "id=dial-capo",
      "dx": -52,
      "dy": 0,
      "expect": [{ "shows": "label=Reset" }]
    },
    {
      "name": "reset-off",
      "action": "tap",
      "target": "label=Reset",
      "expect": [{ "shows": "id=key-button" }]
    },
    {
      "name": "chords-put-back",
      "action": "hold",
      "target": "id=key-button",
      "settle": 2,
      "expect": [{ "hides": "id=chord-1-1-1" }]
    },
    {
      "name": "settings-again",
      "action": "open",
      "link": "settings",
      "expect": [{ "shows": "label=Sounds and haptics" }]
    },
    {
      "name": "feel-put-back",
      "action": "tap",
      "target": "label=Sounds and haptics",
      "expect": [{ "shows": "label=Sounds and haptics" }]
    }
  ]
}
