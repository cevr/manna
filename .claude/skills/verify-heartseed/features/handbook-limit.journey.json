{
  "feature": "handbook-limit",
  "platform": "ios",
  "steps": [
    {
      "name": "handbook-limit-home",
      "action": "open",
      "link": "/",
      "relaunch": false,
      "expect": [{ "shows": "id=today-card" }],
      "receipt": "none"
    },
    {
      "name": "handbook-limit-foot",
      "action": "scroll",
      "target": "id=add-list",
      "direction": "down",
      "expect": [{ "shows": "id=add-list" }],
      "receipt": "none"
    },
    {
      "name": "handbook-limit-sheet",
      "action": "tap",
      "target": "id=add-list",
      "expect": [{ "shows": "label=Psalms" }],
      "receipt": "none"
    },
    {
      "name": "handbook-limit-psalms",
      "action": "tap",
      "target": "label=Psalms",
      "expect": [{ "shows": "label=Plant Psalms 46:1-3" }],
      "receipt": "none"
    },
    {
      "name": "handbook-limit",
      "action": "tap",
      "target": "label=Plant Psalms 46:1-3",
      "expect": [
        { "shows": "id=today-card" },
        { "hides": "label=Any passage" },
        { "hides": "label=Remove" }
      ],
      "receipt": "none"
    },
    {
      "name": "handbook-limit-row",
      "action": "scroll",
      "target": "label=Open Psalms 46:1-3",
      "direction": "up",
      "expect": [{ "shows": "label=Open Psalms 46:1-3" }],
      "receipt": "snapshot"
    },
    {
      "name": "handbook-limit-line",
      "action": "scroll",
      "target": "id=limit",
      "direction": "down",
      "expect": [{ "shows": "id=limit" }, { "hides": "id=add-list" }],
      "receipt": "snapshot"
    }
  ]
}
