{
  "feature": "sayit-lines",
  "platform": "ios",
  "steps": [
    {
      "name": "sayit-lines-start",
      "action": "open",
      "link": "/",
      "relaunch": false,
      "expect": [{ "shows": "label=Isaiah 43:2" }, { "shows": "label=Say it" }],
      "receipt": "none"
    },
    {
      "name": "sayit-lines-listening",
      "action": "tap",
      "target": "label=Say it",
      "receipt": "none"
    },
    {
      "name": "lines-say",
      "action": "tap",
      "target": "label=7 of 38 words",
      "timeout": 30,
      "expect": [{ "shows": "label=Next" }, { "hides": "label=Listening" }],
      "receipt": "snapshot"
    },
    {
      "name": "lines-say-next",
      "action": "tap",
      "target": "label=Next",
      "expect": [{ "hides": "label=Next" }, { "hides": "label=7 of 38 words" }],
      "receipt": "none"
    }
  ]
}
