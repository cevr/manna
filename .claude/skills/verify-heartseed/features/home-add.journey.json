{
  "feature": "home-add",
  "platform": "ios",
  "steps": [
    {
      "name": "home-add-start",
      "action": "open",
      "link": "/",
      "relaunch": false,
      "expect": [{ "shows": "id=today-card" }],
      "receipt": "none"
    },
    {
      "name": "home-add-top",
      "action": "gesture",
      "from": "label=Open Isaiah 41:10",
      "dx": 0,
      "dy": 500,
      "expect": [{ "shows": "id=add-list" }],
      "receipt": "none"
    },
    {
      "name": "home-add-sheet",
      "action": "tap",
      "target": "id=add-list",
      "expect": [
        { "shows": "label=Done" },
        { "shows": "label=Any passage" },
        { "shows": "label=Psalms" },
        { "shows": "label=Proverbs" },
        { "shows": "label=The Gospel of John" }
      ],
      "receipt": "snapshot"
    },
    {
      "name": "home-add-proverbs",
      "action": "tap",
      "target": "label=Proverbs",
      "expect": [
        { "shows": "label=Plant Proverbs 4:23" },
        { "shows": "label=Plant Proverbs 15:1" },
        { "shows": "label=In your field" },
        { "hides": "label=Plant Proverbs 18:10" }
      ],
      "receipt": "snapshot"
    },
    {
      "name": "home-add-psalms",
      "action": "tap",
      "target": "label=Psalms",
      "expect": [{ "shows": "label=Plant Psalms 46:1-3" }],
      "receipt": "none"
    },
    {
      "name": "home-add-planted",
      "action": "tap",
      "target": "label=Plant Psalms 46:1-3",
      "expect": [
        { "shows": "id=today-card" },
        { "shows": "label=Psalms 46:1, not planted" },
        { "shows": "label=Psalms 46:3, not planted" },
        { "hides": "label=Any passage" }
      ],
      "receipt": "snapshot"
    },
    {
      "name": "home-add-again",
      "action": "tap",
      "target": "id=add-list",
      "expect": [{ "shows": "label=Any passage" }],
      "receipt": "none"
    },
    {
      "name": "home-add-any",
      "action": "tap",
      "target": "label=Any passage",
      "expect": [{ "shows": "label=Add a passage" }, { "shows": "label=Add verses" }],
      "receipt": "snapshot"
    },
    {
      "name": "home-add-any-back",
      "action": "tap",
      "target": "label=Add verses",
      "expect": [{ "shows": "label=Any passage" }, { "shows": "label=Done" }],
      "receipt": "none"
    },
    {
      "name": "home-add-done",
      "action": "tap",
      "target": "label=Done",
      "expect": [{ "shows": "id=today-card" }, { "hides": "label=Any passage" }],
      "receipt": "none"
    }
  ]
}
