fail fetch "https://egw.cvr.im"
epoch "2026-11-14T12:00:00Z"
time-zone "America/New_York"
seed 7

test "Today shows the passage under no cue, every word a hidden slot"
  at "/cue/none"
  clock settle
  expect text "reference" == "Isaiah 41:10"
  expect state today.cue == "none"
  expect state today.words.length == 37
  expect state today.words.0.shown == "____"
  expect state today.words.0.face == "slot"
  expect state today.words.0.label == "Word 1"
  expect state today.words.0.peekable == true
  expect state today.cap == 4
  expect enabled "hear"
  expect enabled "say"
  expect enabled "show-all"
  expect text "hear" == "Listen"
  expect text "say" == "Say it"
  expect text "show-all" == "Show all"
  expect tree missing "last"
  expect tree missing "result"
  expect tree missing "refused"
  expect tree missing "help-line"
  expect no failures

test "Under the full text every word reads whole, with nothing to peek at"
  at "/cue/full"
  clock settle
  expect state today.cue == "full"
  expect text "word-0" == "Fear"
  expect state today.words.0.peekable == false
  expect tree missing "show-all"
  expect no failures

test "First letters: a tap on a word shows it a moment, and the try counts as Hard at best"
  at "/cue/initials"
  clock settle
  expect state today.cue == "initials"
  expect text "face-0-letter" == "F"
  expect text "face-3-letter" == "f"
  expect state today.words.3.face == "letters"
  expect state today.words.3.label == "f"
  tap "word-3"
  clock settle
  expect text "word-3" == "for"
  expect state today.words.3.label == "for"
  expect state today.peeking == 3
  expect state today.cap == 2
  expect text "help-line" == "1 word peeked: this try counts as Hard at best."
  clock +1300
  expect text "word-3" == "for"
  clock +200
  clock settle
  expect text "face-3-letter" == "f"
  expect state today.peeking == -1
  expect state today.cap == 2
  expect no failures

test "Show all shows every word, says the cost, and caps the try"
  at "/cue/initials"
  clock settle
  tap "show-all"
  clock settle
  expect text "word-0" == "Fear"
  expect text "word-3" == "for"
  expect state today.shownAll == true
  expect state today.moveBack == true
  expect state today.cap == 2
  expect text "help-line" == "Shown whole: this try counts as Hard at best, and the verse moves back a stage."
  expect tree missing "show-all"
  expect state today.words.3.peekable == false
  expect no failures

test "Hear it lights every word, then rests"
  at "/cue/none"
  clock settle
  tap "hear"
  clock +1000
  expect state today.lit >= 1
  expect state today.lit <= 37
  expect tree has "stop"
  expect tree missing "hear"
  clock +1000
  expect state today.lit >= 3
  expect state today.lit <= 37
  clock +1000
  expect state today.lit >= 6
  expect state today.lit <= 37
  clock +1000
  expect state today.lit >= 9
  expect state today.lit <= 37
  clock +1000
  expect state today.lit >= 12
  expect state today.lit <= 37
  clock +1000
  expect state today.lit >= 15
  expect state today.lit <= 37
  clock +1000
  expect state today.lit >= 18
  expect state today.lit <= 37
  clock +1000
  expect state today.lit >= 20
  expect state today.lit <= 37
  clock +1000
  expect state today.lit >= 23
  expect state today.lit <= 37
  clock +1000
  expect state today.lit >= 26
  expect state today.lit <= 37
  clock +1000
  expect state today.lit >= 29
  expect state today.lit <= 37
  clock +1000
  expect state today.lit >= 32
  expect state today.lit <= 37
  clock +1000
  expect state today.lit >= 35
  expect state today.lit <= 37
  clock +1000
  expect state today.lit == 37
  expect state today.words.36.lit == true
  clock +4000
  clock settle
  expect state today.phase == "resting"
  expect state today.lit == 37
  expect enabled "hear"
  expect enabled "say"
  tap "hear"
  clock +3000
  expect state today.phase == "reading"
  expect state today.lit >= 1
  expect state today.lit <= 36
  tap "stop"
  clock settle
  expect state today.phase == "resting"
  expect tree missing "stop"
  expect enabled "hear"
  expect enabled "say"
  expect no failures

test "A hold on the fifth word while the second is read, lifted there, reads on from the fifth"
  at "/cue/none"
  clock settle
  tap "hear"
  clock +600
  clock data
  expect state today.lit >= 1
  expect state today.lit <= 2
  expect state todayUtterance == "utterance-1"
  tap "word-4" drag 1 0 press 400 over 16 hold 16
  clock data
  expect state today.askKey == 2
  expect state today.ask == "seek"
  expect state today.heldWord == -1
  expect state today.holding == false
  expect state todayUtterance == "utterance-2"
  expect state todayVoiceState.utterance == "utterance-2"
  expect state todayVoiceState.paused == false
  expect state today.phase == "reading"
  expect state today.lit == 5
  expect state today.words.3.face == "text"
  expect state today.words.4.face == "text"
  expect state today.words.5.face == "slot"
  clock +500
  clock data
  expect state today.lit == 6
  expect state today.words.5.face == "text"
  clock +1000
  clock data
  expect state today.lit == 9
  expect no failures

test "A hold dragged from the fifth word to the eighth reads on from the eighth" on web
  at "/cue/full"
  clock settle
  tap "hear"
  clock +600
  clock data
  tap "word-4" drag to "word-7" mouse press 400 over 160 hold 16
  clock data
  expect state today.ask == "seek"
  expect state todayUtterance == "utterance-2"
  expect state today.lit == 8
  expect state today.words.6.lit == true
  expect state today.words.8.lit == false
  clock +500
  clock data
  expect state today.lit == 9
  expect no failures

test "A finger held on the fifth word and dragged to the eighth reads on from the eighth" on ios
  at "/cue/full"
  clock settle
  tap "hear"
  clock +600
  clock data
  tap "word-4" drag to "word-7" press 400 over 160 hold 16
  clock data
  clock +1
  clock data
  expect state today.ask == "seek"
  expect state todayUtterance == "utterance-2"
  expect state today.lit >= 7
  expect state today.lit <= 9
  expect no failures

test "Under no cue a hold dragged from the fifth word to the eighth, lighting the words between as it goes, still lifts there and reads on from the eighth" on web
  at "/cue/none"
  clock settle
  tap "hear"
  clock +600
  clock data
  tap "word-4" drag to "word-7" mouse press 400 over 160 hold 16
  clock data
  clock +1
  clock data
  expect state today.ask == "seek"
  expect state todayUtterance == "utterance-2"
  expect state today.heldWord == -1
  expect state today.lit >= 7
  expect state today.lit <= 9
  expect state today.words.6.face == "text"
  expect no failures

test "On the web a finger dragged after its hold is taken by the browser: the hold ends as a cancel and the reading resumes where it paused" on web
  at "/cue/full"
  clock settle
  tap "hear"
  clock +600
  clock data
  tap "word-4" drag 0 80 press 400 over 200 hold 16
  clock data
  expect state today.askKey == 2
  expect state today.ask == "resume"
  expect state todayUtterance == "utterance-1"
  expect state todayVoiceState.paused == false
  expect state today.heldWord == -1
  expect state today.phase == "reading"
  expect state today.lit >= 1
  expect state today.lit <= 3
  clock +2000
  clock data
  expect state today.lit >= 6
  expect no failures

test "A quick swipe on the words while the voice reads holds nothing"
  at "/cue/full"
  clock settle
  tap "hear"
  clock +600
  clock data
  tap "word-4" drag 0 80 over 100
  clock +500
  clock data
  expect state today.askKey == 0
  expect state today.heldWord == -1
  expect state todayUtterance == "utterance-1"
  expect state todayVoiceState.paused == false
  expect state today.lit >= 2
  expect no failures

test "A hold on the words with no reading under way does nothing"
  at "/cue/full"
  clock settle
  tap "word-4" drag 1 0 press 400 over 16 hold 16
  clock data
  expect state today.askKey == 0
  expect state today.heldWord == -1
  expect state today.phase == "resting"
  expect state todayUtterance == ""
  expect enabled "hear"
  expect no failures
