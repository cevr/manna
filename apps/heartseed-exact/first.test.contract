fail fetch "https://egw.cvr.im"
epoch "2026-11-14T12:00:00Z"
time-zone "America/New_York"
seed 7

test "A fresh store opens the welcome over home, with no bar and no tab bar"
  clock data
  clock settle
  expect state startShown.opening == "first"
  expect state startShown.route == "/first/welcome/none"
  expect state first.phase == "welcome"
  expect tree has "first-welcome"
  expect text "first-heading" == "Heartseed"
  expect text "first-line" == "Plant a verse. Say it from memory. Watch it grow."
  expect text "reference" == "Isaiah 41:10"
  expect tree has "growing"
  expect enabled "first-begin"
  expect enabled "first-skip"
  expect state readSheetUp == true
  expect no failures

test "Begin shows how a verse grows, and its button starts the verse heard whole"
  clock data
  clock settle
  tap "first-begin"
  clock settle
  expect state first.phase == "grows"
  expect text "first-heading" == "Every verse is a plant"
  expect text "first-caption" == "Mark 4:28"
  expect text "first-on" == "Plant your first verse"
  tap "first-on"
  clock data
  clock settle
  expect state first.phase == "hear"
  expect state today.cue == "full"
  expect state today.words.length == 37
  expect text "first-heading" == "Hear it"
  expect tree has "phase-bar"
  expect enabled "first-next"
  expect no failures

test "Skip goes straight to the verse heard whole"
  clock data
  clock settle
  tap "first-skip"
  clock data
  clock settle
  expect state first.phase == "hear"
  expect state today.cue == "full"
  expect no failures

test "Next says it with its first letters"
  clock data
  clock settle
  tap "first-skip"
  clock data
  clock settle
  tap "first-next"
  clock data
  clock settle
  expect state first.phase == "letters"
  expect state today.cue == "initials"
  expect text "first-heading" == "Say it with help"
  expect text "first-say" == "Say it"
  expect no failures

test "The voice's reading heard to its end moves hear on to letters"
  clock data
  clock settle
  tap "first-skip"
  clock data
  clock settle
  tap "first-listen"
  clock +20000
  clock settle
  clock +1000
  clock settle
  expect state first.phase == "letters"
  expect state today.cue == "initials"
  expect no failures

test "A launch at a later step of the first minute opens the welcome"
  at "/first/alone/none"
  clock data
  clock settle
  expect state first.phase == "welcome"
  expect tree has "first-welcome"
  expect no failures

test "The platform's Back does not leave the first minute, which is the whole app"
  clock data
  clock settle
  back
  clock settle
  expect tree has "first-welcome"
  expect state firstHeld == true
  tap "first-skip"
  clock data
  clock settle
  back
  clock settle
  expect state first.phase == "hear"
  expect tree has "first-hear"
  expect no failures

test "How Heartseed works replays the welcome and how a verse grows, then home shows its tips until Got it"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  expect tree missing "tip-1"
  expect text "home-how" == "How Heartseed works›"
  tap "home-how"
  clock data
  clock settle
  expect state first.tour == "welcome"
  expect tree has "first-welcome"
  expect tree missing "reference"
  back
  clock settle
  expect tree has "first-welcome"
  tap "first-begin"
  clock settle
  expect state first.tour == "grows"
  expect text "first-on" == "See your field"
  tap "first-on"
  clock data
  clock settle
  expect state first.tour == "tips"
  expect tree missing "first"
  expect text "tip-1" == "1Come back each day and tap Start. It brings what is ready."
  expect tree missing "tip-2"
  expect text "tip-3" == "3Add a psalm, a passage or a set of promises when you want more."
  expect text "home-got-it" == "Got it"
  tap "home-got-it"
  clock settle
  expect state first.tour == "off"
  expect tree missing "tip-1"
  expect tree missing "home-got-it"
  expect no failures

test "Show the welcome again in Settings replays the welcome over home, and its Skip ends the tour there"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  tap "gear"
  clock settle
  expect text "settings-welcome" == "Show the welcome again"
  tap "settings-welcome"
  clock data
  clock settle
  expect tree missing "settings"
  expect state first.tour == "welcome"
  expect tree has "first-welcome"
  tap "first-skip"
  clock data
  clock settle
  expect state first.tour == "off"
  expect tree missing "first"
  expect tree has "home"
  expect no failures

test "Leaving home for another screen ends the tips; the Add a list sheet does not"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  tap "home-how"
  clock data
  clock settle
  tap "first-begin"
  clock settle
  tap "first-on"
  clock data
  clock settle
  tap "add-list"
  clock data
  clock settle
  expect state first.tour == "tips"
  tap "add-done"
  clock settle
  expect tree has "tip-1"
  tap "tab-read"
  clock data
  clock settle
  tap "tab-garden"
  clock data
  clock settle
  expect state first.tour == "off"
  expect tree missing "tip-1"
  expect no failures
