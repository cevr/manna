epoch "2026-11-14T12:00:00Z"
time-zone "America/New_York"
seed 7

test "Go to opens a book, then a chapter, on the chapter screen"
  clock data
  clock settle
  tap "tab-read"
  clock data
  clock settle
  expect text "chapter-title" == "John 1"
  expect text "chapter-hint" == "Tap a verse to plant or study it. Hold a word for its Hebrew or Greek."
  expect tree missing "chapter-field"
  tap "chapter-title"
  clock data
  clock settle
  expect tree has "goto"
  expect text "book-43" == "John"
  tap "book-43"
  clock data
  clock settle
  expect text "chapter-3" == "3"
  tap "chapter-3"
  clock data
  clock settle
  expect tree missing "goto"
  expect state chapterShown.heading == "John 3"
  expect state chapterShown.count == 36
  expect state readBookKept == "43"
  expect state readChapterKept == "3"
  expect state chooserWords.reference == "John 3:1-36"
  expect state chooserWords.verses.15.verse == 16
  expect tree has "verse-16"
  expect tree has "verse-36"
  expect tree missing "verse-37"
  expect tree missing "chapter-bar"
  expect tree missing "range-line"
  expect tree missing "plant-list"
  expect no failures

test "Fewer than three is not a list"
  clock data
  clock settle
  tap "tab-read"
  clock data
  clock settle
  tap "chapter-title"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-16"
  clock data
  expect tree has "chapter-bar"
  expect text "range-line" == "John 3:16"
  expect text "range-count" == "1 verse"
  expect tree has "chapter-study"
  expect text "short-line" == "A list holds at least 3 verses."
  expect tree missing "plant-list"
  expect enabled "plant-singles"
  expect text "plant-singles" == "Add to single verses"
  tap "verse-17"
  clock data
  expect text "range-line" == "John 3:16-17"
  expect tree missing "chapter-study"
  expect text "short-line" == "A list holds at least 3 verses."
  expect tree missing "plant-list"
  expect enabled "plant-singles"
  expect no failures

test "One or two join the single verses, and the reader stays on the chapter"
  clock data
  clock settle
  tap "tab-read"
  clock data
  clock settle
  tap "chapter-title"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-16"
  clock data
  tap "plant-singles"
  clock data
  clock settle
  expect state garden.singles.length == 1
  expect state garden.singles.0.reference == "John 3:16"
  expect state garden.lists.length == 0
  expect state nav.tab == "read"
  expect text "chapter-planted" == "Planted."
  expect tree has "chapter-practise"
  expect tree missing "plant-singles"
  expect text "chapter-field" == "1 verse in your field"
  tap "verse-1"
  clock data
  expect text "range-line" == "John 3:1"
  tap "verse-2"
  clock data
  tap "plant-singles"
  clock data
  clock settle
  expect state garden.singles.length == 3
  expect state garden.lists.length == 0
  expect text "chapter-field" == "3 verses in your field"
  expect no failures

test "Three make a list, and Practise it now starts its first verse"
  clock data
  clock settle
  tap "tab-read"
  clock data
  clock settle
  tap "chapter-title"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-16"
  clock data
  tap "verse-18"
  clock data
  expect text "range-line" == "John 3:16-18"
  expect text "range-count" == "3 verses"
  expect tree missing "short-line"
  expect enabled "plant-list"
  tap "plant-list"
  clock data
  clock settle
  expect state garden.lists.length == 1
  expect state garden.lists.0.verses.length == 3
  expect state garden.singles.length == 0
  expect tree has "chapter"
  expect text "chapter-planted" == "Planted."
  expect state chapterShown.practise == "John-3-16"
  tap "chapter-practise"
  clock data
  clock settle
  expect state nav.tab == "garden"
  expect state todayRoute == "start"
  expect state todaySlug == "John-3-16"
  expect no failures

test "Every verse chosen already planted says so, with no button"
  clock data
  clock settle
  tap "tab-read"
  clock data
  clock settle
  tap "chapter-title"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-16"
  clock data
  tap "verse-18"
  clock data
  tap "plant-list"
  clock data
  clock settle
  tap "verse-17"
  clock data
  expect text "range-line" == "John 3:17"
  expect text "chapter-already" == "Already in your field."
  expect tree missing "plant-list"
  expect tree missing "plant-singles"
  expect tree has "chapter-study"
  tap "chapter-clear"
  clock data
  clock settle
  expect tree missing "chapter-bar"
  expect state chooserFirst == 0
  expect no failures

test "A range clips at twenty"
