  expect text "range-line" == "John 3:1-20"
  expect text "range-count" == "20 verses"
  expect state chooserFirst == 1
  expect state chooserLast == 20
  expect no failures

test "A tap on the one verse chosen clears it"
  clock data
  clock settle
  tap "tab-read"
  clock data
  clock settle
  tap "verse-16"
  clock data
  expect text "range-line" == "John 1:16"
  tap "verse-16"
  clock data
  clock settle
  expect tree missing "range-line"
  expect tree missing "short-line"
  expect state chooserFirst == 0
  expect no failures

test "At three lists Plant says the limit"
  clock data
  clock settle
  tap "tab-read"
  clock data
  clock settle
  tap "chapter-title"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-1"
  clock data
  tap "verse-3"
  clock data
  tap "plant-list"
  clock data
  clock settle
  tap "verse-4"
  clock data
  tap "verse-6"
  clock data
  tap "plant-list"
  clock data
  clock settle
  tap "verse-7"
  clock data
  tap "verse-9"
  clock data
  tap "plant-list"
  clock data
  clock settle
  expect state garden.lists.length == 3
  tap "verse-10"
  clock data
  tap "verse-12"
  clock data
  tap "plant-list"
  clock data
  expect text "chooser-limit" == "3 passages or lists, the most for now. Remove one to add another."
  expect state garden.lists.length == 3
  type "root" "/add"
  clock data
  clock settle
  expect state nav.tab == "garden"
  expect text "add-limit" == "3 passages or lists, the most for now. Remove one to add another."
  expect no failures

test "Psalm 119 draws its 176 verses, and its last verse chooses"
  clock data
  clock settle
  tap "tab-read"
  clock data
  clock settle
  tap "chapter-title"
  clock settle
  tap "book-19"
  clock data
  clock settle
  tap "chapter-119"
  clock data
  clock settle
  expect state chapterShown.count == 176
  expect state chooserWords.verses.175.verse == 176
  expect tree has "verse-176"
  expect tree missing "verse-177"
  tap "verse-176"
  clock data
  expect text "range-line" == "Psalms 119:176"
  expect tree has "chapter-bar"
  expect no failures

test "Next and previous walk the chapters, across a book's edge"
  clock data
  clock settle
  tap "tab-read"
  clock data
  clock settle
  expect text "chapter-next" == "John 2 ›"
  expect text "chapter-previous" == "‹ Luke 24"
  tap "chapter-previous"
  clock data
  clock settle
  expect state chapterShown.heading == "Luke 24"
  expect state readBookKept == "42"
  tap "chapter-next"
  clock data
  clock settle
  expect state chapterShown.heading == "John 1"
  tap "verse-3"
  clock data
  tap "chapter-next"
  clock data
  clock settle
  expect state chapterShown.heading == "John 2"
  expect tree missing "chapter-bar"
  tap "chapter-title"
  clock settle
  tap "book-1"
  clock data
  clock settle
  tap "chapter-1"
  clock data
  clock settle
  expect tree missing "chapter-previous"
  expect tree has "chapter-next"
  tap "chapter-title"
  clock settle
  tap "book-66"
  clock data
  clock settle
  tap "chapter-22"
  clock data
  clock settle
  expect tree has "chapter-previous"
  expect tree missing "chapter-next"
  expect no failures
