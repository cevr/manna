epoch "2026-11-14T12:00:00Z"
time-zone "America/New_York"
seed 7

// A plain launch: the pack's base is egw.cvr.im, nothing is fetched until
// the Read tab asks, and the driver's probe is absent. Every fetch, check
// and relaunch runs against the fixture in tools/drive-commentary.ts,
// which a test cannot start or name (README, "The commentary").

test "A plain launch takes the pack from egw.cvr.im and draws no probe"
  at "/verses"
  clock data
  clock settle
  expect state commentaryPlace.base == "https://egw.cvr.im"
  expect state commentaryPlace.fixture == false
  expect tree has "verses"
  expect tree missing "commentary-probe"
  expect tree missing "commentary-fetch"
  expect no failures

test "Before any fetch the commentary is on its way, with no Try again"
  at "/verses"
  clock data
  expect state commentaryShown.phase == "none"
  expect state commentaryShown.version == ""
  expect state commentaryShown.foot == "Getting Ellen White's commentary…"
  expect state commentaryShown.line == "The commentary is still on its way. It needs a connection once, then it works offline."
  expect state commentaryShown.retry == false
  expect state commentaryKept == ""
  expect no failures
