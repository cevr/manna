// Heartseed: the view. app.ts answers what it asks for. The colours are the
// brand's roles (app.forma), the face is rounded, and the safe area is
// left unsaid: the header is the navigation bar, its heading the title.
// A feature adds one `use` line, one `members` line, one route and one
// branch of the stack's view (README, "Where a feature's files go"). The
// Settings sheet's routes (`settings…`) are drawn by their own loop: a
// sheet is a route of its own, not the shared column, and the screen under
// it stays drawn (`settingsUnderId`). Home stays drawn under every pushed
// route, so the gear is drawn in that one entry alone: a driver finds one.
use Today, TodayView from "./features/today.contract"
use SettingsSheet, SettingsView from "./features/settings.contract"
use AboutPage, LicencesPage from "./features/about.contract"
use YourVerses from "./features/garden.contract"
use Home from "./features/home.contract"
use ListPage from "./features/list.contract"
use AddVersesPage, AddListPage from "./features/add.contract"
use ChooserBooksPage, ChooserChaptersPage, ChooserVersesPage from "./features/chooser.contract"
use PacksProbe from "./features/packs.contract"

routes nav
  home "/"
    list "/lists/:id"
    settings "/settings"
      settingsAbout "/settings/about"
        settingsLicences "/settings/about/licences"
  today "/today"
  start "/start/:slug"
  cued "/cue/:cue"
  verses "/verses"
  add "/add"
    addBible "/add/bible"
      addBook "/add/bible/:book"
        addChapter "/add/bible/:book/:chapter"
    addList "/add/lists/:list"

component HeartseedExact
  members "./features/today.contract"
  members "./features/settings.contract"
  members "./features/about.contract"
  members "./features/garden.contract"
  members "./features/text.contract"
  members "./features/home.contract"
  members "./features/list.contract"
  members "./features/add.contract"
  members "./features/chooser.contract"
  members "./features/packs.contract"
  members "./features/commentary.contract"
  members "./features/motion.contract"
  members "./features/feel.contract"
  action follow(url: string)
    nav = go(nav, url)
  view
    main testId="root" navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%"
      for e in stack(nav).filter(x => not x.name.startsWith("settings")) key=e.id
        column navigationKey=`${e.id}` position="absolute" inset=0 display="flex" flex-direction="column" background-color="hs.ground" color="hs.ink" font-family="family.hs" testId=`ground-${e.name}`
          header display="flex" align-items="center"
            text "Heartseed" role="heading" aria-level=1 flex=1 testId="title"
            if e.id == settingsUnderId
              button press=settingsOpen aria-label="Settings" testId="gear"
                image "symbol:settings"
          if (e.name == "today" or e.name == "start" or e.name == "cued") and e.id == settingsUnderId
            Today(today=today, hear=todayHearIt, stop=todayStopIt, say=todaySayIt, finish=todayFinishIt, peek=todayPeekIt, showAll=todayShowAllIt, grade=todayGradeIt, next=todayNextIt, again=todayAgainIt, add=todayAddIt, home=todayHomeIt, still=motionStill, sheet=motionSheetUp)
          if e.name == "home"
            Home(home=homeShown, asking=homeAsking, begin=homeBegin, start=homeStart, open=homeOpen, add=homeAdd, ask=homeAsk, yes=homeYes, no=homeNo, still=motionStill)
          if e.name == "list"
            ListPage(list=listShown, asking=listAsking, practice=listPractice, ask=listAsk, yes=listYes, no=listNo, still=motionStill)
          if e.name == "verses"
            YourVerses(garden=garden, line=gardenLine, answer=gardenAnswer, driven=gardenDriven.on, plant=gardenPlantRange, remove=gardenRemoveIt, good=gardenRecallGood, peeked=gardenRecallPeeked, shown=gardenRecallShown, back=gardenMoveBack, add=addOpenIt)
            // hs-commentary: a fixture launch's probe, until the Read tab calls packsFetch; removed at the join.
            if packsPlace.fixture
              PacksProbe(shown=packsShown, fetch=packsFetch, retry=packsRetry, still=motionStill)
            // hs-commentary: end of the probe.
          if e.name == "add"
            AddVersesPage(add=addShown, bible=addOpenBible, toggle=addToggle, open=addOpenList)
          if e.name == "addList"
            AddListPage(list=addListShown, pending=pending(addPlanted), plant=addPlantIt)
          if e.name == "addBible"
            ChooserBooksPage(books=chooserBooksShown, open=chooserOpenBook)
          if e.name == "addBook"
            ChooserChaptersPage(book=chooserChaptersShown, open=chooserOpenChapter)
          if e.name == "addChapter"
            ChooserVersesPage(shown=chooserShown, words=chooserWords, pending=pending(chooserPlanted), tap=chooserTapIt, plant=chooserPlantIt, join=chooserJoinIt)
      for e in stack(nav).filter(x => x.name.startsWith("settings")) key=e.id
        if e.name == "settings"
          SettingsSheet(route=e.id, settings=settings, minutes=feelChooseMinutes, voice=feelChooseVoice, appearance=feelChooseAppearance, about=aboutOpen, done=settingsDone)
        if e.name == "settingsAbout"
          AboutPage(route=e.id, licences=aboutOpenLicences)
        if e.name == "settingsLicences"
          LicencesPage(route=e.id, licences=aboutLicences.licences)
