// Heartseed: the view. app.ts answers what it asks for. The colours are the
// brand's roles (app.forma), the face is rounded, and the safe area is
// left unsaid: the header is the navigation bar, its heading the title.
// Two tabs at the foot, the platform's own bar: Garden (where the app
// opens: every screen of the memoriser, each at its own address) and Read
// (a chapter at the kept place, features/read.contract). Each tab is a
// stack of its own, kept with its scroll while the other shows; tapping
// the tab shown pops it to its root (`pick`). A location that names the
// other tab's route selects that tab first (`follow`); the Settings sheet
// opens over whichever tab is up.
// A feature adds one `use` line, one `members` line, one route and one
// branch of the stack's view (README, "Where a feature's files go"). The
// Settings sheet's routes (`settings…`) and the Aa sheet (`typeSheet`) are
// drawn by loops of their own in each tab: a sheet is a route of its own,
// not the shared column, it opens over whichever tab is up, and the screen
// under it stays drawn (`readSheetOf`). Home stays drawn under every pushed route,
// so Back finds it with no row built again. Today and the Read chapter
// (with its header's magnifier and Aa) are drawn only in the top entry of
// their tab (`readTopOf`), so a pushed
// route leaves one copy of their ids, and the gear only in the top entry
// of the tab shown (`settingsUnderId`), so a driver finds one.
use Today, TodayView from "./features/today.contract"
use SettingsSheet, SettingsView from "./features/settings.contract"
use AboutPage, LicencesPage from "./features/about.contract"
use YourVerses from "./features/garden.contract"
use Home from "./features/home.contract"
use ListPage from "./features/list.contract"
use AddVersesPage, AddListPage from "./features/add.contract"
use ChapterPage from "./features/chooser.contract"
use GotoSheet, GotoBookPage from "./features/goto.contract"
use readTopOf, readSheetOf, ReadDriven from "./features/read.contract"
use TypeSheet from "./features/type.contract"
use PacksProbe from "./features/packs.contract"
use StudySheet from "./features/study.contract"
use FirstScreen from "./features/first.contract"

routes nav
  tab garden "/"
    list "/lists/:id"
    settings "/settings"
      settingsAbout "/settings/about"
        settingsLicences "/settings/about/licences"
    today "/today"
    start "/start/:slug"
    cued "/cue/:cue"
    verses "/verses"
    add "/add"
      addList "/add/lists/:list"
    typeSheet "/type"
    first "/first/:phase/:cue"
  tab read "/read"
    readAt "/read/at/:book/:chapter/:verse"
    gotoSheet "/read/goto"
      gotoBook "/read/goto/:book"
    studySheet "/read/study/:book/:chapter/:verse/:tab"

component HeartseedExact
  members "./features/today.contract"
  members "./features/settings.contract"
  members "./features/about.contract"
  members "./features/garden.contract"
  members "./features/text.contract"
  members "./features/home.contract"
  members "./features/list.contract"
  members "./features/add.contract"
  members "./features/chooser.contract"
  members "./features/goto.contract"
  members "./features/packs.contract"
  members "./features/commentary.contract"
  members "./features/studydata.contract"
  members "./features/motion.contract"
  members "./features/feel.contract"
  members "./features/read.contract"
  members "./features/find.contract"
  members "./features/type.contract"
  members "./features/study.contract"
  members "./features/start.contract"
  members "./features/first.contract"
  members "./features/back.contract"
  provide
    todayHoldDown = todayDownIt
    todayHoldMove = todayMoveIt
    todayHoldUp = todayUpIt
    todayBack
    todayBackRunning
    todayBackOpenIt
    todayBackYes
    todayBackKeepIt
  action pick(name: string)
    nav = select(nav, name)
  action follow(url: string)
    if firstHeld
      firstPlace()
    else if url.startsWith("/read") and nav.tab != "read"
      nav = go(select(nav, "read"), url)
    else if not url.startsWith("/read") and not url.startsWith("/settings") and not url.startsWith("/type") and nav.tab != "garden"
      nav = go(select(nav, "garden"), url)
    else
      nav = go(nav, url)
  view
    main testId="root" navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%" display="flex" flex-direction="column" background-color="hs.ground" color="hs.ink" font-family="family.hs"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` testId=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack.filter(x => not readSheetOf(x.name)) key=e.id
              column navigationKey=`${e.id}` position="absolute" inset=0 display="flex" flex-direction="column" background-color="hs.ground" color="hs.ink" font-family="family.hs" testId=`ground-${e.name == "garden" ? "home" : e.name}`
                header display="flex" align-items="center"
                  if e.name == "read" or e.name == "readAt"
                    if e.id == readTopOf(t.stack)
                      button press=gotoOpenFind aria-label="Find a verse, a chapter or words" testId="chapter-find"
                        image "symbol:search"
                    text (e.name == "read" ? readKept.name : readAts.filter(p => p.id == e.id).map(p => p.name).join("")) role="heading" aria-level=2 font="type.strong" flex=1 opacity=(chooserTitleGone ? 1 : 0) testId=`read-title-${e.name}`
                    if e.id == readTopOf(t.stack)
                      button press=typeOpen aria-label="Text settings" testId="chapter-aa"
                        text "Aa"
                  else
                    text "Heartseed" role="heading" aria-level=1 font="type.title" flex=1 testId="title"
                  if e.id == settingsUnderId
                    button press=settingsOpen aria-label="Settings" testId="gear"
                      image "symbol:settings"
                if (e.name == "today" or e.name == "start" or e.name == "cued") and e.id == readTopOf(t.stack)
                  Today(today=today, hear=todayHearIt, stop=todayStopIt, say=todaySayIt, finish=todayFinishIt, peek=todayPeekIt, showAll=todayShowAllIt, grade=todayGradeIt, next=todayNextIt, again=todayAgainIt, add=todayAddIt, home=todayHomeIt, still=motionStill, sheet=motionSheetUp, chapter=gotoTodayPlace.name, read=gotoReadToday, scheme=homeScheme)
                if e.name == "list"
                  ListPage(list=listShown, asking=listAsking, scheme=homeScheme, practice=listPractice, ask=listAsk, yes=listYes, no=listNo, still=motionStill, chapter=gotoListPlace.name, read=gotoReadList)
                if e.name == "verses"
                  YourVerses(garden=garden, line=gardenLine, answer=gardenAnswer, driven=gardenDriven.on, plant=gardenPlantRange, remove=gardenRemoveIt, good=gardenRecallGood, peeked=gardenRecallPeeked, shown=gardenRecallShown, back=gardenMoveBack, add=addOpenIt)
                  // hs-commentary: a fixture launch's probe, which tools/drive-commentary.ts taps (the Read tab asks on its own first showing).
                  if packsPlace.fixture
                    PacksProbe(shown=packsShown, fetch=packsFetch, retry=packsRetry, still=motionStill)
                  // hs-commentary: end of the probe.
                if (e.name == "read" or e.name == "readAt") and e.id == readTopOf(t.stack)
                  ChapterPage(shown=chapterShown, words=chooserWords, type=typeShown, opened=readVerse, room=chooserLandRoom, sized=chooserScrollSized, pending=pending(chooserPlanted), tap=feelChooseVerse, clear=chooserClear, plant=chooserPlantIt, join=chooserJoinIt, practise=chooserPractise, goto=gotoOpen, read=readOpenAt, seen=chooserTitleSeen, packs=packsShown, still=motionStill, select=studySelected, holds=studyHolds, held=(studyHeld != ""), study=studyBarShown, open=studyOpen)
                    if gardenDriven.on
                      ReadDriven(open=readOpenAt, follow=readFollow)
                if e.name == "garden"
                  Home(home=homeShown, asking=homeAsking, scheme=homeScheme, begin=homeBegin, start=homeStart, open=homeOpen, add=homeAdd, ask=homeAsk, yes=homeYes, no=homeNo, still=motionStill, tips=(first.tour == "tips"), how=firstHow, gotIt=firstGotIt)
            for e in t.stack.filter(x => x.name.startsWith("settings")) key=e.id
              if e.name == "settings"
                SettingsSheet(route=e.id, settings=settings, minutes=feelChooseMinutes, voice=feelChooseVoice, appearance=feelChooseAppearance, feel=settingsFeel, feelSwitch=settingsFeelSet, about=aboutOpen, welcome=firstWelcomeAgain, done=settingsDone)
              if e.name == "settingsAbout"
                AboutPage(route=e.id, version=aboutShown.version, licences=aboutOpenLicences)
              if e.name == "settingsLicences"
                LicencesPage(route=e.id, licences=aboutShown.licences)
            for e in t.stack.filter(x => x.name == "add" or x.name == "addList") key=e.id
              if e.name == "add"
                AddVersesPage(route=e.id, add=addShown, scheme=homeScheme, bible=addOpenBible, toggle=addToggle, open=addOpenList, done=addDone)
              if e.name == "addList"
                AddListPage(route=e.id, list=addListShown, pending=pending(addPlanted), plant=addPlantIt)
            for e in t.stack.filter(x => x.name == "gotoSheet" or x.name == "gotoBook") key=e.id
              if e.name == "gotoSheet"
                GotoSheet(route=e.id, query=findQuery, found=findShown, type=findType, clear=findClear, open=gotoOpenAt, grow=gotoGrowShown, books=gotoBooksShown, book=gotoOpenBook, done=gotoDone)
              if e.name == "gotoBook"
                GotoBookPage(route=e.id, book=gotoBookShown, open=gotoOpenAt, done=gotoDone)
            for e in t.stack.filter(x => x.name == "studySheet") key=e.id
              StudySheet(route=e.id, tab=e.params.tab, sheet=studySheetShown, word=studyWordShown, unfolded=studyUnfolded, type=typeShown, retry=commentaryShown.retry, still=motionStill, choose=studyTab, tapWord=studyWordTap, fold=studyFold, follow=studyFollow, move=studyMove, again=packsRetry, done=studyDone)
            for e in t.stack.filter(x => x.name == "first") key=e.id
              FirstScreen(route=e.id, phase=e.params.phase, replay=firstReplaying, today=today, scheme=homeScheme, still=motionStill, begin=firstBegin, skip=firstSkip, on=firstOn, next=firstNext, hear=todayHearIt, say=todaySayIt, finish=todayFinishIt, peek=todayPeekIt, read=gotoReadToday, done=firstContinue)
            for e in t.stack.filter(x => x.name == "typeSheet") key=e.id
              TypeSheet(route=e.id, type=typeShown, font=typeChooseFont, size=typeChooseSize, line=typeChooseLine, letter=typeChooseLetter, width=typeChooseWidth, reset=typeReset, done=typeDone)
      row role="tablist" testId="tabs" display=(readSheetUp ? "none" : "flex") flex-shrink=0 background-color="hs.ground" color="hs.quiet" accent-color="AccentColor"
        button role="tab" aria-controls="panel-garden" aria-selected=(nav.tab == "garden") press=pick("garden") testId="tab-garden" flex=1 min-height="size.target" display="flex" flex-direction="column" align-items="center" justify-content="center"
          image "symbol:icon.sprout"
          text "Garden"
        button role="tab" aria-controls="panel-read" aria-selected=(nav.tab == "read") press=pick("read") testId="tab-read" flex=1 min-height="size.target" display="flex" flex-direction="column" align-items="center" justify-content="center"
          image "symbol:book"
          text "Read"
