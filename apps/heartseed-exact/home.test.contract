  clock data
  tap "plant-one"
  clock data
  back
  clock data
  clock settle
  expect state homeShown.rows.length == 3
  expect state homeShown.singles.length == 20
  tap "home-scroll" drag 0 -1500
  tap "home-scroll" drag 0 -1500
  clock settle
  tap "row-title-passage-2-43-3-22-24"
  clock data
  clock settle
  expect text "list-title" == "John 3:22-24"
  perf
    back
    clock data
    clock settle
  expect perf built "Home" == 0
  expect perf built "HomePlantButton" == 0
  expect tree has "limit-line"
  expect no failures

test "The limits speak"
  clock data
  tap "add-list"
  clock data
  tap "plant-three"
  clock data
  tap "plant-three"
  clock data
  tap "plant-three"
  clock data
  back
  clock data
  clock settle
  expect text "limit-line" == "3 passages or lists, the most for now. Remove one to add another."
  expect tree missing "add-list"
  expect no failures

