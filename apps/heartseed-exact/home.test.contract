  tap "offer-pick-proverbs-20-4-23-23"
  clock data
  clock settle
  tap "shelf-plant"
  clock data
  clock settle
  back
  clock data
  clock settle
  expect text "today-line" == "1 verse · about 1 min"
  expect text "today-parts" == "1 new"
