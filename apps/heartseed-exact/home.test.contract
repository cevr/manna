fail fetch "https://egw.cvr.im"
epoch "2026-11-14T12:00:00Z"
time-zone "America/New_York"
seed 7

test "An empty home greets and offers Add a list"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  clock data
  clock settle
  expect text "greeting" == "Good morning"
  expect tree has "today-card"
  expect tree has "add-list"
  expect tree missing "singles"
  expect tree missing "limit-line"
  expect tree missing "row-passage-0-43-3-16-18"
  expect tree has "gear"
  expect no failures

test "A list is a row of plants, with no icon and no glyph"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  clock data
  tap "add-list"
  clock data
  clock settle
  tap "shelf-any"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-16"
  clock data
  tap "verse-18"
  clock data
  perf
    tap "plant-list"
    clock data
    clock settle
  expect perf built "HomePlantButton" == 3
  tap "tab-garden"
  clock data
  clock settle
  back
  clock data
  clock settle
  expect text "row-name-passage-0-43-3-16-18" == "John 3:16-18"
  expect text "row-caption-passage-0-43-3-16-18" == "3 verses · 1 ready today"
  expect tree has "plant-John-3-16"
  expect tree has "plant-John-3-17"
  expect tree has "plant-John-3-18"
  expect state homeShown.rows.0.plants.0.label == "John 3:16, not planted, ready today"
  expect state homeShown.rows.0.plants.length == 3
  expect tree missing "singles"
  expect no failures

test "Single verses sit under the lists"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  clock data
  tap "add-list"
  clock data
  clock settle
  tap "shelf-any"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-16"
  clock data
  tap "verse-18"
  clock data
  tap "plant-list"
  clock data
  clock settle
  tap "tab-garden"
  clock data
  clock settle
  tap "shelf-proverbs"
  clock data
  clock settle
  tap "offer-pick-proverbs-20-4-23-23"
  clock data
  clock settle
  tap "shelf-plant"
  clock data
  clock settle
  tap "offer-pick-proverbs-20-15-1-1"
  clock data
  clock settle
  tap "shelf-plant"
  clock data
  clock settle
  back
  clock data
  clock settle
  expect tree has "singles"
  expect text "single-Proverbs-4-23" == "Proverbs 4:23"
  expect text "single-Proverbs-15-1" == "Proverbs 15:1"
  expect state homeShown.singles.0.reference == "Proverbs 4:23"
  expect state homeShown.singles.1.reference == "Proverbs 15:1"
  expect state homeShown.singlesShown == true
  expect state homeShown.rows.length == 1
  expect no failures

