test "Removing a single verse asks first"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  clock data
  tap "add-list"
  clock data
  clock settle
  tap "shelf-proverbs"
  clock data
  clock settle
  tap "offer-pick-proverbs-20-4-23-23"
  clock data
  clock settle
  tap "shelf-plant"
  clock data
  clock settle
  back
  clock data
  clock settle
  tap "single-remove-Proverbs-4-23"
  expect tree has "ask-Proverbs-4-23"
  expect tree missing "single-remove-Proverbs-4-23"
  expect state homeShown.singles.0.ask == "Remove Proverbs 4:23? Its plant stays in your field."
  tap "ask-no"
  clock data
  expect tree missing "ask-Proverbs-4-23"
  expect tree has "single-Proverbs-4-23"
  tap "single-remove-Proverbs-4-23"
  tap "ask-yes"
  clock data
  clock settle
  expect tree missing "single-Proverbs-4-23"
  expect tree missing "singles"
  expect no failures

