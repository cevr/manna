fail fetch "https://egw.cvr.im"
epoch "2026-11-14T12:00:00Z"
time-zone "America/New_York"
seed 7

test "The shelves, in order"
  at "/add"
  clock data
  clock settle
  expect tree has "add-verses"
  expect text "shelf-any" == "Any passageEvery book, chapter and verse"
  expect state addShown.shelves.0.id == "any"
  expect state addShown.shelves.1.id == "psalms"
  expect state addShown.shelves.2.id == "proverbs"
  expect state addShown.shelves.3.id == "john"
  expect state addShown.shelves.4.id == "forgiveness"
  expect state addShown.shelves.17.id == "handbook:bhb-27"
  expect tree has "shelf-psalms"
  expect tree has "shelf-handbook-bhb-27"
  expect tree missing "offer-pick-psalms-19-1-1-3"
  tap "shelf-psalms"
  clock data
  clock settle
  expect state addShown.shelves.1.open == true
  expect text "offer-state-pick-psalms-19-1-1-3" == "Plant"
  tap "shelf-proverbs"
  clock data
  clock settle
  expect state addShown.shelves.1.open == false
  expect tree missing "offer-pick-psalms-19-1-1-3"
  expect tree has "offer-pick-proverbs-20-4-23-23"
  tap "shelf-proverbs"
  clock data
  clock settle
  expect tree missing "offer-pick-proverbs-20-4-23-23"
  expect tree missing "add-limit"
  expect no failures

test "Add a list is a sheet over home, and Done closes it"
  clock data
  clock settle
  tap "add-list"
  clock data
  clock settle
  expect tree has "add-sheet"
  expect text "add-title" == "Add a list"
  expect text "add-done" == "Done"
  expect tree has "shelf-any"
  tap "add-done"
  clock settle
  expect tree missing "add-sheet"
  expect state readGardenTab.length == 1
  expect tree has "add-list"
  expect no failures

test "A pick shows its verses before it is planted, then plants"
  at "/add"
  clock data
  clock settle
  tap "shelf-psalms"
  clock data
  clock settle
  tap "offer-pick-psalms-19-1-1-3"
  clock data
  clock settle
  expect text "shelf-title" == "Psalms 1:1-3"
  expect text "shelf-count" == "3 verses"
  expect tree has "shelf-verse-Psalms-1-1"
  expect tree has "shelf-verse-Psalms-1-3"
  expect state addListShown.verses.2.reference == "Psalms 1:3"
  expect enabled "shelf-plant"
  tap "shelf-plant"
  clock data
  clock settle
  expect tree missing "shelf-list"
  expect tree has "add-verses"
  expect state garden.lists.length == 1
  expect text "offer-state-pick-psalms-19-1-1-3" == "In your field"
  expect no failures

test "A short pick joins the single verses"
  at "/add"
  clock data
  clock settle
  tap "shelf-proverbs"
  clock data
  clock settle
  tap "offer-pick-proverbs-20-4-23-23"
  clock data
  clock settle
  expect text "shelf-count" == "1 verse"
  tap "shelf-plant"
  clock data
  clock settle
  expect state garden.singles.length == 1
  expect state garden.singles.0.reference == "Proverbs 4:23"
  expect state garden.lists.length == 0
  expect no failures

test "A Handbook list plants as a list"
  at "/add"
  clock data
  clock settle
  tap "shelf-handbook-bhb-27"
  clock data
  clock settle
  expect tree has "offer-bhb-30"
  tap "offer-bhb-30"
  clock data
  clock settle
  expect text "shelf-title" == "Magnifying the Word of God"
  tap "shelf-plant"
  clock data
  clock settle
  expect state garden.lists.length == 1
  expect state garden.lists.0.title == "Magnifying the Word of God"
  expect no failures

test "At three lists the rows say the limit"
  at "/add"
  clock data
  clock settle
  tap "shelf-psalms"
  clock data
  clock settle
  tap "offer-pick-psalms-19-1-1-3"
  clock data
  clock settle
  tap "shelf-plant"
  clock data
  clock settle
  tap "offer-pick-psalms-19-46-1-3"
  clock data
  clock settle
  tap "shelf-plant"
  clock data
  clock settle
  tap "offer-pick-psalms-19-91-1-4"
  clock data
  clock settle
  tap "shelf-plant"
  clock data
  clock settle
  expect state garden.lists.length == 3
  expect text "add-limit" == "3 passages or lists, the most for now. Remove one to add another."
  expect tree missing "offer-state-pick-psalms-19-103-1-5"
  tap "offer-pick-psalms-19-103-1-5"
  clock data
  clock settle
  expect tree missing "shelf-plant"
  expect text "shelf-limit" == "3 passages or lists, the most for now. Remove one to add another."
  back
  clock settle
  tap "shelf-proverbs"
  clock data
  clock settle
  expect text "offer-state-pick-proverbs-20-15-1-1" == "Plant"
  expect no failures

test "At twenty single verses a short pick says its limit"
  clock data
  clock settle
  tap "tab-read"
  clock data
  clock settle
  tap "chapter-title"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-1"
  clock data
  tap "verse-2"
  clock data
  tap "plant-singles"
  clock data
  clock settle
  tap "verse-3"
  clock data
  tap "verse-4"
  clock data
  tap "plant-singles"
  clock data
  clock settle
  tap "verse-5"
  clock data
  tap "verse-6"
  clock data
  tap "plant-singles"
  clock data
  clock settle
  tap "verse-7"
  clock data
  tap "verse-8"
  clock data
  tap "plant-singles"
  clock data
  clock settle
  tap "verse-9"
  clock data
  tap "verse-10"
  clock data
  tap "plant-singles"
  clock data
  clock settle
  tap "verse-11"
  clock data
  tap "verse-12"
  clock data
  tap "plant-singles"
  clock data
  clock settle
  tap "verse-13"
  clock data
  tap "verse-14"
  clock data
  tap "plant-singles"
  clock data
  clock settle
  tap "verse-15"
  clock data
  tap "verse-16"
  clock data
  tap "plant-singles"
  clock data
  clock settle
  tap "verse-17"
  clock data
  tap "verse-18"
  clock data
  tap "plant-singles"
  clock data
  clock settle
  expect state garden.singles.length == 18
  tap "verse-19"
  clock data
  tap "plant-singles"
  clock data
  clock settle
  expect state garden.singles.length == 19
  tap "verse-19"
  clock data
  tap "verse-20"
  clock data
  expect tree missing "chooser-singles-limit"
  expect enabled "plant-singles"
  tap "plant-singles"
  clock data
  clock settle
  expect state garden.singles.length == 20
  expect state garden.singles.19.reference == "John 3:20"
  tap "tab-garden"
  clock data
  clock settle
  tap "add-list"
  clock data
  clock settle
  expect text "add-singles-limit" == "20 single verses, the most for now. Remove one to add another."
  tap "shelf-proverbs"
  clock data
  clock settle
  tap "offer-pick-proverbs-20-4-23-23"
  clock data
  clock settle
  expect text "shelf-count" == "1 verse"
  expect tree missing "shelf-plant"
  expect text "shelf-singles-limit" == "20 single verses, the most for now. Remove one to add another."
  back
  clock settle
  tap "add-done"
  clock settle
  expect tree missing "add-sheet"
  tap "tab-read"
  clock data
  clock settle
  tap "verse-21"
  clock data
  expect tree missing "plant-singles"
  expect tree missing "plant-list"
  expect text "chooser-singles-limit" == "20 single verses, the most for now. Remove one to add another."
  tap "verse-21"
  clock data
  tap "verse-1"
  clock data
  tap "verse-2"
  clock data
  expect tree missing "plant-singles"
  expect tree missing "chooser-singles-limit"
  expect no failures
