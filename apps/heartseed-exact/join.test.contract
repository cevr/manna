fail fetch "https://egw.cvr.im"
epoch "2026-11-14T12:00:00Z"
time-zone "America/New_York"
seed 7

test "Three verses planted and due: home's card offers Start"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  clock data
  tap "add-list"
  clock data
  clock settle
  tap "shelf-any"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-16"
  clock data
  tap "verse-18"
  clock data
  tap "plant-list"
  clock data
  clock settle
  tap "tab-garden"
  clock data
  clock settle
  back
  clock data
  clock settle
  expect tree has "row-passage-0-43-3-16-18"
  expect text "today-action" == "Start"
  expect state homeShown.card.action == "start"
  expect no failures

test "Start opens Today on the plan's first item"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  clock data
  tap "add-list"
  clock data
  clock settle
  tap "shelf-any"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-16"
  clock data
  tap "verse-18"
  clock data
  tap "plant-list"
  clock data
  clock settle
  tap "tab-garden"
  clock data
  clock settle
  back
  clock data
  clock settle
  tap "today-action"
  clock data
  clock settle
  expect state today.session.wire.planned == true
  expect text "item-reference" == "John 3:16"
  expect state today.session.wire.items.0.reference == "John 3:16"
  expect no failures

test "A tap on a plant opens Today on that verse"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  clock data
  tap "add-list"
  clock data
  clock settle
  tap "shelf-any"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-16"
  clock data
  tap "verse-18"
  clock data
  tap "plant-list"
  clock data
  clock settle
  tap "tab-garden"
  clock data
  clock settle
  back
  clock data
  clock settle
  tap "plant-John-3-18"
  clock data
  clock settle
  expect text "item-reference" == "John 3:18"
  expect no failures

test "Back from Today returns home at the scroll it left"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  clock data
  tap "add-list"
  clock data
  clock settle
  tap "shelf-any"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-16"
  clock data
  tap "verse-18"
  clock data
  tap "plant-list"
  clock data
  clock settle
  tap "tab-garden"
  clock data
  clock settle
  tap "shelf-any"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-19"
  clock data
  tap "verse-21"
  clock data
  tap "plant-list"
  clock data
  clock settle
  tap "tab-garden"
  clock data
  clock settle
  tap "shelf-any"
  clock settle
  tap "book-43"
  clock data
  clock settle
  tap "chapter-3"
  clock data
  clock settle
  tap "verse-22"
  clock data
  tap "verse-24"
  clock data
  tap "plant-list"
  clock data
  clock settle
  tap "tab-garden"
  clock data
  clock settle
  back
  clock data
  clock settle
  tap "home-scroll" drag 0 -1500
  clock settle
  tap "plant-John-3-24"
  clock data
  clock settle
  expect text "item-reference" == "John 3:24"
  perf
    back
    clock data
    clock settle
  expect perf built "Home" == 0
  expect perf built "HomePlantButton" == 0
  expect tree has "plant-John-3-24"
  expect no failures

test "Add a list opens Add verses (J2)"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  clock data
  clock settle
  tap "add-list"
  clock data
  clock settle
  expect tree has "add-verses"
  expect tree missing "verses"
  expect tree has "shelf-any"
  back
  clock data
  clock settle
  expect tree missing "add-verses"
  expect tree has "add-list"
  expect no failures

test "A list planted in Add verses shows as a row on home after Back (J2)"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  clock data
  tap "add-list"
  clock data
  clock settle
  tap "shelf-psalms"
  clock data
  clock settle
  tap "offer-pick-psalms-19-1-1-3"
  clock data
  clock settle
  tap "shelf-plant"
  clock data
  clock settle
  expect tree has "add-verses"
  back
  clock data
  clock settle
  expect text "row-name-passage-0-19-1-1-3" == "Psalms 1:1-3"
  expect state homeShown.rows.length == 1
  expect tree missing "singles"
  expect no failures

test "A single verse planted in Add verses shows under Single verses (J2)"
  at "/verses"
  clock data
  clock settle
  back
  clock settle
  clock data
  tap "add-list"
  clock data
  clock settle
  tap "shelf-proverbs"
  clock data
  clock settle
  tap "offer-pick-proverbs-20-4-23-23"
  clock data
  clock settle
  tap "shelf-plant"
  clock data
  clock settle
  back
  clock data
  clock settle
  expect tree has "singles"
  expect text "single-Proverbs-4-23" == "Proverbs 4:23"
  expect state homeShown.rows.length == 0
  expect no failures
