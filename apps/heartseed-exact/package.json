{
  "name": "@manna/heartseed-exact",
  "private": true,
  "type": "module",
  "scripts": {
    "exact": "bun tools/prepare.ts && manna-exact",
    "typecheck": "tsc -p tsconfig.src.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "test": "bun test --preload ./tools/setup.ts --path-ignore-patterns='src/garden/history-*.test.ts' --path-ignore-patterns=src/garden/bytes.test.ts ./src",
    "test:garden-bytes": "bun test --preload ./tools/setup.ts ./src/garden/bytes.test.ts",
    "test:garden-a": "bun test --preload ./tools/setup.ts ./src/garden/history-a.test.ts",
    "test:garden-b": "bun test --preload ./tools/setup.ts ./src/garden/history-b.test.ts",
    "test:garden-c": "bun test --preload ./tools/setup.ts ./src/garden/history-c.test.ts"
  },
  "dependencies": {
    "@manna/exact-kit": "workspace:*",
    "@manna/heartseed": "workspace:*"
  }
}
