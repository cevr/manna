{
  "name": "@manna/heartseed-exact",
  "private": true,
  "type": "module",
  "scripts": {
    "exact": "bun tools/prepare.ts && manna-exact",
    "typecheck": "tsc -p tsconfig.src.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "test": "bun test --preload ./tools/setup.ts --path-ignore-patterns=src/app.test.ts --path-ignore-patterns=src/garden/history-a.test.ts --path-ignore-patterns=src/garden/history-b.test.ts --path-ignore-patterns=src/garden/history-c.test.ts --path-ignore-patterns=src/garden/bytes.test.ts --path-ignore-patterns=src/session/history-a.test.ts --path-ignore-patterns=src/session/history-b.test.ts --path-ignore-patterns=src/session/history-c.test.ts --path-ignore-patterns=src/session/overlap.test.ts --path-ignore-patterns=src/session/contract.test.ts --path-ignore-patterns=src/text/text.test.ts --path-ignore-patterns=src/text/contract.test.ts --path-ignore-patterns=src/text/no-copy.test.ts --path-ignore-patterns=src/home/equal-a.test.ts --path-ignore-patterns=src/home/equal-b.test.ts --path-ignore-patterns=src/home/equal-c.test.ts --path-ignore-patterns=src/home/asks.test.ts --path-ignore-patterns=src/home/words.test.ts --path-ignore-patterns=src/add/** --path-ignore-patterns=src/chooser/** --path-ignore-patterns=src/commentary/** --path-ignore-patterns=src/packs/** --path-ignore-patterns=src/type/** ./src",
    "test:packs": "bun test --preload ./tools/setup.ts ./src/packs ./src/commentary",
    "test:add-a": "bun test --preload ./tools/setup.ts ./src/add/plant-a.test.ts",
    "test:add-b": "bun test --preload ./tools/setup.ts ./src/add/plant-b.test.ts",
    "test:add-shelves": "bun test --preload ./tools/setup.ts ./src/add/shelves.test.ts",
    "test:chooser": "bun test --preload ./tools/setup.ts ./src/chooser ./src/add/words.test.ts ./src/add/today.test.ts",
    "test:home-a": "bun test --preload ./tools/setup.ts ./src/home/equal-a.test.ts",
    "test:home-b": "bun test --preload ./tools/setup.ts ./src/home/equal-b.test.ts",
    "test:home-c": "bun test --preload ./tools/setup.ts ./src/home/equal-c.test.ts",
    "test:home-asks": "bun test --preload ./tools/setup.ts ./src/home/asks.test.ts ./src/home/words.test.ts",
    "test:app": "bun test --preload ./tools/setup.ts ./src/app.test.ts",
    "test:text": "bun test --preload ./tools/setup.ts ./src/text",
    "test:type": "bun test --preload ./tools/setup.ts ./src/type",
    "test:garden-bytes": "bun test --preload ./tools/setup.ts ./src/garden/bytes.test.ts",
    "test:garden-a": "bun test --preload ./tools/setup.ts ./src/garden/history-a.test.ts",
    "test:garden-b": "bun test --preload ./tools/setup.ts ./src/garden/history-b.test.ts",
    "test:garden-c": "bun test --preload ./tools/setup.ts ./src/garden/history-c.test.ts",
    "test:session-a": "bun test --preload ./tools/setup.ts ./src/session/history-a.test.ts",
    "test:session-b": "bun test --preload ./tools/setup.ts ./src/session/history-b.test.ts",
    "test:session-c": "bun test --preload ./tools/setup.ts ./src/session/history-c.test.ts",
    "test:session-calls": "bun test --preload ./tools/setup.ts ./src/session/overlap.test.ts ./src/session/contract.test.ts",
    "test:slow": "quint typecheck src/garden/writes.qnt && quint typecheck src/packs/packs.qnt"
  },
  "dependencies": {
    "@manna/exact-kit": "workspace:*",
    "@manna/heartseed": "workspace:*"
  }
}
