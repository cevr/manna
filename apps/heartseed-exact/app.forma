// Heartseed's brand: brand C, "Two leaves", every role of the current app's
// palette (apps/heartseed/src/theme.ts) in light and dark, as `hs.<role>`.
// src/look/brand.test.ts holds this file to that palette, so a role added
// there fails until it is carried here. The platform's roles a screen names
// (`-exact-label` and the rest) are drawn in the brand's. The tint is the
// ink by day and the soil by night: UIKit keeps a filled button's label
// white, and the soil is the one dark role at 3:1 under white and on the
// night ground both.
forma heartseed

theme
  hs.ground = light-dark(#f1f0e6, #142420)
  hs.card = light-dark(#f9f8f1, #1d322c)
  hs.ink = light-dark(#2c4542, #e6eedb)  pair=hs.ground
  hs.quiet = light-dark(#5a6761, #a0b4a7)  pair=hs.ground
  hs.soft = light-dark(#b9cfae, #3d5c4f)
  hs.miss = light-dark(#a04a34, #f09982)  pair=hs.ground
  hs.hearing = light-dark(#ebe0c1, #444528)
  hs.glow = light-dark(#d4a640, #d4a640)
  hs.pulse = light-dark(rgba(212, 166, 64, 0.45), rgba(212, 166, 64, 0.45))
  hs.on-ink = light-dark(#f1f0e6, #142420)  pair=hs.ink
  hs.shadow = light-dark(#2c4542, #000000)
  hs.gold = light-dark(#d4a640, #d4a640)
  hs.leaf = light-dark(#6f9a4a, #86b862)
  hs.green-ear = light-dark(#9cbf6a, #a9cd78)
  hs.soil = light-dark(#8a6e4b, #a88a62)
  hs.furrow = light-dark(#c3b6a0, #57523e)
  hs.sun = light-dark(#80641f, #d4a640)  pair=hs.ground
  family.hs = ui-rounded, system-ui
  duration.fade = 150ms
  duration.exit = 150ms
  duration.light = 180ms
  duration.rise = 250ms
  duration.ask = 200ms
  duration.pulse = 1200ms
  easing.out = cubic-bezier(0.23, 1, 0.32, 1)
  easing.pulse = cubic-bezier(0.5, 1, 0.89, 1)
  type.title = 700 2rem/normal family.hs
  type.sheet-title = 700 1.6471rem/normal family.hs
  type.word = 400 1.4118rem/1.5 family.hs
  type.chevron = 600 1.2941rem/normal family.hs
  type.name = 700 1.1765rem/normal family.hs
  type.strong = 600 1rem/normal family.hs
  type.body = 400 1rem/normal family.hs
  type.label = 600 0.8824rem/normal family.hs
  type.small = 400 0.8824rem/normal family.hs
  type.note = 400 0.8824rem/1.4 family.hs
  type.note-strong = 600 0.8824rem/1.4 family.hs
  type.credits = 400 0.8824rem/1.4667 family.hs
  type.plant = 700 0.8824rem/normal family.hs
  type.caption = 400 0.7647rem/normal family.hs
  type.caption-strong = 600 0.7647rem/normal family.hs
  type.badge = 700 0.7647rem/normal family.hs
  type.licence = 400 0.7647rem/1.4615 family.hs
  space.page: length = 24px
  space.section: length = 28px
  space.s2: length = 2px
  space.s4: length = 4px
  space.s6: length = 6px
  space.s7: length = 7px
  space.s8: length = 8px
  space.s10: length = 10px
  space.s12: length = 12px
  space.s14: length = 14px
  space.s16: length = 16px
  space.s18: length = 18px
  space.s20: length = 20px
  space.s24: length = 24px
  radius.r4: length = 4px
  radius.r12: length = 12px
  radius.r16: length = 16px
  radius.r20: length = 20px
  radius.pill: length = 22px
  radius.button: length = 66px
  size.target: length = 44px
  size.row: length = 52px
  size.row-tall: length = 56px
  size.button: length = 132px
  size.dot: length = 8px
  size.mark: length = 28px
  size.slot: length = 30px
  size.mark-tall: length = 36px
  line.hair: length = -exact-hairline
  line.edge: length = 1.5px
  line.slot: length = 2px
  opacity.pressed: number = 0.8
  opacity.disabled: number = 0.6
  scale.pressed: number = 0.97
  shadow.button: box-shadow = 0px 10px 36px color-mix(in srgb, hs.shadow 30%, transparent)
  AccentColor = light-dark(#2c4542, #a88a62)
  Canvas = hs.ground
  CanvasText = hs.ink
  -exact-background = hs.ground
  -exact-secondary-background = hs.card
  -exact-label = hs.ink
  -exact-secondary-label = hs.quiet
  -exact-tertiary-label = hs.quiet
  -exact-system-red = hs.miss
  -exact-system-orange = hs.miss

icons
  icon.sprout = icon(svg "icons/sprout.svg")
