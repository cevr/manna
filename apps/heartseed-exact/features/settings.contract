// Settings: the sheet the header's gear opens, with the session's minutes,
// the voice and the appearance, Sounds and haptics, then About. Each choice is kept as plain
// text by `persist` and read by src/settings/choices.ts (`settingsOf`), the
// current Heartseed's rule: a kept text names its choice exactly, or the
// default stands. The session reads `settingsMinutes` and `settingsVoice`;
// the appearance is the app's scheme, set at once and again at each launch.
// The sheet is drawn as the current app's (src/settings/sheet.tsx,
// choices.tsx, src/appearance/choice.tsx): a page sheet with no bar, its own
// heading and an outlined Done; each choice under its line; the minutes and
// the voice and the appearance as pills filled in ink when chosen (the
// voice keeps its three radios where the current app draws one pill that
// cycles: orchestrator, q1); then Sounds and haptics, the port's own row,
// in the place of the current app's Show the welcome again; then About.
// Every measure is a token of app.forma (src/look/tokens.ts).

shape SettingsOption
  value: string
  label: string

shape SettingsView
  minutes: number
  voice: string
  appearance: string
  minutesOptions: SettingsOption[]
  voiceOptions: SettingsOption[]
  appearanceOptions: SettingsOption[]

shape SettingsFeel
  on: bool

// Sounds and haptics is on until the reader turns it off, as the hymnal's
// row (owner, q116), kept as its word (`settingsFeelKept`, "on" or "off")
// and read by `feelAnswer` (src/settings/feel.ts); every tick of the app
// plays only under it, through `feelTick` (features/feel.contract).
members HeartseedExact
  state settingsMinutesKept = "" persist
  state settingsVoiceKept = "" persist
  state settingsAppearanceKept = "" persist
  state settingsFeelKept = "on" persist
  resource settings = settingsOf(settingsMinutesKept, settingsVoiceKept, settingsAppearanceKept) as shape SettingsView else settingsOf("", "", "")
  resource settingsFelt = settingsFeelOf(settingsFeelKept) as shape SettingsFeel else empty(on=true)
  derive settingsFeel = settingsFelt.on
  derive settingsMinutes = settings.minutes
  derive settingsVoice = settings.voice
  derive settingsAppearance = settings.appearance
  derive settingsUnderId = match stack(nav).filter(x => not x.name.startsWith("settings")).at(-1) { case some(t) => t.id, case none => top(nav).id }

  action settingsOpen
    nav = push(nav, "/settings")
  action settingsDone
    nav = back(nav)
  action settingsChooseMinutes(value: string)
    settingsMinutesKept = value
  action settingsChooseVoice(value: string)
    settingsVoiceKept = value
  action settingsChooseAppearance(value: string)
    settingsAppearanceKept = value
  action settingsFeelSet(on: bool)
    settingsFeelKept = on ? "on" : "off"
  task settingsScheme key=settingsAppearance
    change(settingsShowScheme)
  action settingsShowScheme
    setScheme(settingsAppearance)

component SettingsChoice
  props
    line: string
    group: string
    name: string
    chosen: string
    options: SettingsOption[]
    choose: action
    fill: bool
  view
    column gap="space.s10" align-items="stretch"
      text line font="type.label"
      row role="radiogroup" appearance="none" aria-label=group display="flex" flex-direction="row" gap="space.s8" flex-wrap=(fill ? "nowrap" : "wrap")
        for o in options key=o.value
          button role="radio" aria-checked=(chosen == o.value) press=choose(o.value) appearance="none" flex-grow=(fill ? 1 : 0) flex-shrink=(fill ? 1 : 0) flex-basis=(fill ? "0%" : "auto") min-height="size.target" padding-left=(fill ? "0px" : "space.s14") padding-right=(fill ? "0px" : "space.s14") border-radius="radius.pill" background-color=(chosen == o.value ? "hs.ink" : "hs.card") color=(chosen == o.value ? "hs.on-ink" : "hs.ink") display="flex" align-items="center" justify-content="center" -exact-press-opacity="opacity.pressed" testId=`${name}-${o.value}`
            text o.label font="type.label"

component SettingsButton
  props
    label: string
    name: string
    go: action
  view
    button press=go appearance="none" box-sizing="border-box" min-height="size.target" padding-left="space.s18" padding-right="space.s18" border-radius="radius.pill" border-width="line.edge" border-style="solid" border-color="hs.ink" color="hs.ink" display="flex" align-items="center" justify-content="center" -exact-press-opacity="opacity.pressed" testId=name
      text label font="type.label"

component SettingsSheet
  props
    route: number
    settings: SettingsView
    minutes: action
    voice: action
    appearance: action
    feel: bool
    feelSwitch: action
    about: action
    done: action
  view
    column navigationKey=`${route}` navigationPresentation="modal" navigationBar="none" navigationScroll="settings-scroll" position="absolute" inset=0 display="flex" flex-direction="column" background-color="hs.ground" color="hs.ink" font-family="family.hs" testId="settings"
      header appearance="none" display="flex" flex-direction="row" flex-wrap="wrap" align-items="center" justify-content="space-between" gap="space.s12" min-height="size.target" padding-left="space.page" padding-right="space.page" padding-top="space.s20" padding-bottom="space.s8"
        text "Settings" role="heading" aria-level=1 font="type.sheet-title"
        SettingsButton(label="Done", name="settings-done", go=done)
      scroll id="settings-scroll" flex=1 min-height=0
        column gap="space.section" padding-top="space.s8" padding-left="space.page" padding-right="space.page" padding-bottom="space.s24"
          SettingsChoice(line="A day's tending", group="Minutes", name="minutes", chosen=`${settings.minutes}`, options=settings.minutesOptions, choose=minutes, fill=false)
          SettingsChoice(line="Reads new verses aloud", group="Voice", name="voice", chosen=settings.voice, options=settings.voiceOptions, choose=voice, fill=false)
          SettingsChoice(line="Appearance", group="Appearance", name="appearance", chosen=settings.appearance, options=settings.appearanceOptions, choose=appearance, fill=true)
          column gap="space.s12" align-items="flex-start"
            row gap="space.s12" align-items="center" min-height="size.target" max-width="100%"
              text "Sounds and haptics" font="type.label" flex-shrink=1 min-width=0
              input type="checkbox" switch checked=feel change=feelSwitch aria-label="Sounds and haptics" testId="settings-feel"
            SettingsButton(label="About", name="about-row", go=about)
