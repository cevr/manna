// Go to: the sheet the chapter's title and magnifier open over the Read
// tab (`gotoSheet "/read/goto"`, the large detent), and a book's chapters
// pushed inside it (`gotoBook "/read/goto/:book"`). Its find box is find's
// (`findQuery`, `findType`): while it holds text the body is
// `FindResults`; with it empty, Where your verses grow (the chapters of
// the field, in field order, 12 at most) and every book under its
// testament. A book opens its chapters as a grid, the chapter shown ringed
// and a chapter with a planted verse marked. A chapter, a place or a hit
// closes the sheet and reads there (`readOpenAt`). Every rule is
// src/goto/goto.ts's; this file draws it. The book buttons on a list's
// page and on Today read their chapter here too (`gotoListPlace`,
// `gotoTodayPlace`).
use FindResults, FindShown from "./find.contract"

shape ChooserBook
  number: number
  name: string
  chapters: number

shape ChooserTestament
  label: string
  books: ChooserBook[]

shape ChooserBooks
  heading: string
  testaments: ChooserTestament[]

shape GotoChapter
  found: bool
  book: number
  chapter: number
  name: string

shape GotoPlace
  found: bool
  book: number
  chapter: number
  verse: number
  name: string

shape GotoCell
  chapter: number
  current: bool
  planted: bool

shape GotoBook
  found: bool
  number: number
  name: string
  chapters: GotoCell[]

members HeartseedExact
  state gotoFind = false
  derive gotoBookArg = match stack(nav).filter(x => x.name == "gotoBook").at(-1) { case some(t) => t.params.book, case none => "" }
  derive gotoUp = stack(nav).filter(x => x.name == "gotoSheet").length > 0
  resource gotoBooksShown = gotoBooks() when gotoUp as shape ChooserBooks else empty()
  resource gotoGrowShown = gotoGrow(chooserField) when gotoUp as shape GotoChapter[] else empty()
  resource gotoBookShown = gotoBook(gotoBookArg, readBook, readChapter, chooserField) when gotoBookArg != "" as shape GotoBook else empty()
  resource gotoListPlace = gotoPlaceOf(match listShown.verses.at(0) { case some(v) => v.reference, case none => "" }) as shape GotoPlace else empty()
  resource gotoTodayPlace = gotoPlaceOf(today.reference) as shape GotoPlace else empty()

  action gotoOpen
    gotoFind = false
    nav = push(nav, path("gotoSheet"))
  action gotoOpenFind
    gotoFind = true
    nav = push(nav, path("gotoSheet"))
  task gotoFocused when top(nav).name == "gotoSheet" key=top(nav).id
    change(gotoFocusIt)
  action gotoFocusIt
    if gotoFind
      focus("goto-find")
  action gotoOpenBook(book: number)
    nav = push(nav, path("gotoBook", `${book}`))
  action gotoOpenAt(book: number, chapter: number, verse: number)
    findClear()
    readOpenAt(book, chapter, verse)
  action gotoDone
    findClear()
    if top(nav).name == "gotoBook"
      nav = back(back(nav))
    else
      nav = back(nav)
  action gotoReadList
    if gotoListPlace.found
      readOpenAt(gotoListPlace.book, gotoListPlace.chapter, gotoListPlace.verse)
  action gotoReadToday
    if gotoTodayPlace.found
      readOpenAt(gotoTodayPlace.book, gotoTodayPlace.chapter, gotoTodayPlace.verse)

component GotoSheet
  props
    route: number
    query: string
    found: FindShown
    type: action
    clear: action
    open: action
    grow: GotoChapter[]
    books: ChooserBooks
    book: action
    done: action
  view
    column navigationKey=`${route}` navigationPresentation="modal" navigationDetent="large" navigationScroll="goto-scroll" position="absolute" inset=0 display="flex" flex-direction="column" background-color="hs.ground" color="hs.ink" font-family="family.hs" testId="goto"
      header display="flex" align-items="center"
        text "Go to" role="heading" aria-level=2 flex=1
        button press=done testId="goto-done"
          text "Done"
      scroll id="goto-scroll" flex=1 min-height=0 testId="goto-scroll"
        column gap=20 padding=20 padding-bottom=48
          row gap=8 align-items="center"
            input id="goto-find" type="search" value=query input=type placeholder="Find a verse, a chapter or words" aria-label="Find a verse, a chapter or words" enterkeyhint="search" flex=1 min-width=0 min-height=44 testId="goto-find"
            if query != ""
              button press=clear testId="goto-cancel"
                text "Cancel"
          if query != ""
            FindResults(found=found, open=open)
          else
            if grow.length > 0
              column gap=8 testId="goto-grow"
                text "Where your verses grow" role="heading" aria-level=3 font="-exact-subheadline" color="-exact-secondary-label"
                row gap=8 flex-wrap="wrap"
                  for g in grow key=`${g.book}-${g.chapter}`
                    button press=open(g.book, g.chapter, 0) buttonStyle="bordered" min-height=44 aria-label=g.name testId=`grow-${g.book}-${g.chapter}`
                      text g.name
            for t in books.testaments key=t.label
              column gap=8
                text t.label role="heading" aria-level=3 font="-exact-subheadline" color="-exact-secondary-label"
                row gap=8 flex-wrap="wrap"
                  for b in t.books key=b.number
                    button press=book(b.number) buttonStyle="bordered" min-height=44 aria-label=b.name testId=`book-${b.number}`
                      text b.name

// A book's chapters, pushed inside Go to: a grid of numbers, each 44 pt,
// the chapter shown ringed in ink and a chapter with a verse of the field
// marked by a small leaf dot, said aloud.
component GotoBookPage
  props
    route: number
    book: GotoBook
    open: action
    done: action
  view
    column navigationKey=`${route}` navigationScroll="goto-book-scroll" position="absolute" inset=0 display="flex" flex-direction="column" background-color="hs.ground" color="hs.ink" font-family="family.hs" testId="goto-book"
      header display="flex" align-items="center"
        text book.name role="heading" aria-level=2 flex=1
        button press=done testId="goto-book-done"
          text "Done"
      scroll id="goto-book-scroll" flex=1 min-height=0
        row gap=8 padding=20 padding-bottom=48 flex-wrap="wrap" testId="goto-chapters"
          for c in book.chapters key=c.chapter
            button press=open(book.number, c.chapter, 0) appearance="none" aria-label=(c.planted ? `${book.name} ${c.chapter}, has verses in your field` : `${book.name} ${c.chapter}`) aria-current=(c.current ? "page" : "false") min-width="3.25rem" min-height="3.25rem" padding="0px 6px" box-sizing="border-box" border-radius=12 border-width=2 border-style="solid" border-color=(c.current ? "hs.ink" : "hs.card") background-color="hs.card" color="hs.ink" position="relative" display="flex" align-items="center" justify-content="center" -exact-press-scale=0.97 testId=`chapter-${c.chapter}`
              text `${c.chapter}` font-variant-numeric="tabular-nums"
              if c.planted
                column position="absolute" bottom=6 width=6 height=6 border-radius=3 background-color="hs.leaf" aria-hidden=true testId=`chapter-planted-${c.chapter}`
