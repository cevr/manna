// Today: the daily session's run, one verse at a time, heard with each word
// lit as the voice reaches it, and said under its cue while the matcher
// marks each word. At rest a word the cue hides is a button that shows it a
// moment, and Show all shows the verse whole, each capping the try's grade.
// Done shows the marks, the suggestion and the four grades; Next records
// the try in the garden (`gardenRecall`) and shows the next item, and
// nothing is recorded before it.
// Every rule is in src/today/ and src/session/, answered by the data sources
// in src/today/sources.ts: the recital's `step`, and the current Heartseed's
// own Session (the plan, the hold, the visit), with its counts, its run and
// its end. This file holds the root's Today members (the voice, the
// microphone, the recognizer, the clock and the calls), sends each route
// Today is drawn on as `todayOpen` with Settings' Minutes and Voice, and
// draws the view. The recognizer listens on the microphone's track, since
// Apple's implementation at the pin traps on `microphone=true`.
// `/today` and home run the session, `/start/:slug` starts that verse ahead
// of the plan, and `/cue/:cue` shows Isaiah 41:10 under the cue named, for
// the recital's own tests.
use speak, cancelSpeech, speechSynthesisState, speechUtterance, speechSynthesisVoices, SpeechUtteranceInfo, SpeechSynthesisState, SpeechUtterance, SpeechSynthesisVoices from "@exact/speech-synthesis"
use getUserMedia, stopTrack, MediaStream, MediaStreamTrack from "@exact/media-capture"
use startSpeechRecognition, stopSpeechRecognition, speechRecognitionState, SpeechRecognitionInfo, SpeechRecognitionState, SpeechRecognitionPhrase from "@exact/speech-recognition"
use SessionShown, SessionCounts, SessionEnd, SessionNothing from "./session.contract"

shape TodayTime
  epochAtZero: number
  utcOffset: number
  seed: number

shape TodayRecall
  reference: string
  startedAt: number
  offset: number
  grade: number
  suggested: number
  words: number
  missed: number
  peeked: number
  extra: number

shape TodayHelp
  reference: string
  peeked: number[]
  shownAt: option<number>
  cap: number

shape TodayResult
  reference: string
  recall: TodayRecall
  help: option<TodayHelp>

shape TodayGrade
  grade: number
  name: string
  enabled: bool
  chosen: bool

shape TodayWord
  index: number
  text: string
  shown: string
  label: string
  silent: bool
  lit: bool
  mark: string
  peekable: bool
  peeked: bool

shape TodayView
  reference: string
  passage: string
  phrases: SpeechRecognitionPhrase[]
  phase: string
  cue: string
  words: TodayWord[]
  lit: number
  canHear: bool
  canSay: bool
  canStop: bool
  canFinish: bool
  canShowAll: bool
  canNext: bool
  shownAll: bool
  peeking: number
  peekKey: string
  cap: number
  help: option<TodayHelp>
  helpLine: string
  moveBack: bool
  summary: string
  suggested: string
  grades: TodayGrade[]
  pending: option<TodayResult>
  last: option<TodayResult>
  refused: bool
  session: SessionShown

shape TodayReader
  on: bool
  voice: string

fn todayLastText(r: TodayResult): string = `Last time: ${r.recall.words - r.recall.missed} of ${r.recall.words} words`

fn todayWordColor(w: TodayWord, phase: string): string = w.mark == "miss" ? "-exact-system-red" : w.peeked ? "-exact-system-orange" : (w.mark == "matched" or w.mark == "tentative" or w.lit or phase == "graded") ? "-exact-label" : "-exact-secondary-label"

members HeartseedExact
  state todayUtterance = ""
  state todayRecognition = ""
  state todayTrack = ""
  resource todayTime = exactTime() as shape TodayTime
  resource todayBooted = todayBoot() as shape TodayView else empty()
  resource todayVoices = speechSynthesisVoices() as shape SpeechSynthesisVoices else empty()
  resource todayReader = todayReaderOf(todayVoices.voices, settingsVoice) as shape TodayReader else empty()
  resource todayVoiceState = speechSynthesisState(interval=50) when todayUtterance != "" as shape SpeechSynthesisState else empty()
  resource todaySpoken = speechUtterance(utterance=todayUtterance, interval=50) when todayUtterance != "" as shape SpeechUtterance else empty()
  resource todayHeardState = speechRecognitionState(recognition=todayRecognition, interval=50) when todayRecognition != "" as shape SpeechRecognitionState else empty()
  mutation todayStepped as shape TodayView queue
  mutation todaySpeaking as shape SpeechUtteranceInfo then todayBegun
  mutation todayOpened as shape MediaStream then todayOpenedIt
  mutation todayListening as shape SpeechRecognitionInfo then todayStarted
  mutation todayReleased as shape MediaStreamTrack
  mutation todayHushed as shape SpeechSynthesisState
  mutation todayClosed as shape SpeechRecognitionInfo
  derive today = match todayStepped { case some(v) => v, case none => todayBooted }
  derive todayFinals = todayHeardState.results.map(r => r.alternatives.slice(0, 1).map(a => a.transcript).join("")).join(" ")
  derive todayInterim = match todayHeardState.interim { case some(i) => i.alternatives.slice(0, 1).map(a => a.transcript).join(""), case none => "" }
  derive todayRoute = match stack(nav).filter(x => not x.name.startsWith("settings")).at(-1) { case some(t) => t.name, case none => "" }
  derive todaySlug = match stack(nav).filter(x => not x.name.startsWith("settings")).at(-1) { case some(t) => t.params.slug, case none => "" }
  derive todayCueArg = match stack(nav).filter(x => not x.name.startsWith("settings")).at(-1) { case some(t) => t.params.cue, case none => "" }
  derive todayOpenKey = `${todayRoute}|${todaySlug}|${todayCueArg}|${settingsMinutes}|${settingsVoice}`

  task todayArrived when current(todayBooted) key=todayOpenKey
    change(todayOpenIt)
  action todayOpenIt
    send todayStepped = todayOpen(todayRoute, todaySlug, todayCueArg, `${settingsMinutes}`, settingsVoice, todayTime.epochAtZero + performanceNow(), todayTime.seed)
  task todayRecorded when today.session.recorded > 0 key=today.session.recorded
    change(todayRefreshGarden)
  action todayRefreshGarden
    refresh garden
  action todayAddIt
    nav = push(nav, "/verses")
  action todayHomeIt
    nav = open(nav, "/")

  action todayHearIt
    if today.canHear and todayReader.on
      if todayReader.voice != ""
        send todaySpeaking = speak(text=today.passage, lang="en-US", voice=todayReader.voice)
      else
        send todaySpeaking = speak(text=today.passage, lang="en-US")
  derive todaySpeakingId = match todaySpeaking { case some(u) => u.id, case none => "" }
  derive todayVoiceId = match todayVoiceState.utterance { case some(u) => u, case none => "" }
  action todayBegun
    if todaySpeakingId != ""
      todayUtterance = todaySpeakingId
      send todayStepped = todayHear(todaySpeakingId)
  task todayFollow when todayUtterance != "" key=`${todayVoiceId}:${todayVoiceState.charIndex}:${todayVoiceState.charLength}`
    change(todayMoved)
  action todayMoved
    if todayVoiceId != ""
      send todayStepped = todayVoice(todayVoiceId, todayVoiceState.charIndex, todayVoiceState.charLength)
  task todayEnd when todayUtterance != "" key=`${todaySpoken.id}:${todaySpoken.state}`
    change(todayEnded)
  action todayEnded
    if todaySpoken.state == "ended"
      send todayStepped = todayVoiceEnded(todaySpoken.id, match todaySpoken.outcome { case some(o) => o, case none => "error" })
  action todayStopIt
    send todayHushed = cancelSpeech()
    send todayStepped = todayStop()

  action todaySayIt
    send todayOpened = getUserMedia(audio=true)
  derive todayOpenedTrack = match todayOpened { case some(s) => (match s.tracks.at(0) { case some(t) => t.id, case none => "" }), case none => "" }
  action todayOpenedIt
    if todayOpenedTrack != ""
      todayTrack = todayOpenedTrack
      send todayListening = startSpeechRecognition(track=todayOpenedTrack, lang="en-US", continuous=true, interimResults=true, processLocally=true, phrases=today.phrases)
  task todayMicRefused when failed(todayOpened) key=failed(todayOpened)
    change(todayRefusedIt)
  derive todayListeningId = match todayListening { case some(r) => r.id, case none => "" }
  derive todayListenFailed = match todayListening { case some(r) => (match r.error { case some(e) => true, case none => false }), case none => false }
  action todayStarted
    if todayListenFailed
      send todayReleased = stopTrack(track=todayTrack)
      todayTrack = ""
      send todayStepped = todayDenied()
    else if todayListeningId != ""
      todayRecognition = todayListeningId
      send todayStepped = todaySay(todayListeningId, todayTime.epochAtZero + performanceNow(), todayTime.seed)
  task todayRefused when failed(todayListening) key=failed(todayListening)
    change(todayRefusedIt)
  action todayRefusedIt
    if todayTrack != ""
      send todayReleased = stopTrack(track=todayTrack)
    todayTrack = ""
    send todayStepped = todayDenied()
  task todayHearFinal when todayRecognition != "" key=`${todayHeardState.id}|${todayFinals}`
    change(todayHeardFinal)
  action todayHeardFinal
    send todayStepped = todayHeard(todayHeardState.id, todayFinals, true)
  task todayHearInterim when todayRecognition != "" key=`${todayHeardState.id}|${todayInterim}`
    change(todayHeardInterim)
  action todayHeardInterim
    send todayStepped = todayHeard(todayHeardState.id, todayInterim, false)
  action todayFinishIt
    send todayClosed = stopSpeechRecognition(recognition=todayRecognition)
    send todayReleased = stopTrack(track=todayTrack)
    todayTrack = ""
    send todayStepped = todayFinish()

  action todayPeekIt(index: number)
    send todayStepped = todayPeek(index)
  task todayPeekShown when today.peeking >= 0 key=today.peekKey
    after(1500, todayPeekOver)
  action todayPeekOver
    send todayStepped = todayPeekEnded(today.peeking)
  action todayShowAllIt
    send todayStepped = todayShowAll(todayTime.epochAtZero + performanceNow())
  action todayGradeIt(grade: number)
    send todayStepped = todayGrade(grade)
  action todayNextIt
    send todayStepped = todayNext(todayTime.utcOffset, todayTime.epochAtZero + performanceNow(), todayTime.seed)
  action todayAgainIt
    send todayStepped = todayAgain()
    send todayOpened = getUserMedia(audio=true)

component TodayRecital
  props
    today: TodayView
    hear: action
    stop: action
    say: action
    finish: action
    peek: action
    showAll: action
    grade: action
    next: action
    again: action
  view
    column gap=20
      text today.reference role="heading" aria-level=2 testId=(today.session.mode == "run" ? "item-reference" : "reference")
      row testId="passage" flex-wrap="wrap" column-gap=8 row-gap=4
        for w in today.words key=w.index
          if w.peekable
            button press=peek(w.index) aria-label=w.label min-width=44 min-height=44 testId=`word-${w.index}`
              text w.shown font="-exact-title3" line-height=1.5 color=todayWordColor(w, today.phase)
          else
            text w.shown font="-exact-title3" line-height=1.5 max-width="100%" hyphens="auto" color=todayWordColor(w, today.phase) aria-label=w.label aria-hidden=w.silent testId=`word-${w.index}`
      if today.helpLine != ""
        text today.helpLine color="-exact-secondary-label" testId="help-line"
      if today.canNext
        column gap=12
          text today.summary font="-exact-headline" testId="result"
          text today.suggested color="-exact-secondary-label" testId="suggested"
          row role="radiogroup" aria-label="Grade" gap=8 flex-wrap="wrap"
            for g in today.grades key=g.grade
              button role="radio" aria-checked=g.chosen disabled=(not g.enabled) press=grade(g.grade) buttonStyle=(g.chosen ? "filled" : "bordered") testId=`grade-${g.grade}`
                text g.name
      row gap=12 flex-wrap="wrap"
        if today.canStop
          button press=stop buttonStyle="bordered" testId="stop"
            text "Stop"
        else if today.canHear
          button press=hear buttonStyle="bordered" testId="hear"
            text "Hear it"
        if today.canShowAll
          button press=showAll buttonStyle="bordered" testId="show-all"
            text "Show all"
        if today.canFinish
          button press=finish buttonStyle="filled" testId="finish"
            text "Done"
        else if today.canNext
          button press=again buttonStyle="bordered" testId="again"
            text "Say it again"
          button press=next buttonStyle="filled" testId="next"
            text "Next"
        else
          button press=say disabled=(not today.canSay) buttonStyle="filled" testId="say"
            text "Say it"
      if today.refused
        text "Heartseed can't hear you. Allow the microphone and speech recognition in Settings to say it." color="-exact-secondary-label" testId="refused"
      match today.last
        case some(r)
          text todayLastText(r) color="-exact-secondary-label" testId="last"
        case none
          column

component Today
  props
    today: TodayView
    hear: action
    stop: action
    say: action
    finish: action
    peek: action
    showAll: action
    grade: action
    next: action
    again: action
    add: action
    home: action
  view
    scroll id="content" navigationScroll="content" flex=1 min-height=0
      column gap=20 padding=20 max-width="40rem"
        SessionCounts(session=today.session)
        if today.session.mode == "run" and today.session.nothing
          SessionNothing(add=add)
        else if today.session.mode == "run" and today.session.ended
          SessionEnd(session=today.session, home=home)
        else if today.session.mode == "cued" or today.session.item
          TodayRecital(today=today, hear=hear, stop=stop, say=say, finish=finish, peek=peek, showAll=showAll, grade=grade, next=next, again=again)
