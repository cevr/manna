// The Read tab: a chapter of the Bible at the place the reader was last,
// kept across launches (`readBookKept`, `readChapterKept`), else the
// chapter of the first verse in the field, else John 1 (`readPlaceOf`,
// src/read/place.ts). `readBook`, `readChapter` and `readVerse` say what
// the Read tab's top entry shows: the kept place at its root (`/read`),
// the route's own at a followed reference (`readAt`). `readOpenAt` selects
// Read, pops it to its root, keeps the place and opens on the verse;
// `readFollow` pushes `readAt`, whose Back is named after the chapter
// left. Each lands with the verse's row as its fragment, so the host
// brings that row into view. Every step is src/read/nav.ts's `navStep`,
// which read.test.ts holds these actions to.
// The Garden's screens read their routes from `readGardenStack`: the
// Garden tab's stack, unless a Garden route was pushed onto Read and is
// up, so a screen kept under the other tab keeps what it shows. The
// chapter Read shows is the chapter screen for the place
// (features/chooser.contract).

shape ReadPlace
  id: number
  book: number
  chapter: number
  verse: number
  name: string

// Whether a route is a sheet over a tab (Settings and its pages, the Aa
// sheet, Go to and its book), drawn by a loop of its own over the screen
// under it.
fn readSheetOf(name: string): bool = name.startsWith("settings") or name == "typeSheet" or name.startsWith("goto")

// The id of a tab's top entry under any sheet: the one entry of that tab
// whose screen body is drawn.
fn readTopOf(s: Entry[]): number = match s.filter(x => not readSheetOf(x.name)).at(-1) { case some(t) => t.id, case none => 0 }

members HeartseedExact
  state readBookKept = "" persist
  state readChapterKept = "" persist
  state readOpenVerse = 0
  state readOpenings = 0
  derive readTabStack = match nav.tabs.filter(t => t.name == "read").at(0) { case some(t) => t.stack, case none => stack(nav) }
  derive readTop = match readTabStack.filter(x => not readSheetOf(x.name)).at(-1) { case some(t) => t, case none => top(nav) }
  derive readSheetUp = stack(nav).filter(x => readSheetOf(x.name)).length > 0
  derive readUp = readTop.name == "read" or readTop.name == "readAt"
  derive readGardenTab = match nav.tabs.filter(t => t.name == "garden").at(0) { case some(t) => t.stack, case none => stack(nav) }
  derive readGardenStack = (nav.tab == "read" and not readUp) ? stack(nav) : readGardenTab
  // The Read tab's first showing in a launch asks for every pack
  // (`packsFetch`'s ask, in the background); the packs' one quiet line
  // stands at the Read chapter's foot.
  state readAskedPacks = false
  task readAsksPacks when nav.tab == "read" key=nav.tab
    change(readAskPacks)
  action readAskPacks
    if not readAskedPacks
      readAskedPacks = true
      send packsFetched = packsAsk(packsKept, false, packsTime.epochAtZero + performanceNow())
  derive readFirst = match garden.lists.map(l => l.verses.map(v => v.reference)).flat().at(0) { case some(r) => r, case none => (match garden.singles.at(0) { case some(v) => v.reference, case none => "" }) }
  resource readKept = readPlaceOf(readBookKept, readChapterKept, readFirst) as shape ReadPlace else readPlaceOf("", "", "")
  resource readAts = readAtOf(x.id, x.params.book, x.params.chapter, x.params.verse) for x in readTabStack.filter(y => y.name == "readAt") key=x.id as shape ReadPlace
  derive readTopAt = match readAts.filter(p => p.id == readTop.id).at(0) { case some(p) => p, case none => readKept }
  derive readShown = readTop.name == "readAt" ? readTopAt : readKept
  derive readBook = readShown.book
  derive readChapter = readShown.chapter
  derive readVerse = readTop.name == "readAt" ? readTopAt.verse : (readOpenVerse > 0 ? readOpenVerse : readKept.verse)

  action readOpenAt(book: number, chapter: number, verse: number)
    readBookKept = `${book}`
    readChapterKept = `${chapter}`
    readOpenVerse = verse
    readOpenings = readOpenings + 1
    chooserFirst = 0
    chooserLast = 0
    chooserAnswer = ""
    nav = open(nav, path("read") + `#verse-${verse}`)
  action readFollow(book: number, chapter: number, verse: number)
    chooserFirst = 0
    chooserLast = 0
    chooserAnswer = ""
    if nav.tab == "read"
      nav = push(nav, path("readAt", `${book}`, `${chapter}`, `${verse}`) + `#verse-${verse}`)
    else
      nav = push(select(nav, "read"), path("readAt", `${book}`, `${chapter}`, `${verse}`) + `#verse-${verse}`)

// A driver's launch only (`gardenDriven`, as Your verses' test controls):
// the two ways into Read no screen calls yet, for tools/drive-read.ts.
// They float at the chapter's head and take no room of its own, so the
// drive measures the chapter as a plain launch lays it out, and a verse
// the agent brings into view stays clear of them.
component ReadDriven
  props
    open: action
    follow: action
  view
    row gap=8 padding="8px 20px" flex-wrap="wrap" position="absolute" left=0 right=0 top=0 testId="read-driven"
      button press=open(19, 119, 176) buttonStyle="bordered" testId="read-open-psalm"
        text "Open Psalm 119:176"
      button press=open(43, 3, 0) buttonStyle="bordered" testId="read-open-john"
        text "Open John 3"
      button press=follow(43, 3, 16) buttonStyle="bordered" testId="read-follow-john"
        text "Follow John 3:16"
