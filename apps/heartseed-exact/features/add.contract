// Add verses (`/add`): the current Heartseed's shelves in its order, as a
// grouped list. Any passage opens the chooser (features/chooser.contract);
// each shelf of picks or promises is a section of rows, one per list, each
// its title, its count and what it offers now; each section of Haskell's
// Bible Handbook is one row that opens its lists (`/add/handbook/:section`).
// A row opens its list (`/add/lists/:list`): its verses with their words
// and Plant. What each screen draws is src/add/shelves.ts's answer, the
// current app's rules (`SHELVES`, `offerStateOf`, `plantsSingly`) over the
// garden one call reads; Plant is the garden's `addPlant`, through its
// queue, and once it lands the reader is back at Add verses. Each screen's
// node names start with its own, since the screens under it stay drawn.
use GardenShown, GardenChange from "./garden.contract"
use homeMarkOf from "./home.contract"

shape AddRow
  id: string
  slug: string
  title: string
  count: string
  offer: string
  offerText: string
  singly: bool

shape AddShelf
  id: string
  slug: string
  title: string
  note: string
  kind: string
  rows: AddRow[]

shape AddShown
  read: bool
  line: string
  lineId: string
  shelves: AddShelf[]

shape AddSection
  found: bool
  slug: string
  title: string
  note: string
  line: string
  lineId: string
  rows: AddRow[]

shape AddVerse
  reference: string
  slug: string
  text: string

shape AddList
  found: bool
  row: AddRow
  shelf: string
  line: string
  lineId: string
  verses: AddVerse[]

members HeartseedExact
  state addAnswer = ""
  derive addOpen = stack(nav).filter(x => x.name == "add").length > 0
  derive addSectionArg = match stack(nav).filter(x => x.name == "addSection").at(-1) { case some(t) => t.params.section, case none => "" }
  derive addListArg = match stack(nav).filter(x => x.name == "addList").at(-1) { case some(t) => t.params.list, case none => "" }
  resource addShown = addRead(homeMarkOf(garden)) with gardenAt, gardenTime.seed when addOpen as shape AddShown else empty()
  resource addSectionShown = addSection(addSectionArg, homeMarkOf(garden)) with gardenAt, gardenTime.seed when addSectionArg != "" as shape AddSection else empty()
  resource addListShown = addList(addListArg, addAnswer, homeMarkOf(garden)) with gardenAt, gardenTime.seed when addListArg != "" as shape AddList else empty()
  mutation addPlanted as shape GardenChange queue refreshes garden then addLanded

  action addOpenIt
    nav = push(nav, "/add")
  action addOpenBible
    nav = push(nav, "/add/bible")
  action addOpenList(slug: string)
    addAnswer = ""
    nav = push(nav, path("addList", slug))
  action addOpenSection(slug: string)
    nav = push(nav, path("addSection", slug))
  action addPlantIt
    if addListShown.row.offer == "plant" and not pending(addPlanted)
      gardenClock = performanceNow()
      send addPlanted = addPlant(addListShown.row.slug, gardenTime.epochAtZero + performanceNow(), gardenTime.utcOffset, gardenTime.seed)
  derive addLandedAnswer = match addPlanted { case some(c) => c.answer, case none => "" }
  action addLanded
    addAnswer = addLandedAnswer
    if addLandedAnswer == "Planted" or addLandedAnswer == "Already"
      addAnswer = ""
      nav = go(nav, "/add")

component AddRowLink
  props
    row: AddRow
  view
    link href=path("addList", row.slug) testId=`offer-${row.slug}`
      column flex=1 min-width=0 gap=2
        text row.title overflow-wrap="break-word"
        text row.count color="-exact-secondary-label"
      if row.offerText != ""
        text row.offerText color="-exact-secondary-label" testId=`offer-state-${row.slug}`

component AddVersesPage
  props
    add: AddShown
    bible: action
  view
    column flex=1 min-height=0 display="flex" flex-direction="column"
      list id="add-list" navigationScroll="add-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 testId="add-verses"
        section
          header
            text "Add verses"
          for s in add.shelves.filter(x => x.kind == "bible") key=s.id
            button press=bible testId=`shelf-${s.slug}`
              column flex=1 min-width=0 gap=2
                text s.title
                text s.note color="-exact-secondary-label"
        for s in add.shelves.filter(x => x.kind == "lists") key=s.id
          section testId=`shelf-${s.slug}`
            header
              text `${s.title} · ${s.note}`
            for r in s.rows key=r.id
              AddRowLink(row=r)
        section
          header
            text "Bible Handbook"
          for s in add.shelves.filter(x => x.kind == "handbook") key=s.id
            link href=path("addSection", s.slug) testId=`handbook-${s.slug}`
              text s.title overflow-wrap="break-word"
      if add.line != ""
        text add.line role="alert" padding="12px 20px" flex-shrink=0 testId=`add-${add.lineId}`

component AddSectionPage
  props
    section: AddSection
  view
    column flex=1 min-height=0 display="flex" flex-direction="column"
      list id="add-section" navigationScroll="add-section" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 testId="add-section"
        section
          header
            text section.title
          for r in section.rows key=r.id
            AddRowLink(row=r)
          footer
            text section.note
      if section.line != ""
        text section.line role="alert" padding="12px 20px" flex-shrink=0 testId=`section-${section.lineId}`

component AddListPage
  props
    list: AddList
    pending: bool
    plant: action
  view
    column flex=1 min-height=0 display="flex" flex-direction="column"
      scroll id="shelf-scroll" navigationScroll="shelf-scroll" flex=1 min-height=0
        column gap=12 padding=20 max-width="40rem" testId="shelf-list"
          text list.row.title role="heading" aria-level=2 overflow-wrap="break-word" testId="shelf-title"
          text list.row.count color="-exact-secondary-label" testId="shelf-count"
          for v in list.verses key=v.slug
            column gap=2 testId=`shelf-verse-${v.slug}`
              text v.reference font="-exact-headline"
              text v.text overflow-wrap="break-word" hyphens="auto"
      column gap=6 padding="12px 20px" flex-shrink=0
        if list.row.offer == "in field"
          text list.row.offerText testId="shelf-state"
        if list.line != ""
          text list.line role="alert" testId=`shelf-${list.lineId}`
        if list.row.offer == "plant"
          button press=plant buttonStyle="filled" disabled=pending testId="shelf-plant"
            text "Plant"
