{
  "name": "Heartseed",
  "short_name": "Heartseed",
  "id": "app.heartseed.exact",
  "start_url": "/",
  "env": [
    { "name": "HEARTSEED_GARDEN_DRIVE", "launch": true },
    { "name": "HEARTSEED_FIND_PACK", "launch": true },
    { "name": "HEARTSEED_PACKS_BASE", "launch": true },
    { "name": "HEARTSEED_TURN_PROBE", "launch": true }
  ],
  "display": "standalone",
  "verify": {
    "accept": [
      {
        "finding": "target",
        "node": "word-*",
        "why": "As One's (owner, q153: match One): a word to peek at is the word's own width and 36 pt tall, with One's 4-pt hit slop (apps/heartseed/src/sayit/draw.tsx, Peek)"
      }
    ]
  },
  "app": {
    "id": "app.heartseed.exact",
    "name": "Heartseed"
  },
  "host": {
    "web": {},
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": ["iphone", "ipad"]
    }
  },
  "deploy": {
    "store": {
      "web": "0",
      "ios": "0"
    }
  }
}
