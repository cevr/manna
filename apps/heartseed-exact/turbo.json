{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "test:garden-a",
        "test:garden-b",
        "test:garden-c",
        "test:garden-bytes"
      ],
      "env": ["HEARTSEED_GARDEN_DRIVE"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/heartseed/package.json",
        "$TURBO_ROOT$/apps/heartseed/src/**",
        "$TURBO_ROOT$/apps/heartseed/vite/passage.ts",
        "$TURBO_ROOT$/apps/heartseed/data/kjv-hearings.json",
        "$TURBO_ROOT$/apps/heartseed/data/handbook.json",
        "$TURBO_ROOT$/packages/core/assets/kjv.json"
      ]
    },
    "test:garden-a": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/heartseed/package.json",
        "$TURBO_ROOT$/apps/heartseed/src/**",
        "$TURBO_ROOT$/apps/heartseed/vite/passage.ts",
        "$TURBO_ROOT$/apps/heartseed/data/handbook.json",
        "$TURBO_ROOT$/packages/core/assets/kjv.json"
      ]
    },
    "test:garden-b": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/heartseed/package.json",
        "$TURBO_ROOT$/apps/heartseed/src/**",
        "$TURBO_ROOT$/apps/heartseed/vite/passage.ts",
        "$TURBO_ROOT$/apps/heartseed/data/handbook.json",
        "$TURBO_ROOT$/packages/core/assets/kjv.json"
      ]
    },
    "test:garden-bytes": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/heartseed/package.json",
        "$TURBO_ROOT$/apps/heartseed/src/**",
        "$TURBO_ROOT$/apps/heartseed/vite/passage.ts",
        "$TURBO_ROOT$/apps/heartseed/data/handbook.json",
        "$TURBO_ROOT$/packages/core/assets/kjv.json"
      ]
    },
    "test:garden-c": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/heartseed/package.json",
        "$TURBO_ROOT$/apps/heartseed/src/**",
        "$TURBO_ROOT$/apps/heartseed/vite/passage.ts",
        "$TURBO_ROOT$/apps/heartseed/data/handbook.json",
        "$TURBO_ROOT$/packages/core/assets/kjv.json"
      ]
    }
  }
}
