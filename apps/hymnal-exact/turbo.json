{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "test:app",
        "test:player",
        "test:web",
        "test:chords",
        "test:moves",
        "test:hymn",
        "test:find",
        "test:motion",
        "test:about"
      ],
      "outputs": []
    },
    "test:about": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/hymnal/src/**",
        "$TURBO_ROOT$/apps/hymnal/vite/**",
        "$TURBO_ROOT$/apps/hymnal/assets/meaning/**",
        "$TURBO_ROOT$/packages/hymnal/src/**",
        "$TURBO_ROOT$/packages/hymnal/data/sdah-1985/**"
      ]
    },
    "test:motion": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json", "$TURBO_ROOT$/apps/hymnal/src/**"]
    },
    "test:find": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json", "$TURBO_ROOT$/apps/hymnal/src/**"]
    },
    "test:app": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/hymnal/src/**",
        "$TURBO_ROOT$/apps/hymnal/vite/**",
        "$TURBO_ROOT$/packages/hymnal/src/**",
        "$TURBO_ROOT$/packages/hymnal/scripts/playback.ts",
        "$TURBO_ROOT$/packages/hymnal/data/sdah-1985/**",
        "$TURBO_ROOT$/packages/hymnal/data/playback/**"
      ]
    },
    "test:player": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "passThroughEnv": ["PROTOCOL_DEPTH"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/hymnal/src/**",
        "$TURBO_ROOT$/apps/hymnal/vite/**",
        "$TURBO_ROOT$/packages/hymnal/src/**",
        "$TURBO_ROOT$/packages/hymnal/scripts/playback.ts",
        "$TURBO_ROOT$/packages/hymnal/data/sdah-1985/**",
        "$TURBO_ROOT$/packages/hymnal/data/playback/**"
      ]
    },
    "test:web": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json", "$TURBO_ROOT$/apps/hymnal/src/**"]
    },
    "test:chords": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/hymnal/src/**",
        "$TURBO_ROOT$/apps/hymnal/vite/**",
        "$TURBO_ROOT$/packages/hymnal/src/**",
        "$TURBO_ROOT$/packages/hymnal/scripts/playback.ts",
        "$TURBO_ROOT$/packages/hymnal/data/sdah-1985/**",
        "$TURBO_ROOT$/packages/hymnal/data/playback/**",
        "!src/*.test.*",
        "!src/{find,home,hymns,list,look,player,settings,web}/**/*.test.*"
      ]
    },
    "test:hymn": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/hymnal/src/**",
        "$TURBO_ROOT$/apps/hymnal/vite/**",
        "$TURBO_ROOT$/packages/hymnal/src/**",
        "$TURBO_ROOT$/packages/hymnal/scripts/playback.ts",
        "$TURBO_ROOT$/packages/hymnal/data/sdah-1985/**",
        "$TURBO_ROOT$/packages/hymnal/data/playback/**",
        "!src/*.test.*",
        "!src/{chords,find,home,hymns,list,look,player,settings,web}/**/*.test.*"
      ]
    },
    "test:moves": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/hymnal/src/**",
        "$TURBO_ROOT$/apps/hymnal/vite/**",
        "$TURBO_ROOT$/packages/hymnal/src/**",
        "$TURBO_ROOT$/packages/hymnal/scripts/playback.ts",
        "$TURBO_ROOT$/packages/hymnal/data/sdah-1985/**",
        "$TURBO_ROOT$/packages/hymnal/data/playback/**",
        "!src/*.test.*",
        "!src/{find,home,hymns,list,look,player,settings,web}/**/*.test.*"
      ]
    }
  }
}
