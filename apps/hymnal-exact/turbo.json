{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "test:app",
        "test:web",
        "test:chords",
        "test:moves",
        "test:find",
        "test:motion"
      ],
      "outputs": []
    },
    "test:motion": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json", "$TURBO_ROOT$/apps/hymnal/src/**"]
    },
    "test:find": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json", "$TURBO_ROOT$/apps/hymnal/src/**"]
    },
    "test:app": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "passThroughEnv": ["PROTOCOL_DEPTH"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/hymnal/src/**",
        "$TURBO_ROOT$/apps/hymnal/vite/**",
        "$TURBO_ROOT$/packages/hymnal/src/**",
        "$TURBO_ROOT$/packages/hymnal/scripts/playback.ts",
        "$TURBO_ROOT$/packages/hymnal/data/sdah-1985/**",
        "$TURBO_ROOT$/packages/hymnal/data/playback/**",
        "!src/web/**/*.test.*",
        "!src/chords/**/*.test.*",
        "!src/find/**/*.test.*",
        "!src/list/headers.test.ts",
        "!src/no-bucket.test.ts",
        "!src/look/motion.test.ts",
        "!src/settings/feel.test.ts"
      ]
    },
    "test:web": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json", "$TURBO_ROOT$/apps/hymnal/src/**"]
    },
    "test:chords": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/hymnal/src/**",
        "$TURBO_ROOT$/apps/hymnal/vite/**",
        "$TURBO_ROOT$/packages/hymnal/src/**",
        "$TURBO_ROOT$/packages/hymnal/scripts/playback.ts",
        "$TURBO_ROOT$/packages/hymnal/data/sdah-1985/**",
        "$TURBO_ROOT$/packages/hymnal/data/playback/**",
        "!src/**/*.test.*",
        "src/chords/page.test.ts",
        "src/chords/held.test.ts",
        "src/chords/host.test.ts"
      ]
    },
    "test:moves": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/apps/hymnal/src/**",
        "$TURBO_ROOT$/apps/hymnal/vite/**",
        "$TURBO_ROOT$/packages/hymnal/src/**",
        "$TURBO_ROOT$/packages/hymnal/scripts/playback.ts",
        "$TURBO_ROOT$/packages/hymnal/data/sdah-1985/**",
        "$TURBO_ROOT$/packages/hymnal/data/playback/**",
        "!src/**/*.test.*",
        "src/chords/move.test.ts",
        "src/chords/rows.test.ts",
        "src/chords/shape.test.ts"
      ]
    }
  }
}
