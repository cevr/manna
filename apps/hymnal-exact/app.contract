// The hymnal: the view. app.ts answers what it asks for. Colours, fonts, sizes
// and the safe area are left unsaid, so each platform supplies its own: a
// screen's header is the navigation bar, its heading the title.
// A feature adds one `use` line, one `members` line, its route, and its screen
// under the stack below (README.md, "Adding a feature").
use HymnList from "./features/list.contract"
use HymnPage from "./features/hymn.contract"
use PlayerDock, PlayerSheet from "./features/player.contract"
use RecentScreen from "./features/recent.contract"

routes nav
  list "/"
    hymn "/hymns/:n"
    player "/player"
    recent "/recent"

component HymnalExact
  members "./features/list.contract"
  members "./features/hymn.contract"
  members "./features/player.contract"
  members "./features/recent.contract"
  members "./features/favourites.contract"
  provide
    playerShown = player
    playerPress = playerAsk
    favouriteNumbers = favouriteList
    favouritePress = favouriteToggle
  action follow(url: string)
    nav = go(nav, url)
  view
    main testId="root" navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "list"
          HymnList(entry=e, query=listQuery, sections=listRows, search=listSearch, tab=listTab, tabs=listTabNames, choose=listChoose, groups=listGroups, titles=listTitleOf, recent=recentShown, favourites=favouriteList, open=listOpen)
        if e.name == "hymn"
          HymnPage(entry=e, page=hymnShown, ready=current(hymnShown))
        if e.name == "player"
          PlayerSheet(entry=e, player=player, ask=playerAsk)
        if e.name == "recent"
          RecentScreen(entry=e, recent=recentShown, favourites=favouriteList)
      PlayerDock(player=player, ask=playerAsk, heard=playerHeard, broke=playerFailed)
