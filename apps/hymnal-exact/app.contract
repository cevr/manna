// The hymnal: the view. app.ts answers what it asks for. The colours are the
// brand's (app.forma), which also sets the platform's own roles, so a screen
// that names none is drawn in them; fonts, sizes and the safe area are left
// unsaid, so each platform supplies its own: a screen's header is the
// navigation bar, its heading the title.
// A feature adds one `use` line, one `members` line, its route, and its screen
// under the stack below (README.md, "Adding a feature").
// Each route renders in the browser (`render=client`, the default): a page
// rendered at build keeps its answers when the reader's kept lists differ
// (README.md, "The web"). A path no route matches, and a hymn's address for a
// number the hymnal has not, draws the not-found screen.
use HymnList from "./features/list.contract"
use HymnPage from "./features/hymn.contract"
use PlayerSheet from "./features/player.contract"
use PlayerDock from "./features/bar.contract"
use SettingsSheet from "./features/settings.contract"
use AboutScreen from "./features/about.contract"
use RecentScreen from "./features/recent.contract"
use NotFound from "./features/notfound.contract"
use ChordsGripScreen from "./features/chords.contract"
use FindDrums from "./features/find.contract"
use AboutHymnSheet from "./features/abouthymn.contract"
use KeysOver from "./features/keys.contract"

routes nav
  list "/"
    hymn "/hymns/:n"
      chord "/hymns/:n/chord/:grip"
      abouthymn "/hymns/:n/about"
    player "/player"
    settings "/settings"
      about "/settings/about"
    recent "/recent"
  notfound

component HymnalExact
  members "./features/list.contract"
  members "./features/hymn.contract"
  members "./features/player.contract"
  members "./features/settings.contract"
  members "./features/about.contract"
  members "./features/recent.contract"
  members "./features/favourites.contract"
  members "./features/chords.contract"
  members "./features/find.contract"
  members "./features/motion.contract"
  members "./features/abouthymn.contract"
  members "./features/bar.contract"
  members "./features/pager.contract"
  members "./features/keys.contract"
  members "./features/tempo.contract"
  provide
    playerShown = player
    playerPress = playerAsk
    settingsGear = settingsOpen
    favouriteNumbers = favouriteList
    favouritePress = favouriteToggle
    chordsSwitchOn = chordsOn
    chordsSwitch = chordsSet
    findShown = find
    findPress = findAsk
    findSearchOn = findSearch
    findSearchOff = findCancel
    findTyped = findType
    findText = listQuery
    findTop = findTopId
    findRows = listRows
    findOpen = listOpen
    findDial = findTurn
    findDismiss = findDismissed
    findDrumsKey = findDrumsKeyed
    findGroups = findTileGroups
    findPick = findTilePick
    findTabName = listTab
    findWheel = findWheeled
    listRested = listRested
    listLand = listLand
    listLanded = listLanded
    motionStill = motionStill
    settingsFeel = settingsFeel
    settingsFeelSwitch = settingsFeelSet
    abouthymnPress = abouthymnAsk
    hymnPressBack = hymnBack
    playerSoundOn = playerSound
    playerSoundPress = playerSoundSwitch
    playerIntroOn = playerIntro
    playerClickOn = playerClick
    playerIntroPress = playerIntroSwitch
    playerClickPress = playerClickSwitch
    keysShown
    keysPlaced
    keysOpen
    keysHolding
    keysWheelOpen
    keysWheelOver
    keysWheelItems
    keysAsk
    keysTap
    keysDown
    keysUp
    keysPan
    keysLetGo
    keysKeyScrolled
    keysKeySettled
    keysKeyAdjusted
    keysCapoScrolled
    keysCapoSettled
  action follow(url: string)
    nav = go(nav, url)
  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="hymn-back" navigate=follow color-scheme=settingsScheme width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "list"
          HymnList(entry=e, query=listQuery, sections=listRows, tab=listTab, tabs=listTabNames, choose=listChoose, groups=listGroups, titles=listTitleOf, recent=recentShown, favourites=favouriteList, open=listOpen)
        if e.name == "hymn" and not (current(hymnShown) and hymnShown.number == 0)
          HymnPage(entry=e, page=hymnShown, ready=current(hymnShown), chords=chordsShown, numbers=pagerNumbers, pages=pagerPages, chordsAll=pagerChords, ended=pagerEnded, armed=pagerArmed)
        if e.name == "player"
          PlayerSheet(entry=e, player=player, ask=playerAsk)
        if e.name == "settings"
          SettingsSheet(entry=e, looks=settingsLooks, choose=settingsChoose, done=settingsClose, chords=settingsChordRows, chooseStyle=settingsStyleChoose, choosePlacement=settingsPlacementChoose)
        if e.name == "about"
          AboutScreen(entry=e, page=aboutShown)
        if e.name == "recent"
          RecentScreen(entry=e, recent=recentShown, favourites=favouriteList)
        if e.name == "notfound" or (e.name == "hymn" and current(hymnShown) and hymnShown.number == 0)
          NotFound(entry=e)
        if e.name == "chord"
          ChordsGripScreen(entry=e, page=chordsGripShown, ready=current(chordsGripShown), done=chordsGripClose)
        if e.name == "abouthymn"
          AboutHymnSheet(entry=e, page=abouthymnShown, ready=current(abouthymnShown), done=abouthymnClose, choose=abouthymnChoose)
      PlayerDock(player=player, ask=playerAsk, heard=playerHeard, ticked=playerTicked, broke=playerFailed, remote=playerRemote)
      KeysOver()
      FindDrums()
