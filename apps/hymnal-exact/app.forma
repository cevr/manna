// The hymnal's brand: the current hymnal's colour roles (apps/hymnal/src/theme.ts,
// Heartseed's palette), light and dark, each under the role's own name, and the
// platform's roles the port's screens draw with, each set to one of them.
// src/look/brand.test.ts holds every colour here to theme.ts, but the ones
// UIKit draws in the current app that theme.ts does not name (its list
// `UIKIT`, each with its source). The tint
// (AccentColor) is the accent, as in the current app (the owner's choice).
forma hymnal

theme
  ground = light-dark(#f1f0e6, #142420)
  ink = light-dark(#2c4542, #e6eedb)
  muted = light-dark(#5a6761, #a0b4a7)
  line = light-dark(#cfdcc4, #2d463c)
  accent = light-dark(#2c4542, #e6eedb)
  button = light-dark(#2c4542, #e6eedb)
  onButton = light-dark(#f1f0e6, #142420)
  selected = light-dark(#dde4d2, #3d5c4f)
  chord = light-dark(#80641f, #d4a640)
  soft = light-dark(#dde4d2, #263d35)
  onAccent = light-dark(#f1f0e6, #142420)
  pressed = light-dark(#536763, #bcc6b6)
  onPressed = light-dark(#f1f0e6, #142420)
  panel = light-dark(#f9f8f1, #1d322c)
  edge = light-dark(#6d8474, #627c6e)
  bar = light-dark(#f1f0e6, #142420)
  pill = light-dark(#b9cfae, #e6eedb)
  onPill = light-dark(#2c4542, #142420)
  chosen = light-dark(#2c4542, #142420)
  onChosen = light-dark(#f1f0e6, #e6eedb)
  alert = light-dark(#a04a34, #f09982)
  shadow = light-dark(#2c4542, #000000)
  glass = light-dark(#dde4d2d9, #263d35d9)
  onGlass = light-dark(#2c4542, #e6eedb)
  onGlassMuted = light-dark(#415853, #bec9b8)
  glassChosen = light-dark(#2c4542, #e6eedb)
  onGlassChosen = light-dark(#f1f0e6, #142420)
  fieldClear = light-dark(#00000033, #ffffff33)
  -exact-background = ground
  -exact-grouped-background = ground
  -exact-secondary-background = bar
  -exact-secondary-grouped-background = ground
  -exact-label = ink
  -exact-secondary-label = muted
  -exact-separator = line
  AccentColor = accent
  AccentColorText = onAccent
  Canvas = ground
  CanvasText = ink
  duration.fade = 150ms
  duration.exit = 150ms
  duration.bar-in = 250ms
  duration.bar-out = 150ms
  duration.panel = 250ms
  duration.tiles-in = 180ms
  duration.tiles-out = 140ms
  duration.growth = 250ms
  easing.growth = -exact-spring(632, 50, 1)
  easing.out = cubic-bezier(0.23, 1, 0.32, 1)
  type.sheet-title = 700 1.6471rem/normal
  type.hymn-title = 700 -exact-title2/normal
  type.hymn-number = 600 -exact-title2/normal
  type.head = 700 1.2941rem/normal
  type.name = 700 1.1765rem/normal
  type.chevron = 400 1.2941rem/normal
  type.strong = 600 1rem/normal
  type.body = 400 1rem/normal
  type.line = 400 1rem/1.4118
  type.small = 400 0.8824rem/normal
  type.label = 600 0.8824rem/normal
  type.caption = 400 -exact-subheadline/normal
  type.footnote = 400 -exact-footnote/normal
  type.note = 400 0.7647rem/normal
  type.large-title = 700 2rem/1.2059
  type.topic = 600 0.8824rem/1.3333
  type.see-all = 400 0.8824rem/1.3333
  type.row-number = 600 1rem/1.2941
  type.row-title = 400 1rem/1.2941
  type.part = 600 -exact-footnote/normal
  type.chord = 600 -exact-subheadline/1.3333
  type.mark = 400 0.8235rem/1.2857
  type.first = 400 0.7647rem/1.3846
  type.finger = 700 0.6471rem/1.2727
  type.chip = 600 0.7647rem/normal
  space.s4: length = 4px
  space.s6: length = 6px
  space.s8: length = 8px
  space.s10: length = 10px
  space.s11: length = 11px
  space.s12: length = 12px
  space.s16: length = 16px
  space.s20: length = 20px
  space.s24: length = 24px
  space.s40: length = 40px
  space.s48: length = 48px
  space.s64: length = 64px
  radius.r12: length = 12px
  radius.r16: length = 16px
  radius.r18: length = 18px
  radius.pill: length = 22px
  radius.grabber: length = 2.5px
  size.target: length = 44px
  size.button: length = 36px
  size.mark: length = 28px
  size.glyph: length = 22px
  size.clear: length = 17px
  size.grabber: length = 36px
  size.grabber-line: length = 5px
  size.slider: length = 32px
  line.hair: length = -exact-hairline
  line.panel: length = 1px
  opacity.pressed: number = 0.6
  nudge.title: length = -0.3333px
  nudge.topic: length = -1px
  nudge.tab: length = -0.6667px
  nudge.row: length = 1.3333px
  nudge.number: length = 1px
  nudge.gear: length = 26px
  nudge.gear-left: length = -0.6667px
  nudge.settings-heading: length = -0.6667px
  nudge.settings-title: length = 0.6667px
  nudge.settings-body: length = -0.2222px

icons
  icon.find-clear = icon(svg "icons/find-clear.svg")
