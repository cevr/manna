{
  "name": "@manna/hymnal-exact",
  "private": true,
  "type": "module",
  "scripts": {
    "exact": "bun src/hymns/make.ts && manna-exact",
    "build:web": "bun run exact web-build --out dist && bun tools/web/pages.ts dist",
    "serve:web": "bun run exact serve dist",
    "typecheck": "tsc -p tsconfig.src.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "test:app": "bun test --preload ./src/test/setup.ts --path-ignore-patterns=src/web/place.test.ts --path-ignore-patterns=src/web/served.test.ts --path-ignore-patterns=src/web/pages.test.ts --path-ignore-patterns=src/web/budget.test.ts --path-ignore-patterns=src/chords --path-ignore-patterns=src/find --path-ignore-patterns=src/list/headers.test.ts --path-ignore-patterns=src/no-bucket.test.ts --path-ignore-patterns=src/look/motion.test.ts --path-ignore-patterns=src/settings/feel.test.ts ./src",
    "test:motion": "bun test --preload ./src/test/setup.ts ./src/look/motion.test.ts ./src/settings/feel.test.ts",
    "test:web": "bun test --preload ./src/test/setup.ts ./src/web",
    "test:chords": "bun test --preload ./src/test/setup.ts ./src/chords/page.test.ts ./src/chords/held.test.ts ./src/chords/host.test.ts",
    "test:moves": "bun test --preload ./src/test/setup.ts ./src/chords/move.test.ts ./src/chords/rows.test.ts ./src/chords/shape.test.ts",
    "test:find": "bun test --preload ./src/test/setup.ts ./src/find ./src/list/headers.test.ts ./src/no-bucket.test.ts"
  },
  "dependencies": {
    "@manna/exact-kit": "workspace:*",
    "@manna/hymnal": "workspace:*",
    "@manna/hymnal-app": "workspace:*"
  }
}
