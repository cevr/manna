// The player against the fixture recordings (tools/recordings.ts, digital
// silence), which `bun run exact test` serves on the checkout's own port
// and names in HYMNAL_RECORDINGS (README, "The player"). Each test holds
// the player to a loopback fixture before it plays, so no test ever asks
// the bucket. A playing element runs on real time, so its
// place is checked as a lower bound after `clock +N real`. Each test opens on
// Settings and turns Sounds and haptics off before it plays (the owner's
// rule; src/look/quiet.test.ts holds every test that plays to it).

test "Play starts the hymn and the bar shows it"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  expect state player.fixture == true
  expect tree has "bar"
  expect tree has "bar-grabber"
  expect tree missing "bar-title"
  tap "play"
  clock data
  clock settle
  expect tree has "bar-title"
  expect tree has "bar-grabber"
  expect tree missing "bar-hymn"
  expect state player.bar.number == 1
  clock until state player.phase == "playing" within 10000
  clock +3500 real
  clock data
  expect state player.at >= 3
  expect state player.bar.toggle == "pause"
  expect tree has "bar-toggle"
  expect mediasession title == "Praise to the Lord"
  expect mediasession has "pause"

test "Pause holds the place; resume goes on."
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  expect state player.fixture == true
  tap "play"
  clock data
  clock until state player.phase == "playing" within 10000
  clock +1500 real
  clock data
  tap "bar-toggle"
  clock data
  clock settle
  expect state player.phase == "paused"
  expect state player.bar.toggle == "play"
  expect state player.at >= 1
  expect state player.at <= 3
  clock +1500 real
  clock data
  expect state player.phase == "paused"
  expect state player.at <= 3
  tap "bar-toggle"
  clock data
  clock until state player.phase == "playing" within 10000
  clock +1500 real
  clock data
  expect state player.at >= 2
  expect state player.bar.toggle == "pause"

test "The bar follows across screens"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  expect state player.fixture == true
  tap "play"
  clock data
  clock until state player.phase == "playing" within 10000
  back
  clock settle
  clock data
  expect text "title" == "Hymns"
  expect text "bar-number" == "1"
  expect text "bar-hymn" == "Praise to the Lord"
  expect tree missing "bar-grabber"
  expect state player.bar.toggle == "pause"
  tap "find-search"
  clock settle
  clock data
  type "search" "3"
  clock data
  tap "hymn-3"
  clock settle
  clock data
  expect text "bar-number" == "1"
  expect text "bar-hymn" == "Praise to the Lord"
  expect state player.bar.toggle == "pause"
  expect text "bar-page-play" == "Play 3"
  tap "bar-page-play"
  clock data
  clock settle
  expect state player.number == 3
  expect tree missing "bar-page-play"

test "The full player"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-2"
  clock settle
  clock data
  expect state player.fixture == true
  tap "play"
  clock data
  clock until state player.phase == "playing" within 10000
  clock data
  expect state player.length >= 200
  clock settle
  tap "bar-title"
  clock data
  clock settle
  expect tree has "player"
  expect text "total" == "4:00"
  tap "stanza-2"
  clock data
  tap "stanza-4"
  clock data
  clock settle
  expect state player.chips.1 .chosen == false
  expect state player.chips.2 .chosen == true
  expect text "total" == "2:16"
  tap "player-title"
  clock data
  clock settle
  expect tree missing "player"
  expect text "hymn-title" == "All Creatures of Our God and King"
  expect state player.bar.number == 2
  expect tree has "bar-grabber"

test "The lock screen's pause pauses"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  expect state player.fixture == true
  tap "play"
  clock data
  clock until state player.phase == "playing" within 10000
  tap "audio" mediasession "pause"
  clock data
  clock settle
  expect state player.phase == "paused"
  expect state player.bar.said == "Paused"
  expect state player.bar.toggle == "play"

test "It ends"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  expect state player.fixture == true
  tap "play"
  clock data
  clock until state player.phase == "playing" within 10000
  clock until state player.phase == "ended" within 15000
  clock data
  clock settle
  expect state player.bar.said == "Played to the end"
  expect state player.bar.toggle == "play"
  expect tree missing "bar-said"
  expect state player.at >= 5

// The fixture's recording loads before a step can read the bar, so the
// spinner's state is held by src/player/bar/bar.model.test.ts, not here.
test "The bar's button: Pause and the seeker while it plays, Play once paused"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  expect state player.fixture == true
  expect state player.pageLabel == "Play hymn 1"
  expect tree has "bar-sound"
  expect tree missing "seeker"
  tap "play"
  clock data
  clock until state player.phase == "playing" within 10000
  clock data
  clock settle
  expect tree missing "bar-loading"
  expect state player.bar.kind == "pause"
  expect state player.bar.label == "Pause hymn 1"
  expect state player.bar.mark == "symbol:sf/pause.fill"
  expect tree has "seeker"
  expect tree has "seek"
  tap "bar-toggle"
  clock data
  clock settle
  expect state player.phase == "paused"
  expect state player.bar.kind == "play"
  expect state player.bar.label == "Play hymn 1"
  expect state player.bar.mark == "symbol:sf/play.fill"
  expect tree missing "seeker"

test "The Sound switch is kept through a reload"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  expect state playerSound == true
  tap "bar-sound"
  clock settle
  expect state playerSound == false
  reload
  clock data
  clock settle
  expect state playerSound == false

test "A swipe up on the bar opens the full player"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  expect state player.fixture == true
  tap "play"
  clock data
  clock until state player.phase == "playing" within 10000
  clock settle
  expect tree missing "player"
  tap "bar" drag 0 -120 from 120 20
  clock data
  clock settle
  expect tree has "player"
