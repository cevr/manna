// The player sheet's tempo, stanzas' All and Start, and the key's
// recording, against the fixture recordings (tools/recordings.ts, digital
// silence): the rules are src/player/step.ts's, held to the current app's
// by src/player/clock/clock.model.test.ts and src/tempo/tempo.test.ts;
// here the element and the sheet are. A playing element runs on real
// time, so its place is checked within wide bounds after `clock +N real`;
// the silent clock runs on the test's clock. Each test opens on Settings
// and turns Sounds and haptics off before it plays (src/look/quiet.test.ts).

test "At 50 % the recording's place moves half as fast, and a turn mid-play keeps the place"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-2"
  clock settle
  clock data
  expect state player.fixture == true
  tap "play"
  clock data
  clock until state player.phase == "playing" within 10000
  tap "bar-toggle"
  clock data
  clock settle
  expect state player.phase == "paused"
  expect state player.at <= 1
  tap "bar-title"
  clock data
  clock settle
  expect tree has "dial-tempo"
  expect state player.tempo.said == "100%"
  expect state player.tempo.bpmSaid == "quarter note = 116"
  expect tree missing "tempo-reset"
  tap "dial-tempo-stop-50"
  clock data
  clock settle
  expect state player.tempo.said == "50%"
  expect state player.rate == 0.5
  expect state player.tempo.bpmSaid == "quarter note = 58"
  expect tree has "tempo-reset"
  expect state player.kept == "2@50"
  tap "toggle"
  clock data
  clock until state player.phase == "playing" within 10000
  clock +4000 real
  clock data
  expect state player.at >= 1.4
  expect state player.at <= 3.2
  tap "dial-tempo-stop-150"
  clock data
  clock settle
  expect state player.rate == 1.5
  expect state player.at >= 1.4
  expect state player.phase == "playing"
  clock +2000 real
  clock data
  expect state player.at >= 4
  tap "tempo-reset"
  clock data
  clock settle
  expect state player.tempo.said == "100%"
  expect state player.rate == 1
  expect tree missing "tempo-reset"

test "The tempo is kept through a reload"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-2"
  clock settle
  clock data
  tap "bar-sound"
  clock settle
  expect state player.fixture == true
  tap "play"
  clock data
  clock settle
  tap "bar-title"
  clock data
  clock settle
  type "dial-tempo-value" "6"
  clock data
  clock settle
  expect state playerKept == "2@80"
  reload
  clock data
  clock settle
  expect state playerKept == "2@80"

test "With Sound off at 150 % the hymn ends in two thirds of its time"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  tap "bar-sound"
  clock settle
  clock data
  expect state player.fixture == true
  tap "play"
  clock data
  clock settle
  tap "bar-title"
  clock data
  clock settle
  type "dial-tempo-value" "20"
  clock data
  clock settle
  expect state player.rate == 1.5
  expect state player.phase == "playing"
  clock +70000
  clock data
  expect state player.phase == "playing"
  clock +8000
  clock data
  expect state player.phase == "ended"

test "Intro off: Play starts at the first sung line, and Click waits on Intro"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  expect state player.fixture == true
  tap "play"
  clock data
  clock until state player.phase == "playing" within 10000
  expect state player.from <= 0
  tap "bar-title"
  clock data
  clock settle
  expect tree has "start"
  expect enabled "start-click"
  tap "start-intro"
  clock settle
  clock data
  expect state playerIntro == false
  expect disabled "start-click"
  tap "player-title"
  clock data
  clock settle
  back
  clock settle
  clock data
  tap "hymn-2"
  clock settle
  clock data
  tap "bar-page-play"
  clock data
  expect state player.number == 2
  expect state player.from >= 22.2
  expect state player.from <= 22.3
  clock until state player.phase == "playing" within 10000

test "Intro on with Sound off counts one bar of the meter's beats before the first sung line"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-2"
  clock settle
  clock data
  tap "bar-sound"
  clock settle
  clock data
  expect state playerIntro == true
  expect state player.fixture == true
  tap "play"
  clock data
  clock settle
  expect state player.count.on == true
  expect state player.count.beats == 4
  expect state player.count.beat <= 1
  expect state player.at >= 22.2
  expect state player.at <= 22.3
  clock +600
  clock data
  expect state player.count.on == true
  expect state player.count.beat >= 1
  clock +1600
  clock data
  expect state player.count.on == false
  expect state player.phase == "playing"
  expect state player.at >= 22.3

test "All returns every stanza chip"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-2"
  clock settle
  clock data
  tap "bar-sound"
  clock settle
  expect state player.fixture == true
  tap "play"
  clock data
  clock settle
  tap "bar-title"
  clock data
  clock settle
  expect tree missing "stanzas-all"
  tap "stanza-2"
  clock data
  clock settle
  expect state player.chips.1 .chosen == false
  expect tree has "stanzas-all"
  tap "stanzas-all"
  clock data
  clock settle
  expect state player.chips.0 .chosen == true
  expect state player.chips.1 .chosen == true
  expect state player.chips.2 .chosen == true
  expect tree missing "stanzas-all"

test "A key turn with chords on plays that key's recording at the place; a key with none falls back to the printed key's and says so"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-list" drag 0 -600
  clock settle
  tap "hymn-2"
  clock settle
  clock data
  tap "key-button"
  clock data
  clock settle
  expect state chordsOn == true
  expect state player.fixture == true
  tap "play"
  clock data
  clock until state player.phase == "playing" within 10000
  clock +1500 real
  clock data
  expect state player.offset == 0
  tap "key-button"
  clock data
  clock settle
  tap "dial-key-stop-4"
  clock data
  clock settle
  expect state player.offset == 2
  expect state player.fellBack == false
  expect state player.from >= 1
  clock until state player.phase == "playing" within 10000
  clock data
  expect state player.at >= 1
  tap "dial-key-stop-1"
  clock data
  clock settle
  clock until state player.fellBack == true within 10000
  clock data
  expect state player.offset == 0
  expect state player.at >= 1
  tap "dials-backdrop"
  clock settle
  tap "bar-title"
  clock data
  clock settle
  expect tree has "recording-key-fallback"
  expect text "recording-key-fallback" == "Recording in printed key. Chosen key unavailable. Play retries it."
