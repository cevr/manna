test "The bar folds and opens"
  expect tree has "tiles-show"
  expect tree has "find-search"
  expect tree has "find-number"
  expect tree missing "find-cancel"
  expect tree missing "search"
  tap "find-search"
  clock settle
  clock data
  expect tree has "search"
  expect tree has "find-cancel"
  expect tree has "find-number"
  expect tree missing "find-search"
  expect tree missing "tiles-show"
  expect state find.row == "open"
  type "search" "100"
  clock settle
  clock data
  expect tree missing "section-adoration-and-praise"
  tap "find-cancel"
  clock settle
  clock data
  expect state find.row == "folded"
  expect state listQuery == ""
  expect tree has "find-search"
  expect tree has "tiles-show"
  expect tree missing "find-cancel"
  expect tree has "section-adoration-and-praise"

// "river" finds hymn 74 by its title and hymn 530 by another of its lines
// (picked by a Bun script over the current app's `find`); only 530's row
// shows the line, under its title, the row taller than a title's alone.
test "A hymn found by a line shows that line"
  tap "find-search"
  clock settle
  clock data
  type "search" "river"
  clock settle
  clock data
  expect tree has "hymn-74"
  expect tree missing "row-line-74"
  expect tree has "hymn-530"
  expect tree has "row-line-530"
  expect state listRows.0 .rows.0 .line == ""
  expect state listRows.0 .slug == "found"

test "The box clears while it has words"
  tap "find-search"
  clock settle
  clock data
  expect focused "search"
  expect tree missing "find-clear"
  type "search" "zzqx"
  clock settle
  clock data
  expect tree has "find-clear"
  expect tree has "none-found"
  tap "find-clear"
  clock settle
  clock data
  expect state listQuery == ""
  expect state find.query == ""
  expect state find.row == "open"
  expect focused "search"
  expect tree missing "find-clear"
  expect tree has "find-cancel"
  type "search" "zzqx"
  clock settle
  clock data
  expect tree has "find-clear"
  tap "find-number"
  clock settle
  clock data
  expect state find.drums == true
  expect state listQuery == "zzqx"
  expect tree missing "find-clear"

test "A hymn by its number"
  tap "find-number"
  clock settle
  clock data
  expect tree has "drums"
  expect state find.drums == true
  type "drum-hundreds" "3"
  clock data
  type "drum-tens" "4"
  clock data
  type "drum-ones" "5"
  clock data
  expect text "drums-number" == "345"
  tap "drums-open"
  clock settle
  clock data
  expect state find.drums == false
  expect text "hymn-title" == "Christ Is the World's True Light"
  back
  clock settle
  expect text "title" == "Hymns"
  expect tree missing "hymn-title"

test "The drums hold to the book"
  tap "find-number"
  clock settle
  clock data
  type "drum-hundreds" "6"
  clock data
  type "drum-tens" "9"
  clock data
  type "drum-ones" "9"
  clock data
  expect text "drums-number" == "695"
  type "drum-hundreds" "7"
  clock data
  expect state find.hundreds == 6
  expect text "drums-number" == "695"
  type "drum-ones" "10"
  clock data
  expect state find.ones == 0
  expect text "drums-number" == "690"

// Outside the panel is `drums-outside`, the window-wide box beneath it. The
// touch lands 200 down, below iOS's status bar, which takes a touch at its
// top left before the app's window sees it.
test "A tap outside closes the drums and opens nothing"
  tap "find-number"
  clock settle
  clock data
  expect state find.drums == true
  tap "drums-outside" drag 0 0 from 20 200
  clock settle
  clock data
  expect state find.drums == false
  expect state findDrumsUp == false
  expect text "title" == "Hymns"
  expect tree missing "hymn-title"
  expect state find.go.serial == 0

// One tile a group of the tab in use, as the current app's All at once:
// its name, its count, its first row where its tap lands; no number tile.
test "All at once"
  perf
    tap "tab-topics"
    clock settle
    clock data
  expect perf query findTileGroups == 0
  expect state findTilesAsked == false
  expect state find.top == "/"
  expect state find.tilesControl == true
  tap "tiles-show"
  clock settle
  clock data
  expect tree has "tiles"
  expect text "tiles-heading" == "Topics, all at once"
  expect tree has "group-tile-0"
  expect tree has "group-tile-3"
  expect tree missing "tile-1"
  expect tree missing "tile-100"
  expect text "group-tile-count-1" == "5 hymns"
  expect state findTileGroups.1 .row == "hymn-258"
  expect state findTileGroups.0 .playing == false
  expect state find.row == "tiles"
  expect tree missing "find-search"
  tap "group-tile-1"
  clock settle
  clock data
  expect tree missing "tiles"
  expect state find.row == "folded"
  expect state findLanding == ""
  expect state listTab == "Topics"
  expect tree has "hymn-258"
  expect tree missing "hymn-title"
  tap "tiles-show"
  clock settle
  clock data
  expect tree has "tiles"
  perf
    tap "tiles-done"
    clock settle
    clock data
  expect perf built "HymnRow" == 0
  expect tree missing "tiles"
  expect state listTab == "Topics"
  expect tree has "group-adoration-and-praise"

test "The tiles are the Sections' groups, the playing one marked"
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  expect state player.fixture == true
  tap "play"
  clock data
  clock settle
  expect state player.number == 1
  back
  clock settle
  clock data
  tap "tiles-show"
  clock settle
  clock data
  expect text "tiles-heading" == "Sections, all at once"
  expect text "group-tile-count-0" == "38 hymns"
  expect state findTileGroups.0 .row == "hymn-1"
  expect state findTileGroups.0 .playing == true
  expect state findTileGroups.1 .playing == false
  tap "group-tile-3"
  clock settle
  clock data
  expect tree missing "tiles"
  expect tree has "hymn-59"

// While the drums are open at home on a number, the list follows it to
// that hymn's first row; the row the list scrolls to is `findFollowing`.
test "The home list follows the drums"
  tap "find-number"
  clock settle
  clock data
  type "drum-hundreds" "3"
  clock data
  clock settle
  expect state findFollowed == 300
  expect state findFollowing.row == "hymn-300"
  type "drum-tens" "4"
  clock data
  clock settle
  expect state findFollowing.row == "hymn-340"
  tap "drums-hash"
  clock settle
  clock data
  expect state findFollowed == 0
  tap "tab-lists"
  clock settle
  clock data
  tap "find-number"
  clock settle
  clock data
  type "drum-hundreds" "2"
  clock data
  clock settle
  expect state findFollowing.row == ""

test "On a hymn's page a found hymn takes its place"
  at "/hymns/2"
  clock data
  expect text "hymn-title" == "All Creatures of Our God and King"
  expect tree has "find-search"
  expect tree missing "tiles-show"
  tap "find-number"
  clock settle
  clock data
  type "drum-hundreds" "1"
  clock data
  expect text "drums-number" == "100"
  tap "drums-open"
  clock settle
  clock data
  expect text "hymn-title" == "Great Is Thy Faithfulness"
  expect state recentList.0 == 100
  expect state recentList.1 == 2
  back
  clock settle
  expect text "title" == "Hymns"
  expect tree missing "hymn-title"
  tap "hymn-2"
  clock settle
  clock data
  tap "find-search"
  clock settle
  clock data
  type "search" "100"
  clock settle
  clock data
  expect tree has "find-list"
  tap "hymn-100"
  clock settle
  clock data
  expect text "hymn-title" == "Great Is Thy Faithfulness"
  expect tree missing "find-list"
  expect state recentList.0 == 100
  back
  clock settle
  clock data
  expect text "title" == "Hymns"
  expect tree missing "hymn-title"
  expect state find.row == "folded"
  expect state find.query == ""
  expect tree has "section-adoration-and-praise"
  expect tree has "hymn-1"

test "On Recent the bar stands too"
  tap "hymn-2"
  clock settle
  clock data
  back
  clock settle
  tap "recent-all"
  clock settle
  clock data
  expect text "recent-title" == "Recent"
  expect tree has "find-search"
  expect tree has "find-number"
  expect tree missing "tiles-show"
  tap "find-search"
  clock settle
  clock data
  type "search" "100"
  clock settle
  clock data
  expect tree has "find-list"
  tap "hymn-100"
  clock settle
  clock data
  expect text "hymn-title" == "Great Is Thy Faithfulness"
  back
  clock settle
  clock data
  expect text "recent-title" == "Recent"
  expect tree has "find-list"
  tap "find-cancel"
  clock settle
  clock data
  expect tree missing "find-list"
  expect tree has "recent-2"
  tap "find-search"
  clock settle
  clock data
  type "search" "100"
  clock settle
  clock data
  expect tree has "find-list"
  back
  clock settle
  clock data
  expect text "title" == "Hymns"
  expect state find.row == "folded"
  expect state find.query == ""
  expect tree has "section-adoration-and-praise"
  expect tree has "hymn-1"
