// Chords: off at first and kept across launches (`chordsOn`, Settings'
// `ChordsRow`). On, a hymn's page draws each chord over the syllable it
// changes on, in the key the hymn's move reaches, and names the key played
// and the key sounding; the move (a transpose and a capo) is the hymn's own
// and kept (`chordsMoves`, src/chords/move.ts). A tap on a chord opens its
// shape, a chord box, over the page (`/hymns/:n/chord/:grip`). The rules
// are src/chords/**: the page's chords (page.ts), the line rule (rows.ts:
// a line is a wrapping row of words, a word a wrapping row of pairs, a pair
// its chord over its syllable, so a break falls between pairs, never
// inside one) and the shapes (shape.ts).
use hy-fade-in from "./motion.contract"

shape ChordsBox
  text: string
  chord: string
  grip: string

shape ChordsWord
  at: number
  boxes: ChordsBox[]

shape ChordsLine
  at: number
  words: ChordsWord[]

shape ChordsPart
  key: string
  label: string
  text: string
  lines: ChordsLine[]

shape ChordsPage
  number: number
  kind: string
  played: string
  sounding: string
  code: string
  transpose: number
  capo: number
  capoDown: bool
  capoUp: bool
  parts: ChordsPart[]

shape ChordsMoves
  moves: string[]

shape ChordsMark
  x: number
  text: string

shape ChordsDot
  x: number
  y: number
  finger: number

shape ChordsBarre
  x: number
  y: number
  width: number
  finger: number

shape ChordsGripBox
  name: string
  frets: string
  fingers: string
  playedAs: string
  first: number
  firstLabel: string
  nut: bool
  stringsX: number[]
  fretsY: number[]
  left: number
  right: number
  top: number
  bottom: number
  marks: ChordsMark[]
  dots: ChordsDot[]
  barres: ChordsBarre[]

shape ChordsGripPage
  has: bool
  name: string
  width: number
  height: number
  dot: number
  boxes: ChordsGripBox[]

members HymnalExact
  state chordsOn = false persist
  state chordsMoves: string[] = [] persist
  resource chordsShown = chordsPage(hymnOpen, chordsOn, chordsMoves) as shape ChordsPage
  mutation chordsMoved as shape ChordsMoves queue then chordsKeep
  derive chordsGripOpen = match stack(nav).filter(e => e.name == "chord").at(-1) { case some(e) => e.params.grip, case none => "" }
  resource chordsGripShown = chordsGrip(chordsGripOpen) as shape ChordsGripPage
  action chordsSet(on: bool)
    if settingsFeel
      haptic("impact-light")
    chordsOn = on
  action chordsStep(n: number, step: string)
    if settingsFeel
      haptic("selection")
    send chordsMoved = chordsMove(chordsMoves, n, step)
  action chordsKeep
    match chordsMoved
      case some(m)
        chordsMoves = m.moves
      case none
        chordsMoves = chordsMoves
  action chordsGripClose
    nav = back(nav)

// Settings' row: chords on or off, for every hymn. One call line in the
// Settings sheet's list, through the root's `chordsSwitchOn` and
// `chordsSwitch`.
component ChordsRow
  inject
    chordsSwitchOn: bool
    chordsSwitch: action
  view
    section
      header
        text "Chords"
      row
        text "Chords" flex=1 min-width=0
        input type="checkbox" switch checked=chordsSwitchOn change=chordsSwitch aria-label="Chords" testId="chords-toggle"

// Over a hymn's chords: the key sounding and its transpose, the capo and
// the key played under it. The key wraps through the twelve; the capo stops
// at 0 and 11.
component ChordsKeys
  props
    chords: ChordsPage
    number: number
  inject
    chordsPress: action
  view
    if chords.kind == "chords" and chords.number == number
      column gap=12 testId="chords-keys"
        column gap=2
          text "Key" color="-exact-secondary-label"
          row align-items="center" gap=12
            text chords.sounding font="-exact-headline" flex=1 min-width=0 testId="key-sounding"
            button press=chordsPress(chords.number, "down") aria-label="Key down" testId="transpose-down"
              image "symbol:minus"
            button press=chordsPress(chords.number, "up") aria-label="Key up" testId="transpose-up"
              image "symbol:add"
        column gap=2
          text (chords.capo == 0 ? "No capo, played in" : `Capo ${chords.capo}, played in`) color="-exact-secondary-label" testId="capo"
          row align-items="center" gap=12
            text chords.played font="-exact-headline" flex=1 min-width=0 testId="key-played"
            button press=chordsPress(chords.number, "capo-down") disabled=(not chords.capoDown) aria-label="Capo down" testId="capo-down"
              image "symbol:minus"
            button press=chordsPress(chords.number, "capo-up") disabled=(not chords.capoUp) aria-label="Capo up" testId="capo-up"
              image "symbol:add"
    if chords.kind == "none" and chords.number == number
      text "No chords for this hymn yet." font="-exact-footnote" color="-exact-secondary-label" testId="no-chords"

// A section's lines under their chords: each line a wrapping row of words,
// each word a wrapping row of pairs, each pair its chord (a link to its
// shape, or a blank as tall) over its syllable, their left edges together.
component ChordsLines
  props
    chords: ChordsPage
    k: number
    part: ChordsPart
  inject
    motionStill: bool
  view
    column gap=6
      for l in part.lines key=l.at
        row flex-wrap="wrap" column-gap="0.35em" row-gap=4 testId=`line-${k}-${l.at}`
          for w in l.words key=w.at
            row flex-wrap="wrap"
              for b, bi in w.boxes key=bi
                column align-items="flex-start" testId=`pair-${k}-${l.at}-${w.at + bi}`
                  if b.chord == ""
                    text " " aria-hidden=true
                  else
                    if b.grip == ""
                      text b.chord color="chord" padding-right="0.3em" testId=`chord-${k}-${l.at}-${w.at + bi}`
                        animation=(motionStill ? "hy-fade-in duration.fade easing.out both" : "hy-fade-in duration.fade easing.out both")
                    else
                      link href=path("chord", `${chords.number}`, `${chords.code}_${b.grip}`) aria-label=`${b.chord}, shows how to play it` testId=`chord-${k}-${l.at}-${w.at + bi}`
                        animation=(motionStill ? "hy-fade-in duration.fade easing.out both" : "hy-fade-in duration.fade easing.out both")
                        text b.chord color="chord" padding-right="0.3em"
                  text b.text testId=`syllable-${k}-${l.at}-${w.at + bi}`

// A chord's shape over the page: each chord a box, its strings down from
// the low E, the frets across (an SVG), the marks over the nut, and each
// finger a filled dot (a barre a filled bar) with its number, under its name.
component ChordsGripScreen
  props
    entry: Entry
    page: ChordsGripPage
    ready: bool
    done: action
  view
    column navigationKey=`${entry.id}` navigationPresentation="modal" navigationScroll="shape-scroll" position="absolute" inset=0
      header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
        text (not ready ? "" : page.has ? page.name : "No shape") role="heading" aria-level=2 testId="shape-name"
        button press=done testId="shape-done"
          text "Done"
      scroll id="shape-scroll" flex=1 min-height=0
        column align-items="center" gap=24 padding=24
          for b, bi in page.boxes key=bi
            column align-items="center" gap=8
              text (b.playedAs == "" ? b.name : `${b.name}, played as ${b.playedAs}`) font="-exact-headline"
              view position="relative" width=page.width height=page.height role="img" aria-label=`${b.name}: ${b.frets}` testId=(bi == 0 ? "shape" : `shape-${bi}`)
                svg position="absolute" left=0 top=0 width=page.width height=page.height viewBox=`0 0 ${page.width} ${page.height}` color="-exact-label"
                  for x in b.stringsX key=x
                    line x1=x y1=b.top x2=x y2=b.bottom stroke="currentColor" stroke-width=1
                  for y, fi in b.fretsY key=fi
                    line x1=b.left y1=y x2=b.right y2=y stroke="currentColor" stroke-width=(fi == 0 and b.nut ? 4 : 1)
                for m, mi in b.marks key=mi
                  text m.text position="absolute" left=(m.x - page.dot / 2) top=0 width=page.dot text-align="center" font-size="min(-exact-footnote, 13px)" testId=`shape-${bi}-mark-${mi}`
                for d, di in b.dots key=di
                  text `${d.finger}` position="absolute" left=(d.x - page.dot / 2) top=(d.y - page.dot / 2) width=page.dot height=page.dot border-radius=(page.dot / 2) background-color="-exact-label" line-height=`${page.dot}px` text-align="center" font-size="min(-exact-caption2, 11px)" font-weight=700 color="-exact-background" testId=`shape-${bi}-dot-${di}`
                for r, ri in b.barres key=ri
                  text `${r.finger}` position="absolute" left=r.x top=r.y width=r.width height=page.dot border-radius=(page.dot / 2) background-color="-exact-label" line-height=`${page.dot}px` text-align="center" font-size="min(-exact-caption2, 11px)" font-weight=700 color="-exact-background" testId=`shape-${bi}-barre-${ri}`
                if b.firstLabel != ""
                  text b.firstLabel position="absolute" left=0 top=b.top width=(b.left - 8) text-align="right" font-size="min(-exact-caption1, 12px)" color="-exact-secondary-label" testId=(bi == 0 ? "shape-first" : `shape-first-${bi}`)
