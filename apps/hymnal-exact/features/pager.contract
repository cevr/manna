// The hymn pager, as the current app's (apps/hymnal/src/reader/
// HymnScreen.native.tsx, pager.ts): a hymn's page lies between the hymn
// before and the hymn after, and a swipe left or right turns to one. It
// moves through the list the reader pressed the hymn's row in (home's
// Sections list in its order, a search's results in the order shown, the
// Recent screen), else through every hymn in number order (a link, the bar,
// a dialled number, another home tab, as the current app's `groupRowsOf`);
// the ends do not wrap. Where the reader came from is `pagerFrom`, taken
// when a hymn's route comes to the top (`pagerTake`), and not kept across
// launches. The route follows the page the pager settles on, in place
// (`replace`), so Back returns to the list in one step; a neighbour sets
// nothing until it is the page shown. The pages drawn are `pagerNumbers`:
// the hymn and one each side (app.ts `pagerAround`, src/pager/pager.ts),
// each page's words asked by itself (`pagerPages`, keyed by its number),
// so the page swiped to keeps its words, and its chords, as it becomes the
// route's.
use HymnText from "./hymn.contract"
use ChordsPage from "./chords.contract"
use findSearchingAt from "./find.contract"

shape PagerAround
  number: number
  numbers: number[]

shape PagerSettle
  number: number

members HymnalExact
  state pagerFrom: number[] = []
  state pagerHymnId = -1
  state pagerHymnUrl = ""
  state pagerPrevTop = -1
  state pagerFindSeen = 0
  state pagerPlayerSeen = 0
  state pagerTurned = ""
  state pagerX = 0
  state pagerWidth = 0
  state pagerDragging = false
  resource pagerNear = pagerAround(hymnOpen, pagerFrom) when hymnOpen != "" as shape PagerAround else empty()
  derive pagerWanted = hymnOpen == "" ? [] : (`${pagerNear.number}` == hymnOpen ? pagerNear.numbers : (pagerNumbers.map(n => `${n}`).includes(hymnOpen) ? pagerNumbers : match parseNumber(hymnOpen) { case some(n) => [n], case none => [] }))
  state pagerNumbers: number[] = []
  // The pages drawn change only here, in one commit with the scroll that
  // keeps the route's page in view: the web's scroller does not follow a
  // page that moves under it, so a page put before it would show for a
  // frame.
  task pagerPlace key=`${hymnOpen} ${pagerNear.number} ${pagerNear.numbers.map(n => `${n}`).join(",")}`
    change(pagerPlaced)
  action pagerPlaced
    pagerNumbers = pagerWanted
    if pagerWanted.length > 1 and pagerWanted.map(n => `${n}`).includes(hymnOpen)
      scrollIntoView(`hymn-page-${hymnOpen}`, block="nearest", inline="start", behavior="instant")
  resource pagerPages = hymnPage(`${n}`) for n in pagerNumbers as shape HymnText
  resource pagerChords = chordsPage(`${n}`, chordsOn, chordsMoves, settingsChordStyle, settingsPlacement, sheetPlacements) for n in pagerNumbers as shape ChordsPage
  mutation pagerSettled as shape PagerSettle queue then pagerTurn
  // What the screen on top lists, in the order shown, while it is on top:
  // a search's results, home's Sections list, the Recent screen; none for
  // another home tab, which pages every hymn as the current app's does. A
  // hymn's own page lists only a search's results. Kept as it was when the
  // reader pressed a row, since a hymn opened changes Recent and closes the
  // search after.
  state pagerShowing: number[] = []
  state pagerShowingAt = ""
  derive pagerRowsKey = listRows.map(s => s.rows.map(r => `${r.number}`).join(",")).join(";")
  task pagerShow key=`${top(nav).id} ${top(nav).url} ${listTab} ${find.results} ${find.searchAt} ${pagerRowsKey} ${recentShown.all.map(r => `${r.number}`).join(",")}`
    change(pagerShown)
  action pagerShown
    let t = top(nav)
    if find.results and findSearchingAt(find, t.url)
      pagerShowing = listRows.map(s => s.rows.map(r => r.number)).flat()
      pagerShowingAt = `${t.id} ${t.url}`
    else if t.name == "list"
      pagerShowing = listTab == "Sections" ? listRows.map(s => s.rows.map(r => r.number)).flat() : []
      pagerShowingAt = `${t.id} ${t.url}`
    else if t.name == "recent"
      pagerShowing = recentShown.all.map(r => r.number)
      pagerShowingAt = `${t.id} ${t.url}`
    else if t.name != "hymn"
      pagerShowing = []
      pagerShowingAt = `${t.id} ${t.url}`
  // A hymn's route at the top: where the reader opened it from, what the
  // screen it was pressed on listed then (`pagerShowing`), if that screen
  // was the one on top just before. The same entry back on top (a sheet
  // over it closed) or moved by the pager keeps what it had; a hymn dialled
  // or opened from the bar takes none.
  task pagerTake key=`${top(nav).id} ${top(nav).url}`
    change(pagerTook)
  action pagerTook
    let t = top(nav)
    if t.name == "hymn"
      let byFind = findGone > pagerFindSeen and find.go.path == t.url
      let byPlayer = playerGone > pagerPlayerSeen and player.go.path == t.url
      if t.id == pagerHymnId and (t.url == pagerHymnUrl or t.url == pagerTurned)
        pagerFrom = pagerFrom
      else if byFind or byPlayer
        pagerFrom = []
      else if t.id == pagerHymnId
        pagerFrom = pagerShowingAt == `${t.id} ${pagerHymnUrl}` ? pagerShowing : []
      else
        match stack(nav).at(-2)
          case some(b)
            pagerFrom = (b.id == pagerPrevTop and pagerShowingAt == `${b.id} ${b.url}`) ? pagerShowing : []
          case none
            pagerFrom = []
      pagerHymnId = t.id
      pagerHymnUrl = t.url
    pagerPrevTop = t.id
    pagerFindSeen = findGone
    pagerPlayerSeen = playerGone
  // Once a scroll rests, the pager's offset as laid out then: how far its
  // first page lies left of its port. A page's own scroll, up and down,
  // ends here too and settles where the pager already stands.
  // Only the reader turns a page: a scroll armed by a drag of the pager (a
  // finger, UIKit's pan) or a wheel's (a trackpad), never one the host or
  // the app makes, as the scroll back to a path's start after a `replace`
  // or the scroll that keeps the shown page in view. A scroll that rests
  // with no gesture armed and the shown page away from the port (a
  // screenshot that lays the page out beyond the viewport, a find in the
  // page) puts the shown page back: the route in state is the pager's
  // truth, never the scroller's offset.
  // A wheel arms a turn only when it goes more sideways than up or down,
  // toward a page drawn beside the shown one: a page's own scroll, a
  // diagonal one mostly down among them, and a wheel past the pager's end
  // leave no arm for a later scroll that no gesture made.
  action pagerArmed
    pagerDragging = true
  action pagerWheeled(e: WheelEvent)
    let at = pagerNumbers.map(n => `${n}`).indexOf(hymnOpen)
    if max(e.deltaX, 0 - e.deltaX) > max(e.deltaY, 0 - e.deltaY) and ((e.deltaX > 0 and at >= 0 and at < pagerNumbers.length - 1) or (e.deltaX < 0 and at > 0))
      pagerDragging = true
  action pagerEnded
    match (pagerDragging ? pagerNumbers.at(0) : none)
      case some(first)
        pagerDragging = false
        let port = frame("hymn-pager")
        let offset = port.x - frame(`hymn-page-${first}`).x
        pagerX = offset
        pagerWidth = port.width
        send pagerSettled = pagerSettle(pagerNumbers, offset, port.width)
      case none
        if pagerNumbers.length > 1 and pagerNumbers.map(n => `${n}`).includes(hymnOpen) and max(frame(`hymn-page-${hymnOpen}`).x - frame("hymn-pager").x, frame("hymn-pager").x - frame(`hymn-page-${hymnOpen}`).x) >= 1
          scrollIntoView(`hymn-page-${hymnOpen}`, block="nearest", inline="start", behavior="instant")
  // The route moves to the page settled on, in place. A `replace` to
  // another path scrolls each of the route's scrollers to its start (the
  // web host's `freshPath`, LLP 1116.005 D3), so the pages before the one
  // settled on go in the same commit: it stands first, where the scroll
  // goes, and the hymn before comes back with `pagerNear`'s answer.
  action pagerTurn
    match pagerSettled
      case some(s)
        if s.number > 0 and `${s.number}` != hymnOpen and top(nav).name == "hymn"
          pagerNumbers = pagerNumbers.slice(max(pagerNumbers.indexOf(s.number), 0))
          pagerTurned = path("hymn", `${s.number}`)
          nav = replace(nav, path("hymn", `${s.number}`))
      case none
        nav = nav
