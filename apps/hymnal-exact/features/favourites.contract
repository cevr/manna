// Favourites: the hymns the reader starred, in number order, kept across
// launches. The star in a hymn page's header adds the hymn or takes it out
// (`favouritesAfter`, the current app's `toggleFavourite`); each row that
// shows a favourite carries a star, and the Lists tab's Favourites group
// holds them.

shape FavouriteList
  numbers: number[]

members HymnalExact
  state favouriteList: number[] = [] persist
  mutation favouriteToggled as shape FavouriteList queue then favouriteKeep
  action favouriteToggle(n: number)
    send favouriteToggled = favouritesAfter(favouriteList, n)
  action favouriteKeep
    match favouriteToggled
      case some(f)
        if settingsFeel
          if f.numbers.length > favouriteList.length
            haptic("success")
          else if f.numbers.length < favouriteList.length
            haptic("impact-light")
        favouriteList = f.numbers
      case none
        favouriteList = favouriteList

// The star at the end of a hymn's title row, as the current app's
// `FavouriteButton` draws it: the star (the SF Symbol `star` on Apple), filled while the hymn is
// a favourite, in the accent, fitted in its mark's box at the centre of a
// round target that reaches past the row above and below; pressed, the
// target takes the soft fill.
component FavouriteStar
  props
    number: number
    tag: string
  inject
    favouriteNumbers: number[]
    favouritePress: action
  view
    if number > 0
      view role="button" press=favouritePress(number) aria-label="Favourite" aria-pressed=favouriteNumbers.includes(number) testId=`favourite${tag}`
        display="flex" align-items="center" justify-content="center" align-self="flex-start" margin-left="auto"
        margin-top="calc(space.s8 * -1)" margin-bottom="calc(space.s8 * -1)" min-width="size.target" min-height="size.target" border-radius="radius.pill"
        :active
          background-color = "soft"
        image (favouriteNumbers.includes(number) ? "symbol:star-fill" : "symbol:star") width="size.mark" height="size.mark" object-fit="contain" color="accent" aria-hidden=true
