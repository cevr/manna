// Finding a hymn: the find bar on every screen where the `#` stands (home,
// Recent, a hymn's page), the drums that dial a hymn by its number (the
// home list follows them), and All at once, the home list's groups as
// tiles. Every rule is `step` in
// src/find/step.ts, answered by `findStep` (src/find/sources.ts); this file
// draws its view and turns presses into calls. A found hymn goes where the
// step says (`go`, taken once by its serial); the drums are a dialog the
// step's `drums` opens and closes, and a tap outside it closes them and
// fires nothing else. The search box's text is `listQuery`; the rows found
// follow the step's `query` (features/list.contract `listRows`), which is
// empty once the search closes, wherever it was open.
use PlayerView from "./player.contract"
use hy-fade-in, hy-fade-out from "./motion.contract"

shape ListRow
  number: number
  title: string

// A row of the list's answer (src/list/rows.ts): a search's carries the
// line it found the hymn by, "" with none, as every other row has.
shape SectionRow
  number: number
  title: string
  line: string

shape RowSection
  slug: string
  name: string
  rows: SectionRow[]

shape FindGo
  serial: number
  how: string
  path: string

// A stretch of a tile's strip, as fractions of its width from hymn 1.
shape FindSpan
  start: number
  end: number

// A group's tile in All at once (`findGroupTiles`, src/find/tiles.ts):
// its name, its count as said, its VoiceOver name, its strip, whether it
// holds the player's hymn, and the id of the group's first row in the
// home list, where its tap lands.
shape FindTile
  index: number
  name: string
  count: string
  label: string
  spans: FindSpan[]
  playing: bool
  row: string

// The home list's row the drums' number scrolls to, "" with none
// (`findFollowRow`, src/find/follow.ts).
shape FindFollow
  row: string

// The hymns about a search's query, nearest first, and the query they were
// asked for (`findAbout`, src/results/table.ts): the list shows them only
// under that query's matches.
shape FindAbout
  query: string
  numbers: number[]

// The id of the box at a point, "" with none.
fn findIdOf(at: option<string>): string = match at { case some(id) => id, case none => "" }

// The pinch's reports after a serial, `;`-joined, and the serial so far
// (`findPinchTake`, src/pinch/sources.ts).
shape FindPinch
  serial: number
  run: string

// The tile of the group at the home list's top (`findTileAt`, src/find/tiles.ts).
shape FindAim
  index: number

shape FindView
  serial: number
  top: string
  row: string
  chosen: string
  searchDrawn: bool
  searchReach: bool
  boxDrawn: bool
  boxReach: bool
  cancelDrawn: bool
  cancelReach: bool
  hashReach: bool
  tilesControl: bool
  searchAt: string
  query: string
  results: bool
  drums: bool
  number: number
  hundreds: number
  tens: number
  ones: number
  tiles: bool
  homeTiles: bool
  pinchable: bool
  go: FindGo

// Whether the search is on at the screen of `url`: the step names a screen
// by its path, without the query or fragment a launch may add.
fn findSearchingAt(v: FindView, url: string): bool = url == v.searchAt or url.startsWith(`${v.searchAt}?`) or url.startsWith(`${v.searchAt}#`)

// The drums pop in from a little smaller, a panel over the page.
keyframes hy-pop
  from opacity=0 scale=0.96

// The tiles grow in from a little larger, and fade out a little larger
// again (the current AllAtOnce's zoom).
keyframes hy-zoom-in
  from opacity=0 scale=1.06

keyframes hy-zoom-out
  to opacity=0 scale=1.06

members HymnalExact
  state findGone = 0
  state findDrumsUp = false
  state findTilesAsked = false
  derive findPaths = stack(nav).map(e => e.url).join(" ")
  derive findTopId = top(nav).id
  resource findOnScreen = findStep("screen", findPaths, 0, 0) as shape FindView
  mutation findStepped as shape FindView queue then findTook
  derive find = match findStepped { case some(v) => (v.serial >= findOnScreen.serial ? v : findOnScreen), case none => findOnScreen }
  resource findTileGroups = findGroupTiles(listTab, listTab == "Lists" ? favouriteList : [], listTab == "Lists" ? recentList : [], player.number) when findTilesAsked as shape FindTile[] else empty()
  state findLanding = ""
  state findFollowed = 0
  mutation findFollowing as shape FindFollow queue then findFollow
  // The current app's search mode asks for the hymns about its query once
  // it has stood `PAUSE` (150 ms, src/hymns/meaning.ts) after the last key.
  state findAsked = ""
  resource findAboutNow = findAbout(findAsked) as shape FindAbout else empty()
  task findPause when find.query != findAsked key=find.query
    after(150, findAskAbout)
  action findAskAbout
    findAsked = find.query
  // The tiles open at the group at the list's top (the current app's
  // AllAtOnce `at`): as they are asked for, the box at the list's top
  // edge (its pinned header, a row, or its head) names the group, and once
  // they show they scroll its tile to their first row.
  state findAim = -1
  mutation findAiming as shape FindAim queue then findAimed
  action findAimAtTop
    let list = frame("hymn-list")
    let x = list.x + list.width / 2
    if not find.homeTiles and not list.unavailable
      send findAiming = findTileAt(listTab, [findIdOf(elementFromPoint(x, list.y + 2)), findIdOf(elementFromPoint(x, list.y + 60)), findIdOf(elementFromPoint(x, list.y + 120)), findIdOf(elementFromPoint(x, list.y + 180))], listTab == "Lists" ? favouriteList : [], listTab == "Lists" ? recentList : [])
  action findAimed
    match findAiming
      case some(a)
        findAim = a.index
      case none
        findAim = findAim
  task findTilesAim when find.homeTiles and findAim >= 0 and findTileGroups.length > findAim key=findAim
    after(1, findTilesAimed)
  action findTilesAimed
    scrollIntoView(`group-tile-${findAim}`, block="start", behavior="instant")
    findAim = -1
  action findAsk(kind: string, n: number)
    if kind == "tilesShow"
      findAimAtTop()
    send findStepped = findStep(kind, "", n, 0)
  action findSearch
    listQuery = ""
    send findStepped = findStep("searchOn", "", 0, 0)
  action findCancel
    listQuery = ""
    send findStepped = findStep("searchOff", "", 0, 0)
  action findType(v: string)
    listQuery = v
    send findStepped = findStep("query", v, 0, 0)
  action findTurn(drum: string, n: number)
    if settingsFeel
      haptic("selection")
    send findStepped = findStep("turn", drum, n, 0)
  action findWheeled(e: WheelEvent)
    if e.ctrlKey
      preventDefault()
      findAimAtTop()
      send findStepped = findStep("wheel", "", e.deltaY, 0)
  // Two fingers on the home list or its tiles, as the current app's
  // home/pinch.ts: the `pinch` hatch on the list's column
  // (features/list.contract, on while `pinchable`) reports each gesture
  // through the app's module (modules/apple/Pinch.swift,
  // modules/web/index.js), and each run of reports goes to the step, which
  // shows or closes the tiles at most once a gesture (`pinched`,
  // src/find/step.ts).
  state findPinchSeen = 0
  resource findPinchHeard = findPinchTake(findPinchSeen) as shape FindPinch else empty()
  task findPinches when findPinchHeard.serial > findPinchSeen key=findPinchHeard.serial
    after(1, findPinched)
  action findPinched
    if findPinchHeard.serial > findPinchSeen
      findPinchSeen = findPinchHeard.serial
      findAimAtTop()
      send findStepped = findStep("pinchRun", findPinchHeard.run, 0, 0)
  action findTilePick(row: string)
    findLanding = row
    send findStepped = findStep("tilesDone", "", 0, 0)
  action findTook
    if find.homeTiles
      findTilesAsked = true
    else if findLanding != ""
      findLanding = ""
      scrollIntoView(findLanding, block="start", behavior="instant")
    if find.drums and find.top == "/" and find.query == "" and not find.homeTiles and find.number != findFollowed
      findFollowed = find.number
      send findFollowing = findFollowRow(listTab, find.number, listTab == "Lists" ? favouriteList : [], listTab == "Lists" ? recentList : [])
    else if not find.drums
      findFollowed = 0
    if find.drums and not findDrumsUp
      findDrumsUp = true
      showModal("find-drums")
    else if findDrumsUp and not find.drums
      findDrumsUp = false
    if find.go.serial > findGone
      findGone = find.go.serial
      if find.go.how == "push"
        nav = push(nav, find.go.path)
      else if find.go.how == "replace"
        nav = replace(nav, find.go.path)
  action findFollow
    match findFollowing
      case some(f)
        if f.row != "" and find.drums
          scrollIntoView(f.row, block="start", behavior="instant")
      case none
        findFollowed = findFollowed
  action findDismissed
    findDrumsUp = false
    send findStepped = findStep("drumsClose", "", 0, 0)
  action findDrumsKeyed(k: string)
    if k == "Escape"
      preventDefault()
      send findStepped = findStep("drumsClose", "", 0, 0)

// The device's facts the bar is placed by: the software keyboard's height
// over the window's foot and the safe area's insets, in points.
shape FindPort
  keyboardHeight: number
  safeAreaTop: number
  safeAreaBottom: number

// The current app's measures of the bar and the drums, and a list's end
// room, in points (`findPlaces`, src/find/sources.ts, as One's bar.ts,
// dial.ts, DialPanel.tsx and reader/end.ts hold them).
shape FindPlaces
  hash: number
  gap: number
  lift: number
  rest: number
  detent: number
  pad: number
  rowGap: number
  end: number

// How far the bar's foot stands over the screen's, as the current app's
// bar stands (`findRoom`): just over the keyboard while it is up (the
// screen then ends at the keys), over the player's resting bar while it
// docks, and else docked just over the bottom inset.
fn findFoot(port: FindPort, at: FindPlaces, overBar: bool, rise: number): number = port.keyboardHeight > 0 ? at.gap : (overBar ? port.safeAreaBottom + at.rest + rise + at.gap : port.safeAreaBottom + at.lift)

// The find bar of the screen `entry` draws, shown while that screen is on
// top, drawn as the current app's (src/home/FindBar.tsx): a capsule of
// glass at the screen's foot, at its right edge, holding Search's
// magnifier and the `#`. Searching here, the capsule grows leftward into
// the search box, the chosen mark (a disk in `glassChosen`) behind its
// magnifier, the `#` keeps its trailing end, and Cancel stands at the
// bar's right in the accent; while the drums are open the mark lies
// behind the `#`; on the tiles the `#` stands alone on its own disk. All
// at once (the port's way to the tiles where a pinch cannot reach, owner
// q148 and q164) is a third control in the folded capsule, before Search,
// sized as Search and the `#` are. With `results`, while a
// search here has words its ground covers the screen from under the status
// bar, as the current app's results do, and lists the hymns found; with no
// words yet the screen stays in view (home's Recent still answers a tap).
// The bar's own box lets taps through to the page beside its disks.
// While the box holds the focus and has words, the clear button stands at
// its trailing end where UIKit's (`clearButtonMode="while-editing"`) stands,
// the caret in the blue UIKit draws One's field's in; a press there keeps
// the focus in the box (no `tabindex`, so the button takes none) and
// empties it.
component FindBar
  props
    entry: Entry
    results: bool
  inject
    findShown: FindView
    findPress: action
    findSearchOn: action
    findSearchOff: action
    findTyped: action
    findText: string
    findTop: number
    findRows: RowSection[]
    findOpen: action
    favouriteNumbers: number[]
    playerShown: PlayerView
    motionStill: bool
    keysOpen: bool
  resource findBarPort = exactViewport() as shape FindPort
  resource findBarPlaces = findPlaces() as shape FindPlaces
  state findBoxFocused = false
  action findBoxIn
    findBoxFocused = true
  action findBoxOut
    findBoxFocused = false
  action findClearKeep(e: PointerEvent)
    preventDefault()
  view
    if entry.id == findTop
      if results and findShown.results
        column position="absolute" inset=0 z-index=1 background-color="ground" padding-top="var(--exact-safe-area-inset-top)" testId="find-results"
          if findRows.length == 0
            text `No hymn matches “${findText.trim()}”.` font="type.body" color="muted" padding="space.s16" testId="none-found"
          else
            scroll id=`find-list-${entry.id}` flex=1 min-height=0 testId="find-list"
              column
                for s in findRows key=s.slug
                  if s.name != ""
                    FoundSection(name=s.name, slug=s.slug)
                  for r in s.rows key=r.number
                    FoundRow(number=r.number, title=r.title, line=r.line, star=favouriteNumbers.includes(r.number), open=findOpen)
      row position="absolute" left="space.s16" right="space.s16" pointer-events="none" bottom=`${findFoot(findBarPort, findBarPlaces, playerShown.dock or playerShown.pageBar, playerShown.dock ? playerShown.bar.rise : 0)}px` z-index=2
        display=(keysOpen ? "none" : "flex") align-items="center" justify-content="flex-end" gap="space.s12" testId="find-bar" -exact-layout-transition=(motionStill ? "none" : "easing.growth")
        if findShown.row == "tiles"
          FindHash(look=(findShown.chosen == "hash" ? "aloneChosen" : "alone"))
        else
          row height="size.target" border-radius="radius.pill" background-color="glass" overflow="hidden" align-items="center" pointer-events="auto"
            flex=(findShown.boxDrawn ? "1 1 0px" : "none") min-width=0 testId="find-capsule"
            if findShown.tilesControl
              button press=findPress("tilesShow", 0) appearance="none" aria-label="All at once" width="size.target" height="size.target" flex-shrink=0
                color="onGlass" display="flex" align-items="center" justify-content="center" testId="tiles-show"
                animation=(motionStill ? "none" : "hy-fade-in duration.fade ease-out both") -exact-exit-animation=(motionStill ? "none" : "hy-fade-out duration.fade ease-out both")
                :active
                  opacity = "opacity.pressed"
                image "symbol:layers" width="size.glyph" height="size.glyph"
            if findShown.searchDrawn
              button press=findSearchOn appearance="none" disabled=(not findShown.searchReach) aria-label="Search" aria-description="Opens search" aria-pressed=(findShown.chosen == "search")
                width="size.target" height="size.target" flex-shrink=0 color="onGlass" display="flex" align-items="center" justify-content="center" testId="find-search"
                :active
                  opacity = "opacity.pressed"
                image "symbol:search" width="size.glyph" height="size.glyph"
            if findShown.boxDrawn
              column width="size.target" height="size.target" flex-shrink=0 border-radius="radius.pill" background-color="glassChosen" color="onGlassChosen"
                align-items="center" justify-content="center" aria-hidden=true testId="find-chosen"
                animation=(motionStill ? "hy-fade-in duration.fade ease-out both" : "hy-fade-in duration.fade ease-out both")
                image "symbol:search" width="size.glyph" height="size.glyph"
              input type="search" value=findText input=findTyped placeholder="Number, title or first line" focus=findBoxIn blur=findBoxOut
                aria-label="Search hymns" autofocus=true disabled=(not findShown.boxReach) appearance="none" flex=1 min-width=0 height="size.target"
                padding=0 border="none" background-color="transparent" font="type.body" color="onGlass" caret-color="fieldCaret" testId="search"
                animation=(motionStill ? "hy-fade-in duration.fade ease-out both" : "hy-fade-in duration.fade ease-out both") -exact-exit-animation=(motionStill ? "hy-fade-out duration.fade ease-out both" : "hy-fade-out duration.fade ease-out both")
              if findBoxFocused and findText != ""
                button press=findTyped("") pointerdown=findClearKeep appearance="none" aria-label="Clear text"
                  width="size.target" height="size.target" flex-shrink=0 padding-right="space.s6" color="fieldClear"
                  display="flex" align-items="center" justify-content="flex-end" testId="find-clear"
                  image "symbol:icon.find-clear" width="size.clear" height="size.clear"
            FindHash(look=(findShown.chosen == "hash" ? "chosen" : "unchosen"))
        if findShown.cancelDrawn
          button press=findSearchOff appearance="none" disabled=(not findShown.cancelReach) min-height="size.target" flex-shrink=0 pointer-events="auto" color="accent" testId="find-cancel"
            animation=(motionStill ? "hy-fade-in duration.fade ease-out both" : "hy-fade-in duration.fade ease-out both") -exact-exit-animation=(motionStill ? "hy-fade-out duration.fade ease-out both" : "hy-fade-out duration.fade ease-out both")
            :active
              opacity = "opacity.pressed"
            text "Cancel" font="type.body"

// The `#` that opens and closes the drums, as the current app draws it
// (LivePlayer's `hash`): in the capsule over no fill (`unchosen`) or over
// the chosen disk (`chosen`), and on the tiles alone on a disk of glass
// (`alone`) or the chosen disk (`aloneChosen`).
component FindHash
  props
    look: string
  inject
    findShown: FindView
    findPress: action
    playerShown: PlayerView
  view
    button press=findPress("drumsOpen", playerShown.bar.shown ? playerShown.bar.number : 0) appearance="none" disabled=(not findShown.hashReach)
      aria-label="Find a hymn by number" aria-pressed=(findShown.chosen == "hash") width="size.target" height="size.target" flex-shrink=0
      border-radius="radius.pill" display="flex" align-items="center" justify-content="center" pointer-events="auto"
      background-color=(look == "chosen" or look == "aloneChosen" ? "glassChosen" : look == "alone" ? "glass" : "transparent")
      color=(look == "chosen" or look == "aloneChosen" ? "onGlassChosen" : "onGlass") testId="find-number"
      :active
        opacity = "opacity.pressed"
      text "#" font="type.name"

// The drums: a hymn's number dialled on three, hundreds, tens and ones,
// each the platform's adjustable control with its digit as its value. The
// hundreds stop at 0 and 6; the tens and ones turn one past each end, which
// the step wraps (`turn`), so an increment at 9 dials 0. Open goes to the
// hymn; the `#`, a tap outside, Escape or a swipe down close them.
// Drawn only while the step has them open, they pop in, and fade out as
// the `if` drops them; Open presses as the current app's does.
//
// The dialog fills the window, its panel standing over the find bar, as
// the current app's drums stand over the `#`: a tap outside the panel
// lands on `drums-outside` beneath it, a box that hears the pointer as the
// page's backdrop does (no control, so no stop for a reader or for Tab;
// the `#` is the drums' close button), and Escape is claimed by
// `findDrumsKey`, so each closes through the step and the `if` drops a
// dialog still open, which fades as the `#` closes it. The browser's own
// light dismiss would close the dialog first, so its exit would play
// unseen. Under Reduce Motion they leave at once. The dialog itself is a
// clear window over the page; the bar's `#` stays over it, in reach.
component FindDrums
  inject
    findShown: FindView
    findPress: action
    findDismiss: action
    findDrumsKey: action
    motionStill: bool
    playerShown: PlayerView
  resource findDrumsPort = exactViewport() as shape FindPort
  resource findDrumsPlaces = findPlaces() as shape FindPlaces
  view
    if findShown.drums
      dialog id="find-drums" closedby="closerequest" cancel=findDismiss key=findDrumsKey aria-label="Find a hymn by number"
        background-color="transparent" border="none" padding=0 margin=0 width="100%" height="100%" max-width="100%" max-height="100%" box-sizing="border-box" testId="drums"
        animation=(motionStill ? "hy-fade-in duration.fade ease-out both" : "hy-pop duration.panel easing.out both") -exact-exit-animation=(motionStill ? "none" : "hy-fade-out duration.exit ease-out both")
        ::backdrop
          background-color="transparent"
        column width="100%" height="100%" justify-content="flex-end" box-sizing="border-box" position="relative"
          padding-left="space.s16" padding-right="space.s16"
          padding-bottom=`calc(var(--exact-safe-area-inset-bottom) + ${findFoot(findDrumsPort, findDrumsPlaces, playerShown.dock or playerShown.pageBar, playerShown.dock ? playerShown.bar.rise : 0) + findDrumsPlaces.hash + findDrumsPlaces.gap}px)`
          column pointerup=findPress("drumsClose", 0) position="absolute" top=0 right=0 bottom=0 left=0 testId="drums-outside"
          FindDrumsPanel()
          FindHashOver()

// The `#` over the open drums, where the bar's stands, as their close
// button: the dialog lies over the page and its bar, so the `#` is drawn
// again in it, on the chosen disk, and closes them. The dialog lies outside
// every route, so its feet add the screen's bottom inset, which the route
// the bar stands in already keeps clear.
component FindHashOver
  inject
    findShown: FindView
    findPress: action
    playerShown: PlayerView
  resource findOverPort = exactViewport() as shape FindPort
  resource findOverPlaces = findPlaces() as shape FindPlaces
  view
    button press=findPress("drumsOpen", 0) appearance="none" aria-label="Close" aria-pressed=true
      position="absolute" right="space.s16" bottom=`calc(var(--exact-safe-area-inset-bottom) + ${findFoot(findOverPort, findOverPlaces, playerShown.dock or playerShown.pageBar, playerShown.dock ? playerShown.bar.rise : 0)}px)`
      width="size.target" height="size.target" border-radius="radius.pill" background-color="glassChosen" color="onGlassChosen"
      display="flex" align-items="center" justify-content="center" testId="drums-hash"
      :active
        opacity = "opacity.pressed"
      text "#" font="type.name"

// The panel: the current app's dial panel (src/player/DialPanel.tsx) in
// `panel` with an `edge` line, round at half a stop and its padding, the
// three drums side by side, each an equal share of the width, and Open
// under them as a pill. The dialled number is said, not shown: the
// current app draws none.
component FindDrumsPanel
  inject
    findShown: FindView
    findPress: action
  resource findPanelPlaces = findPlaces() as shape FindPlaces
  view
    column position="relative" z-index=1 background-color="panel" border-width="line.panel" border-style="solid" border-color="edge"
      border-radius=`${findPanelPlaces.detent / 2 + findPanelPlaces.pad}px` padding=`${findPanelPlaces.pad}px` gap=`${findPanelPlaces.rowGap}px`
      overflow="hidden" testId="drums-panel"
      text `${findShown.number}` aria-label=`Hymn ${findShown.number}` position="absolute" opacity=0 testId="drums-number"
      row gap=`${findPanelPlaces.rowGap}px`
        FindDrum(drum="hundreds", label="Hundreds", digit=findShown.hundreds, low=0, high=6, wraps=false)
        FindDrum(drum="tens", label="Tens", digit=findShown.tens, low=-1, high=10, wraps=true)
        FindDrum(drum="ones", label="Ones", digit=findShown.ones, low=-1, high=10, wraps=true)
      button press=findPress("open", 0) appearance="none" aria-label=`Open ${findShown.number}` testId="drums-open"
        min-height="size.target" border-radius="radius.pill" background-color="pill" color="onPill" display="flex" align-items="center" justify-content="center"
        :active
          background-color = "pressed"
          color = "onPressed"
          -exact-press-scale = 0.97
        text "Open" font="type.strong"

// A drum: a window of three stops, the digit at the notch in `chord` and
// the one above and below it in `muted` (none past an end that does not
// wrap), with the platform's adjustable control over it, its digit its
// value, so VoiceOver and a reader's arrows turn it a step at a time.
component FindDrum
  props
    drum: string
    label: string
    digit: number
    low: number
    high: number
    wraps: bool
  inject
    findDial: action
  resource findDrumPlaces = findPlaces() as shape FindPlaces
  view
    column flex="1 1 0px" min-width=0 position="relative" testId=`drum-face-${drum}`
      for at in [-1, 0, 1] key=at
        FindStop(digit=digit, at=at, wraps=wraps, high=high, detent=findDrumPlaces.detent)
      input type="range" min=low max=high step=1 value=digit input=findDial(drum) aria-label=label aria-valuetext=`${digit}`
        position="absolute" inset=0 width="100%" height="100%" margin=0 opacity=0.02 testId=`drum-${drum}`

// One stop of a drum, `at` stops from its notch: the digit there, which
// wraps round the drum's ten (or none past its end). It takes no touch: the
// drum's control lies over it and takes every one.
component FindStop
  props
    digit: number
    at: number
    wraps: bool
    high: number
    detent: number
  view
    row height=`${detent}px` align-items="center" justify-content="center" pointer-events="none" aria-hidden=true
      if wraps or (digit + at >= 0 and digit + at < high + 1)
        text `${wraps ? (digit + at + 10) % 10 : digit + at}` font="type.strong" font-variant-numeric="tabular-nums"
          color=(at == 0 ? "chord" : "muted")

// All at once, as the current app's (src/home/AllAtOnce.tsx): the home
// list zoomed out to one tile a group of the tab in use, over the list,
// which stays where it stood beneath. Two columns of tiles, each its
// group's name on up to two lines, how many hymns it holds, and a strip of
// where they lie from hymn 1 to 695; the group holding the player's hymn
// is outlined in the accent. The bar over them is headed "<Tab>, all at
// once", with Done. A tile's tap zooms back in with its group's row at the
// list's top (`findTilePick`: the list shows again, then its group's first
// row is scrolled to the top, under its pinned header); Done zooms back in
// where the list was. VoiceOver reads a tile as a button by its name,
// count, then `playing`.
component FindTiles
  inject
    findPress: action
    findGroups: FindTile[]
    findPick: action
    findTabName: string
    findWheel: action
    motionStill: bool
  view
    column flex=1 min-height=0 background-color="ground" testId="tiles"
      animation=(motionStill ? "hy-fade-in duration.fade ease-out both" : "hy-zoom-in duration.tiles-in easing.out both") -exact-exit-animation=(motionStill ? "hy-fade-out duration.fade ease-out both" : "hy-zoom-out duration.tiles-out ease-out both")
      row align-items="center" padding="space.s11 space.s8 space.s11 space.s16"
        text `${findTabName}, all at once` role="heading" aria-level=2 flex=1 min-width=0 font="type.tiles-head" color="ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId="tiles-heading"
        button press=findPress("tilesDone", 0) appearance="none" min-height="size.target" min-width="size.target" padding="0 space.s8" color="accent" testId="tiles-done"
          :active
            opacity = "opacity.pressed"
          text "Done" font="type.strong"
      scroll id="find-tiles" flex=1 min-height=0 wheel=findWheel testId="find-tiles"
        column display="grid" grid-template-columns="repeat(2, minmax(0, 1fr))" gap="space.s10" padding="0 space.s16 space.s16"
          for t in findGroups key=t.index
            button id=`group-tile-${t.index}` press=findPick(t.row) appearance="none" aria-label=t.label display="flex" flex-direction="column" justify-content="space-between" gap="space.s4"
              padding="space.s12" border-radius="radius.r12" border-width="line.tile" border-style="solid" border-color=(t.playing ? "accent" : "transparent")
              background-color="soft" text-align="start" min-width=0 box-sizing="border-box" testId=`group-tile-${t.index}`
              :active
                opacity = "opacity.pressed"
              text t.name font="type.tile-name" color="ink" line-clamp=2 overflow-wrap="break-word"
              text t.count font="type.tile-count" color="muted" line-clamp=1 testId=`group-tile-count-${t.index}`
              column position="relative" height="size.strip" border-radius="radius.pill" overflow="hidden" background-color="line" aria-hidden=true
                for s in t.spans key=s.start
                  column position="absolute" top=0 bottom=0 left=`${s.start * 100}%` width=`${(s.end - s.start) * 100}%` background-color="accent"

// A section of a search's results ("Hymns about this", "More matches"),
// drawn as a topic's row of the current app's list (HymnList.native.tsx
// `TopicRow`): its name, quiet, over a hairline; a search pins none, so it
// scrolls with its rows, and it takes no press.
component FoundSection
  props
    name: string
    slug: string
  view
    row role="heading" aria-level=2 align-items="center" padding-left="space.s16" padding-right="space.s16" padding-top="space.s8" padding-bottom="space.s8"
      position="relative" background-color="ground" testId=`found-section-${slug}`
      text name font="type.topic" color="muted" line-clamp=1 position="relative" top="nudge.topic"
      column position="absolute" left=0 right=0 bottom=0 height="line.hair" background-color="line" aria-hidden=true

// A found hymn's row: drawn as list.contract's `HymnRow` (the current
// app's row: number in the accent, title, a star when a favourite, a
// hairline from the title's edge), a button whose press opens the hymn as
// a found hymn opens (`listOpening`). A hymn found by a line other than
// its title shows that `line` under the title, quiet and one line long,
// the number level with the title at the row's top, the row two lines
// tall at every text size, as the current app's found row
// (HymnList.native.tsx `HymnRow`, `foundPadding`). VoiceOver reads its
// number, title, `favourite` when it is one, then the line (`nameOf`).
component FoundRow
  props
    number: number
    title: string
    line: string
    star: bool
    open: action
  view
    button press=open(number) appearance="none" display="flex" flex-direction="row" align-items=(line != "" ? "flex-start" : "center") gap="space.s12" text-align="start"
      padding-left="space.s16" padding-right="space.s16" padding-top=(line != "" ? "space.s8" : "space.s11") padding-bottom=(line != "" ? "space.s8" : "space.s11")
      box-sizing="border-box" position="relative" background-color="ground" testId=`hymn-${number}`
      aria-label=`${number}, ${title}${star ? ", favourite" : ""}${line != "" ? `, ${line}` : ""}`
      :active
        background-color = "soft"
      text `${number}` font="type.row-number" font-variant-numeric="tabular-nums" text-align="right" min-width="size.button" flex="none" color="accent" line-clamp=1 position="relative" top="nudge.number"
      column flex=1 min-width=0
        row align-items="center" gap="space.s12" position="relative" top="nudge.row"
          text title flex=1 min-width=0 font="type.row-title" color="ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          if star
            text "★" font="type.row-title" color="accent" aria-label="Favourite" testId=`star-${number}`
        if line != ""
          text line font="type.row-line" color="muted" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId=`row-line-${number}`
      column position="absolute" left="space.s64" right=0 bottom=0 height="line.hair" background-color="line" aria-hidden=true
