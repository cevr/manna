// The player: a hymn's recording from the bucket, its full player as
// a sheet, and the system's Now Playing (the element and the bar are
// features/bar.contract's). Every rule is `step` in
// src/player/step.ts, answered by `playerStep` (src/player/sources.ts); this
// file draws its view and turns the element's events into calls, each
// naming its load and the seek it follows. A seek the step sends is a
// `fastSeek` on the element, taken once by its serial.

use PlayerTempo, PlayerCount from "./tempo.contract"

shape PlayerBar
  shown: bool
  number: number
  title: string
  phase: string
  said: string
  toggle: string
  page: number
  kind: string
  label: string
  mark: string
  seeker: bool
  gone: string
  left: string
  rise: number
  told: string
  retry: string

shape PlayerChip
  stanza: number
  chosen: bool

shape PlayerSession
  title: string
  artist: string
  duration: number
  playing: bool

// Whether the page is online (`exactPage()`): a long wait offers Retry
// only online, as the current player's.
shape PlayerPage
  onLine: bool

shape PlayerGo
  serial: number
  kind: string
  path: string
  close: bool

shape PlayerView
  origin: string
  fixture: bool
  serial: number
  src: string
  load: number
  from: number
  paused: bool
  held: bool
  number: number
  title: string
  phase: string
  said: string
  caption: string
  toggle: string
  at: number
  length: number
  elapsed: string
  total: string
  seek: number
  seekTo: number
  holding: bool
  dragging: bool
  place: number
  skipAt: number
  ticking: bool
  dock: bool
  pageBar: bool
  onPage: number
  bar: PlayerBar
  pageLabel: string
  pageToggle: string
  chips: PlayerChip[]
  places: number[]
  session: PlayerSession
  go: PlayerGo
  kept: string
  rate: number
  some: bool
  tempo: PlayerTempo
  count: PlayerCount
  fellBack: bool
  offset: number
  command: string

fn playerLabel(toggle: string): string = toggle == "pause" ? "Pause" : (toggle == "retry" ? "Try again" : "Play")

members HymnalExact
  state playerKept = "" persist
  state playerGone = 0
  state playerSought = 0
  state playerTickAt = 0
  state playerDueAt = -1
  state playerSeekSentAt = 0
  state playerSeekSkips = false
  state playerGap = -1
  state playerSkipGap = -1
  state playerLastTick = 0
  state playerSkipFrom = -1
  state playerSkipLanded = -1
  state playerClockAt = 0
  state playerTicking = false
  derive playerPaths = stack(nav).map(e => e.name == "hymn" ? `/hymns/${e.params.n}` : (e.name == "player" ? "/player" : (e.name == "settings" or e.name == "about" or e.name == "tuner" or e.name == "chord" or e.name == "abouthymn" ? "/settings" : "/"))).join(" ")
  resource playerPage = exactPage() as shape PlayerPage
  resource playerBooted = playerStep("restore", 0, 0, 0, playerKept) as shape PlayerView
  resource playerOnScreen = playerStep("screen", 0, 0, 0, playerPaths) as shape PlayerView
  // The recording's key is the hymn's heard key: its move while chords are
  // on, the printed key while off (src/player/sources.ts `offsetsOf`), read
  // again at each switch and move; no answer of it moves the screen.
  resource playerKeyed = playerStep("keys", 0, 0, chordsOn ? 1 : 0, chordsMoves.join(" ")) as shape PlayerView
  mutation playerStepped as shape PlayerView queue then playerTook
  derive playerShownLatest = playerOnScreen.serial >= playerBooted.serial ? playerOnScreen : playerBooted
  derive playerLatest = playerKeyed.serial >= playerShownLatest.serial ? playerKeyed : playerShownLatest
  derive player = match playerStepped { case some(v) => (v.serial >= playerLatest.serial ? v : playerLatest), case none => playerLatest }
  action playerTook
    playerKept = player.kept
    if player.ticking and not playerTicking
      playerClockAt = performanceNow()
    playerTicking = player.ticking
    playerCounted()
    if player.seek > playerSought
      playerSought = player.seek
      fastSeek("audio", player.seekTo)
      playerSeekSentAt = performanceNow()
      playerSeekSkips = player.command == "skip"
      if player.command == "skip"
        playerSkipFrom = playerLastTick
    if player.go.serial > playerGone
      playerGone = player.go.serial
      if player.go.kind == "back"
        nav = back(nav)
      else if player.go.kind == "push" and player.go.close
        nav = push(back(nav), player.go.path)
      else if player.go.kind == "push"
        nav = push(nav, player.go.path)
      else if player.go.kind == "replace"
        nav = go(nav, player.go.path)
  action playerAsk(kind: string, value: number)
    if settingsFeel
      if kind == "page" or kind == "bar" or kind == "play"
        haptic("impact-light")
      else if kind == "stanza"
        haptic("selection")
      else if kind == "chooseAll" or kind == "tap"
        haptic("selection")
      else if kind == "tempoReset"
        haptic("impact-medium")
    if player.ticking
      playerClockTicked()
    send playerStepped = playerStep(kind, 0, 0, value, "")
  // The silent clock (Sound off) runs on the time since its last tick,
  // told before each of the reader's asks and each switch, so a pause or
  // a hand-over takes the place as it stands.
  action playerClockTicked
    let now = performanceNow()
    send playerStepped = playerStep("tick", player.load, 0, now - playerClockAt, "")
    playerClockAt = now
  action playerSoundTold
    if player.ticking
      playerClockTicked()
    send playerStepped = playerStep("sound", 0, 0, playerSound ? 1 : 0, "")
  action playerHeard(kind: string, id: number, value: number)
    send playerStepped = playerStep(kind, id, player.seek, value, "")
  action playerTicked(id: number, value: number)
    let now = performanceNow()
    playerTickAt = now
    playerLastTick = value
    if playerSeekSentAt > 0
      let gap = now - playerSeekSentAt
      playerGap = gap
      playerSeekSentAt = 0
      if playerSeekSkips
        playerSkipGap = gap
        playerSkipLanded = value
    send playerStepped = playerStep("time", id, player.seek, value, "")
  action playerFailed(id: number, code: string)
    send playerStepped = playerStep("failed", id, 0, 0, code)
  action playerRemote(kind: string, way: number, d: MediaSessionActionDetails)
    send playerStepped = playerStep(kind, 0, 0, kind == "remoteSeek" ? d.seekTime : way, "")
  action playerWaited
    if playerPage.onLine
      send playerStepped = playerStep("waited", player.load, 0, 0, "")
  action playerSettled
    send playerStepped = playerStep("settle", player.load, player.seek, 0, "")
  action playerSkipCheck
    if playerDueAt != player.skipAt and performanceNow() - playerTickAt >= (player.skipAt - player.place) * 1000 / player.rate
      playerDueAt = player.skipAt
      send playerStepped = playerStep("due", player.load, player.seek, player.skipAt, "")
  // A sent place is held until the device reaches it, or this long
  // (scrub-rules.ts `settleFor`, held to it by src/player/seek.test.ts).
  task playerSettle when player.holding key=player.seek
    after(2000, playerSettled)
  // A wait on the network this long, online, offers Retry beside Pause
  // (src/player/step.ts `WAIT`, the current player's `giveUpAfter`).
  task playerWait when player.phase == "buffering" and playerPage.onLine key=player.load
    after(15000, playerWaited)
  // Near a span the stanza choice leaves out, each frame asks whether the
  // runner's clock, from the last tick, has reached its start.
  task playerSkipWatch when player.skipAt >= 0
    every(frame, playerSkipCheck)
  // While Sound is off and the hymn plays, the silent clock ticks
  // (src/player/step.ts's `tick`, held to the current score clock by
  // src/player/clock/clock.model.test.ts).
  task playerClock when player.ticking key=player.load
    every(250, playerClockTicked)
  // The player is told Sound at launch and at each switch; off hands the
  // place to the silent clock, on back to the recording.
  task playerSoundTell key=playerSound
    change(playerSoundTold)
  // The player is told whether the page is online, at launch and at each
  // change: offline a play sounds a saved recording, and one not saved
  // fails as the current player's does with no connection.
  action playerOnlineTold
    send playerStepped = playerStep("online", 0, 0, playerPage.onLine ? 1 : 0, "")
  task playerOnlineTell key=playerPage.onLine
    change(playerOnlineTold)

// The room the bar takes under a screen's last row while it shows, docked
// or the page's own: one call line at the end of a screen's scrolled
// content, as tall as the bar's row and its hairline.
component PlayerBarRoom
  props
    id: string
  inject
    playerShown: PlayerView
    motionStill: bool
  view
    if playerShown.dock or playerShown.pageBar
      column min-height="calc(size.target + space.s12)" padding-top="line.hair" flex-shrink=0 testId=id -exact-layout-transition=(motionStill ? "none" : "duration.bar-in easing.out")

// The player's chip, as the current Chip.tsx draws it: a pill in the
// pill's roles, or on the chosen mark while chosen, its word in the chip
// type, never narrower than a target and dimmed while held; `hint` is its
// accessibilityHint, in the current chip's words.
component PlayerPill
  props
    label: string
    press: action
    id: string
    name: string
    hint: string
    chosen: bool
  view
    button press=press appearance="none" display="flex" flex-direction="row" align-items="center" justify-content="center" gap="space.s6" height="size.slider" min-width="size.target" padding="0px space.s12" border-radius="radius.r16" box-sizing="border-box" background-color=(chosen ? "chosen" : "pill") -exact-press-opacity="opacity.pressed" aria-label=name aria-description=hint aria-pressed=chosen testId=id
      text label font="type.chip" color=(chosen ? "onChosen" : "onPill") line-clamp=1
