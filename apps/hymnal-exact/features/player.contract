// The player: a hymn's recording from the bucket, the bar docked under the
// stack while the player holds a hymn and no sheet is up, the full player as
// a sheet, and the system's Now Playing. Every rule is `step` in
// src/player/step.ts, answered by `playerStep` (src/player/sources.ts); this
// file draws its view and turns the element's events into calls, each
// naming its load and the seek it follows. A seek the step sends is a
// `fastSeek` on the element, taken once by its serial.
use hy-rise, hy-sink, hy-fade-in, hy-fade-out from "./motion.contract"

shape PlayerBar
  shown: bool
  number: number
  title: string
  phase: string
  said: string
  toggle: string
  page: number

shape PlayerChip
  stanza: number
  chosen: bool

shape PlayerSession
  title: string
  artist: string
  duration: number
  playing: bool

shape PlayerGo
  serial: number
  kind: string
  path: string
  close: bool

shape PlayerView
  origin: string
  serial: number
  src: string
  load: number
  from: number
  paused: bool
  held: bool
  number: number
  title: string
  phase: string
  said: string
  caption: string
  toggle: string
  at: number
  length: number
  elapsed: string
  total: string
  seek: number
  seekTo: number
  holding: bool
  dragging: bool
  place: number
  skipAt: number
  dock: bool
  pageBar: bool
  onPage: number
  bar: PlayerBar
  pageToggle: string
  chips: PlayerChip[]
  places: number[]
  session: PlayerSession
  go: PlayerGo
  kept: string
  command: string

fn playerLabel(toggle: string): string = toggle == "pause" ? "Pause" : (toggle == "retry" ? "Try again" : "Play")
// The bar's mark for a button, as the current BarMark.ios.tsx draws it.
fn playerMark(toggle: string): string = toggle == "pause" ? "symbol:sf/pause.fill" : (toggle == "retry" ? "symbol:sf/arrow.clockwise" : "symbol:sf/play.fill")

members HymnalExact
  state playerKept = "" persist
  state playerGone = 0
  state playerSought = 0
  state playerTickAt = 0
  state playerDueAt = -1
  state playerSeekSentAt = 0
  state playerSeekSkips = false
  state playerGap = -1
  state playerSkipGap = -1
  state playerLastTick = 0
  state playerSkipFrom = -1
  state playerSkipLanded = -1
  derive playerPaths = stack(nav).map(e => e.name == "hymn" ? `/hymns/${e.params.n}` : (e.name == "player" ? "/player" : (e.name == "settings" or e.name == "about" ? "/settings" : "/"))).join(" ")
  resource playerBooted = playerStep("restore", 0, 0, 0, playerKept) as shape PlayerView
  resource playerOnScreen = playerStep("screen", 0, 0, 0, playerPaths) as shape PlayerView
  mutation playerStepped as shape PlayerView queue then playerTook
  derive playerLatest = playerOnScreen.serial >= playerBooted.serial ? playerOnScreen : playerBooted
  derive player = match playerStepped { case some(v) => (v.serial >= playerLatest.serial ? v : playerLatest), case none => playerLatest }
  action playerTook
    playerKept = player.kept
    if player.seek > playerSought
      playerSought = player.seek
      fastSeek("audio", player.seekTo)
      playerSeekSentAt = performanceNow()
      playerSeekSkips = player.command == "skip"
      if player.command == "skip"
        playerSkipFrom = playerLastTick
    if player.go.serial > playerGone
      playerGone = player.go.serial
      if player.go.kind == "back"
        nav = back(nav)
      else if player.go.kind == "push" and player.go.close
        nav = push(back(nav), player.go.path)
      else if player.go.kind == "push"
        nav = push(nav, player.go.path)
      else if player.go.kind == "replace"
        nav = go(nav, player.go.path)
  action playerAsk(kind: string, value: number)
    if settingsFeel
      if kind == "page" or kind == "bar" or kind == "play"
        haptic("impact-light")
      else if kind == "stanza"
        haptic("selection")
    send playerStepped = playerStep(kind, 0, 0, value, "")
  action playerHeard(kind: string, id: number, value: number)
    send playerStepped = playerStep(kind, id, player.seek, value, "")
  action playerTicked(id: number, value: number)
    let now = performanceNow()
    playerTickAt = now
    playerLastTick = value
    if playerSeekSentAt > 0
      let gap = now - playerSeekSentAt
      playerGap = gap
      playerSeekSentAt = 0
      if playerSeekSkips
        playerSkipGap = gap
        playerSkipLanded = value
    send playerStepped = playerStep("time", id, player.seek, value, "")
  action playerFailed(id: number, code: string)
    send playerStepped = playerStep("failed", id, 0, 0, code)
  action playerRemote(kind: string, way: number, d: MediaSessionActionDetails)
    send playerStepped = playerStep(kind, 0, 0, kind == "remoteSeek" ? d.seekTime : way, "")
  action playerSettled
    send playerStepped = playerStep("settle", player.load, player.seek, 0, "")
  action playerSkipCheck
    if playerDueAt != player.skipAt and performanceNow() - playerTickAt >= (player.skipAt - player.place) * 1000
      playerDueAt = player.skipAt
      send playerStepped = playerStep("due", player.load, player.seek, player.skipAt, "")
  // A sent place is held until the device reaches it, or this long
  // (scrub-rules.ts `settleFor`, held to it by src/player/seek.test.ts).
  task playerSettle when player.holding key=player.seek
    after(2000, playerSettled)
  // Near a span the stanza choice leaves out, each frame asks whether the
  // runner's clock, from the last tick, has reached its start.
  task playerSkipWatch when player.skipAt >= 0
    every(frame, playerSkipCheck)

// The device and the bar, docked over the stack's foot (a route must be a
// child of the navigation root, so the bar cannot take room of its own;
// each screen leaves room under its last row): the element is keyed by
// its load, so a new load is a new element and an old one's events end
// with it; the bar shows while the player holds a hymn and no sheet is up,
// and the dock has no box at all otherwise. While the player holds none,
// a hymn page on top shows the same bar as its own (`pageBar`), as the
// current hymnal's page draws it, so one bar stays put as Play docks it.
component PlayerDock
  props
    player: PlayerView
    ask: action
    heard: action
    ticked: action
    broke: action
    remote: action
  inject
    motionStill: bool
  view
    column position="absolute" left=0 right=0 bottom=0 aria-hidden=(not (player.dock or player.pageBar))
      for l in (player.src == "" ? [] : [player.load]) key=l
        audio player.src id="audio" paused=player.paused currentTime=player.from testId="audio"
          metadata=MediaMetadata(title=player.session.title, artist=player.session.artist, album="SDA Hymnal", artwork="")
          seekbackwardOffset=10 seekforwardOffset=10
          seekto=remote("remoteSeek", 0) seekbackward=remote("remoteSkip", -1) seekforward=remote("remoteSkip", 1)
          durationchange=heard("loaded", l) timeupdate=ticked(l) seeked=heard("seeked", l, 0)
          waiting=heard("waiting", l, 0) play=heard("played", l, 0) playing=heard("playing", l, 0)
          pause=heard("paused", l, 0) ended=heard("ended", l, 0) error=broke(l)
      if player.dock or player.pageBar
        column position="absolute" left=0 right=0 bottom=0 animation=(motionStill ? "hy-fade-in duration.fade ease-out both" : "hy-rise duration.bar-in easing.out both") -exact-exit-animation=(motionStill ? "hy-fade-out duration.fade ease-out both" : "hy-sink duration.bar-out ease-out both")
          PlayerBarFrame(player=player, ask=ask)

// The bar, as the current PlayerBar.tsx draws it: over the home indicator,
// on the bar's ground under a hairline, one row at the thumb. The opener
// fills the row: it names the bar's hymn, or shows a grabber at the bar's
// centre while that hymn is the page's own, and opens the full player.
// Then the page's compact Play while another hymn sounds over it, and the
// player's button as a mark. A hymn page's own bar, while nothing is held,
// shows the grabber and the page's Play. A failure's reason shows under
// the hymn, where a mark cannot say it.
component PlayerBarFrame
  props
    player: PlayerView
    ask: action
  view
    column testId="bar" role="region" aria-label="Player" background-color="bar" border-top-width="line.hair" border-top-style="solid" border-top-color="line" padding-bottom="var(--exact-safe-area-inset-bottom)"
      row position="relative" align-items="center" gap="space.s8" padding="0px space.s12" height="calc(size.target + space.s12)"
        if player.pageBar or (player.bar.number == player.onPage and player.bar.phase != "failed")
          row position="absolute" inset=0 justify-content="center" align-items="center" pointer-events="none" aria-hidden=true
            view width="size.grabber" height="size.grabber-line" border-radius="radius.grabber" background-color="line" testId="bar-grabber"
        if player.pageBar
          view flex=1 min-width=0
          PlayerMark(symbol=playerMark("play"), press=ask("page", player.onPage), id="play", name="Play")
        else
          button press=ask("open", 0) appearance="none" flex=1 min-width=0 min-height="size.target" display="flex" flex-direction="column" justify-content="center" align-items="stretch" testId="bar-title" aria-label=`Open the player: ${player.bar.number} ${player.bar.title}`
            if player.bar.number != player.onPage
              row gap="space.s8" align-items="center" justify-content="center"
                text `${player.bar.number}` font="type.label" color="accent" font-variant-numeric="tabular-nums" testId="bar-number"
                text player.bar.title font="type.small" color="ink" flex=1 min-width=0 line-clamp=1 text-align="left" testId="bar-hymn"
            if player.bar.phase == "failed" and player.bar.said != ""
              text player.bar.said font="type.small" color="muted" line-clamp=1 text-align="center" testId="bar-said"
          if player.bar.page != 0
            button press=ask("play", player.bar.page) appearance="none" min-height="size.target" min-width="size.target" padding="0px space.s4" testId="bar-page-play" aria-label=`Play hymn ${player.bar.page}`
              text `Play ${player.bar.page}` font="type.label" color="button" font-variant-numeric="tabular-nums"
          if player.bar.toggle != ""
            PlayerMark(symbol=playerMark(player.bar.toggle), press=ask("bar", 0), id="bar-toggle", name=playerLabel(player.bar.toggle))

// A bar button's mark: the symbol at 22 points in the button's role, in a
// round 44-point target that takes the soft fill while held.
component PlayerMark
  props
    symbol: string
    press: action
    id: string
    name: string
  view
    button press=press appearance="none" display="flex" align-items="center" justify-content="center" width="size.target" height="size.target" border-radius="radius.pill" flex-shrink=0 testId=id aria-label=name
      :active
        background-color = "soft"
      image symbol width="size.glyph" height="size.glyph" object-fit="contain" color="button" aria-hidden=true

// The room the bar takes under a screen's last row while it shows, docked
// or the page's own: one call line at the end of a screen's scrolled
// content, as tall as the bar's row and its hairline.
component PlayerBarRoom
  props
    id: string
  inject
    playerShown: PlayerView
    motionStill: bool
  view
    if playerShown.dock or playerShown.pageBar
      column min-height="calc(size.target + space.s12)" padding-top="line.hair" flex-shrink=0 testId=id -exact-layout-transition=(motionStill ? "none" : "duration.bar-in easing.out")

// The player's chip, as the current Chip.tsx draws it: a pill in the
// pill's roles, or on the chosen mark while chosen, its word in the chip
// type, never narrower than a target and dimmed while held.
component PlayerPill
  props
    label: string
    press: action
    id: string
    name: string
    chosen: bool
  view
    button press=press appearance="none" display="flex" flex-direction="row" align-items="center" justify-content="center" gap="space.s6" height="size.slider" min-width="size.target" padding="0px space.s12" border-radius="radius.r16" box-sizing="border-box" background-color=(chosen ? "chosen" : "pill") -exact-press-opacity="opacity.pressed" aria-label=name aria-pressed=chosen testId=id
      text label font="type.chip" color=(chosen ? "onChosen" : "onPill") line-clamp=1

// The full player, a sheet over the screen it opened from at half the
// screen, which the grabber pulls to full, as the current FullPlayer.tsx
// draws it: the hymn's number and title (a press goes to its page), what
// the player is doing, its place on a bar the reader can move with the
// time gone and the whole length, Play or Pause in the button's role, and
// its stanzas as chips, each sung one with a way to its start.
component PlayerSheet
  props
    entry: Entry
    player: PlayerView
    ask: action
  view
    column navigationKey=`${entry.id}` navigationPresentation="modal" navigationDetent="50% large" navigationGrabber="visible" navigationScroll="player-sheet" position="absolute" inset=0 testId="player"
      scroll id="player-sheet" flex=1 min-height=0
        column padding="space.s24" gap="space.s16"
          column role="group" aria-label="Recording" gap="space.s16"
            button press=ask("title", 0) appearance="none" text-align="left" -exact-press-opacity="opacity.pressed" testId="player-title" aria-label=`Open hymn ${player.number}`
              text `${player.number} ${player.title}` font="type.head" color="ink" font-variant-numeric="tabular-nums" role="heading" aria-level=1
            text player.caption font="type.caption" color="muted" testId="player-said"
            column gap="space.s4"
              input type="range" id="position" min=0 max=player.length value=player.at adjust-step=10 disabled=(player.length <= 0) input=ask("dragTo") change=ask("dragEnd") height="size.slider" aria-label="Position" aria-valuetext=`${player.elapsed} of ${player.total}` testId="position"
              row justify-content="space-between"
                text player.elapsed font="type.footnote" color="muted" font-variant-numeric="tabular-nums" testId="elapsed"
                text player.total font="type.footnote" color="muted" font-variant-numeric="tabular-nums" testId="total"
            row justify-content="center" align-items="center" min-height="size.target" gap="space.s8"
              if player.phase == "failed" and player.toggle == "retry"
                button press=ask("retry", 0) appearance="none" min-height="size.target" testId="retry"
                  text "Try again" font="type.body" color="button"
              else if player.phase != "failed" and player.toggle != ""
                button press=ask("page", player.number) appearance="none" min-height="size.target" -exact-press-opacity="opacity.pressed" testId="toggle" aria-label=playerLabel(player.toggle)
                  text playerLabel(player.toggle) font="type.body" color="button"
          if player.chips.length > 0
            column role="group" aria-label="Stanzas" gap="space.s8" padding="0px space.s16" testId="stanzas"
              text "Stanzas" font="type.chip" color="muted" text-transform="uppercase" aria-hidden=true
              row gap="space.s8" flex-wrap="wrap" align-items="center"
                for c in player.chips key=c.stanza
                  PlayerPill(label=`${c.stanza}`, press=ask("stanza", c.stanza), id=`stanza-${c.stanza}`, name=`Stanza ${c.stanza}`, chosen=c.chosen)
              if player.places.length > 0
                row gap="space.s8" flex-wrap="wrap" align-items="center"
                  text "Go to" font="type.chip" color="muted" text-transform="uppercase" aria-hidden=true
                  for n in player.places key=n
                    button press=ask("place", n) appearance="none" display="flex" align-items="center" justify-content="center" height="size.slider" min-width="size.target" padding="0px space.s12" border-radius="radius.r16" box-sizing="border-box" background-color="pill" -exact-press-opacity="opacity.pressed" aria-label=`Go to the start of stanza ${n}` testId=`stanza-place-${n}`
                      text `${n}` font="type.chip" color="onPill" line-clamp=1
