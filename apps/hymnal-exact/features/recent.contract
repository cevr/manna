// Recent: the hymns last opened, newest first, kept across launches. A hymn
// page shown on top of the stack, pushed or put in another page's place,
// is a visit (`recentAfter`, the current
// app's `visited`); the home list's shelf shows the latest five, and its
// header opens this screen with all of them (`recentRows`). As the current
// app's: the stack's bar over a hairline, the rows as home's, and with
// none the current app's words for it. The find bar stands at its foot, and
// its results take the list's place while its search is open here
// (features/find.contract).
use HymnRow, RecentView from "./list.contract"
use PlayerBarRoom from "./player.contract"
use FindBar, FindView, findSearchingAt from "./find.contract"

shape RecentList
  numbers: number[]

members HymnalExact
  state recentList: number[] = [] persist
  resource recentShown = recentRows(recentList) as shape RecentView else empty()
  mutation recentVisited as shape RecentList queue then recentKeep
  task recentVisit when top(nav).name == "hymn" key=`${top(nav).id} ${top(nav).url}`
    change(recentSeen)
  action recentSeen
    send recentVisited = recentAfter(recentList, top(nav).params.n)
  action recentKeep
    match recentVisited
      case some(r)
        recentList = r.numbers
      case none
        recentList = recentList

component RecentScreen
  props
    entry: Entry
    recent: RecentView
    favourites: number[]
  inject
    findShown: FindView
  view
    column navigationKey=`${entry.id}` navigationScroll="recent-list" position="absolute" inset=0
      display="flex" flex-direction="column" background-color="ground"
      header
        text "Recent" role="heading" aria-level=2 testId="recent-title"
      column height=0 flex-shrink=0 position="relative" overflow="visible"
        column position="absolute" top=0 left=0 right=0 height="line.hair" background-color="line" testId="recent-rule"
      if recent.all.length == 0
        column flex=1 min-height=0 display=(findShown.results and findSearchingAt(findShown, entry.url) ? "none" : "flex") testId="recent-list"
          text "The hymns you open show here." font="type.body" color="muted" padding="space.s16" testId="recent-empty"
      else
        list id="recent-list" appearance="auto" listStyle="plain" flex=1 min-height=0
          display=(findShown.results and findSearchingAt(findShown, entry.url) ? "none" : "flex") flex-direction="column" testId="recent-list"
          section
            for r in recent.all key=r.number
              HymnRow(number=r.number, title=r.title, id=`recent-${r.number}`, star=(favourites.includes(r.number) ? `recent-star-${r.number}` : ""), gutter=false)
      FindBar(entry=entry, results=true)
      PlayerBarRoom(id="bar-room-recent")
