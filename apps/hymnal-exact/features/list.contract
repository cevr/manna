// The home list: the tab row over the list of the tab in use, and the find
// bar at its foot, where iOS keeps a search (the tab row stays in UIKit's
// bar only while the list follows it directly); the bar's search over every hymn (app.ts `hymnRows`, `listTabRows`;
// src/list/rows.ts, src/home/tabs.ts) shows while it is open here with
// words in its box (features/find.contract). Sections is every hymn under
// the hymnal's topical sections, under the Recent shelf; another tab is
// asked for only once it is chosen. A found hymn opens as the current app
// opens one (`listOpening`). All at once, the tiles, lies over the list,
// which stays built where it stood beneath; a section's header is drawn in
// the muted role.
use EmptyState from "exact:content"
use PlayerView from "./player.contract"
use FindBar, FindTiles, FindView, findSearchingAt, FoundRow, ListRow, RowSection from "./find.contract"

shape TabGroup
  slug: string
  name: string
  numbers: number[]
  repeats: number[]

shape RecentView
  shelf: ListRow[]
  all: ListRow[]

shape ListOpening
  how: string
  path: string

// Hymn n's title, from the book's titles at their numbers less one.
fn listTitle(titles: string[], n: number): string = match titles.at(n - 1) { case some(t) => t, case none => "" }

// A tab row's `testId` (`<kind>-<n>`), or, for a hymn a group above lists
// too, one that names the group as well (`<kind>-<slug>-<n>`).
fn listRowId(g: TabGroup, n: number, kind: string): string = g.repeats.includes(n) ? `${kind}-${g.slug}-${n}` : `${kind}-${n}`

members HymnalExact
  state listQuery = ""
  state listTab = "Sections" persist
  resource listRows = hymnRows(find.query) as shape RowSection[] else empty()
  resource listTabNames = listTabs() as shape string[] else empty()
  resource listTitleOf = listTitles() when listTab != "Sections" as shape string[] else empty()
  resource listGroups = listTabRows(listTab, listTab == "Lists" ? favouriteList : [], listTab == "Lists" ? recentList : []) when listTab != "Sections" as shape TabGroup[] else empty()
  mutation listOpening as shape ListOpening queue then listOpened
  action listChoose(name: string)
    if settingsFeel
      if name != listTab
        haptic("selection")
    listTab = name
  action listOpen(n: number)
    send listOpening = listOpening(top(nav).url, n)
  action listOpened
    match listOpening
      case some(o)
        if o.how == "push"
          nav = push(nav, o.path)
        else if o.how == "replace"
          nav = replace(nav, o.path)
      case none
        nav = nav

component HymnList
  props
    entry: Entry
    query: string
    sections: RowSection[]
    tab: string
    tabs: string[]
    choose: action
    groups: TabGroup[]
    titles: string[]
    recent: RecentView
    favourites: number[]
    open: action
  inject
    playerShown: PlayerView
    findShown: FindView
    findWheel: action
    settingsGear: action
  view
    column navigationKey=`${entry.id}` navigationBar="none" navigationScroll="hymn-list" position="absolute" inset=0
      display="flex" flex-direction="column" background-color="ground"
      row align-items="center" padding-left="space.s16" padding-right="space.s8" flex-shrink=0 testId="title-row"
        text "Hymns" role="heading" aria-level=1 flex=1 min-width=0 padding-top="space.s4" padding-bottom="space.s4" position="relative" top="nudge.title" font="type.large-title" color="ink" line-clamp=1 testId="title"
        button press=settingsGear aria-label="Settings" appearance="none" width="size.target" height="size.target" display="flex" align-items="center" justify-content="center"
          border-radius="radius.pill" -exact-press-opacity="opacity.pressed" flex-shrink=0 testId="gear"
          image "symbol:settings" width="nudge.gear" height="nudge.gear" position="relative" left="nudge.gear-left" object-fit="contain" color="accent"
      row role="tablist" aria-label="Show hymns by" appearance="none" overflow-x="auto" flex-shrink=0 gap="space.s8"
        padding-left="space.s16" padding-right="space.s16" padding-top="space.s8" padding-bottom="space.s8" display=(findShown.homeTiles ? "none" : "flex") testId="tabs"
        for t in tabs key=t
          button role="tab" aria-selected=(tab == t) press=choose(t) appearance="none" flex-shrink=0
            padding-left="space.s12" padding-right="space.s12" padding-top="space.s6" padding-bottom="space.s6" border-radius="radius.r16"
            background-color=(tab == t ? "selected" : "transparent") -exact-press-opacity="opacity.pressed" testId=`tab-${t.toLowerCase()}`
            text t font="type.topic" color=(tab == t ? "ink" : "accent") line-clamp=1 white-space="nowrap"
      if findShown.homeTiles
        FindTiles()
      if sections.length == 0 and query.trim() != "" and findSearchingAt(findShown, entry.url)
        column flex=1 min-height=0 testId="none-found"
          EmptyState(symbol="symbol:search", title=`No hymn matches “${query.trim()}”.`, message="Try its number, or a line you remember.")
      else if query.trim() != "" and findSearchingAt(findShown, entry.url)
        list id="hymn-list" appearance="auto" listStyle="plain" flex=1 min-height=0 testId="hymn-list"
          section
            for s in sections key=s.slug
              for r in s.rows key=r.number
                FoundRow(number=r.number, title=r.title, star=favourites.includes(r.number), open=open)
      else if tab == "Sections"
        list id="hymn-list" appearance="auto" listStyle="plain" flex=1 min-height=0 display=(findShown.homeTiles ? "none" : "flex") flex-direction="column" wheel=findWheel testId="hymn-list"
          if recent.shelf.length > 0
            section testId="recent-shelf"
              link href=path("recent") aria-label="Recent, see all" display="flex" flex-direction="row" align-items="center" justify-content="space-between"
                padding-left="space.s16" padding-right="space.s16" padding-top="space.s8" padding-bottom="space.s8" margin-right="size.target"
                border-bottom-width="line.hair" border-bottom-style="solid" border-bottom-color="line" background-color="ground" testId="recent-all"
                text "Recent" font="type.topic" color="muted" line-clamp=1 position="relative" top="nudge.topic" testId="recent-header"
                text "See all ›" font="type.see-all" color="accent" line-clamp=1
              for r in recent.shelf key=r.number
                HymnRow(number=r.number, title=r.title, id=`shelf-${r.number}`, star=(favourites.includes(r.number) ? `shelf-star-${r.number}` : ""), gutter=true)
          for s in sections key=s.slug
            section
              ListHeader(name=s.name, id=`section-${s.slug}`, gutter=true)
              for r in s.rows key=r.number
                HymnRow(number=r.number, title=r.title, id=`hymn-${r.number}`, star=(favourites.includes(r.number) ? `star-${r.number}` : ""), gutter=true)
      else if groups.length == 0 and tab == "Lists"
        column flex=1 min-height=0 testId="hymn-list"
          text "No hymns here yet." font="type.body" color="muted" padding="space.s16" testId="lists-empty"
      else
        list id="hymn-list" appearance="auto" listStyle="plain" flex=1 min-height=0 display=(findShown.homeTiles ? "none" : "flex") flex-direction="column" wheel=findWheel testId="hymn-list"
          for g in groups key=g.slug
            section
              ListHeader(name=g.name, id=`group-${g.slug}`, gutter=false)
              for n in g.numbers key=n
                HymnRow(number=n, title=listTitle(titles, n), id=listRowId(g, n, "hymn"), star=(favourites.includes(n) ? listRowId(g, n, "star") : ""), gutter=false)
      FindBar(entry=entry, results=false)
      ListBarRoom(shown=playerShown.bar.shown)

// The room the player's docked bar takes under a screen's list while it
// shows: the bar lies over the stack's foot (a route is a child of the
// navigation root), so the screen leaves room for it under its last row.
component ListBarRoom
  props
    shown: bool
  view
    if shown
      column min-height="5rem" flex-shrink=0 testId="bar-room"

// A group's header, as the current app's topic row: its name, quiet, on
// the ground over a hairline. With `gutter` it ends before the Sections
// list's rail gutter, as every row of that list does.
component ListHeader
  props
    name: string
    id: string
    gutter: bool
  view
    row align-items="center" padding-left="space.s16" padding-right="space.s16" padding-top="space.s8" padding-bottom="space.s8"
      height="size.button" min-height=0 box-sizing="border-box" margin-right=(gutter ? "size.target" : "0px") border-bottom-width="line.hair" border-bottom-style="solid" border-bottom-color="line" background-color="ground"
      text name font="type.topic" color="muted" line-clamp=1 position="relative" top="nudge.topic" testId=id

// A hymn's row, as the current app's: its number in the accent, then its
// title, and a star at the row's end when it is a favourite; a hairline
// under it from the title's edge; a press opens the hymn. `id` is the
// row's `testId` and `star` its star's, each unique on its screen; no star
// when `star` is "". With `gutter` the row ends before the Sections list's
// rail gutter.
component HymnRow
  props
    number: number
    title: string
    id: string
    star: string
    gutter: bool
  view
    link href=path("hymn", `${number}`) display="flex" flex-direction="row" align-items="center" gap="space.s12"
      padding-left="space.s16" padding-right="space.s16" padding-top="space.s11" padding-bottom="space.s11"
      height="size.target" min-height=0 box-sizing="border-box" margin-right=(gutter ? "size.target" : "0px") border-bottom="none" position="relative" background-color="ground" testId=id
      :active
        background-color="soft"
      text `${number}` font="type.row-number" font-variant-numeric="tabular-nums" text-align="right" min-width="size.button" flex="none" color="accent" line-clamp=1 position="relative" top="nudge.number"
      row flex=1 min-width=0 align-items="center" gap="space.s12" position="relative" top="nudge.row"
        text title flex=1 min-width=0 font="type.row-title" color="ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        if star != ""
          text "★" font="type.row-title" color="accent" aria-label="Favourite" testId=star
      column position="absolute" left="space.s64" right=0 bottom=0 height="line.hair" background-color="line"
