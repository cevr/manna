// The home list, as the current app's home: its own title row and gear (no
// navigation bar) and the tab row, scrolling away above the list of the tab
// in use, whose group headers stay at its top, and the find bar at its
// foot. The bar's search over every hymn (app.ts `hymnRows`,
// `listTabRows`; src/list/rows.ts, src/home/tabs.ts) draws its results in
// the list's place while it is open here with words in its box
// (features/find.contract). Sections is every hymn under the hymnal's
// topical sections, under the Recent shelf; another tab is asked for only
// once it is chosen. A found hymn opens as the current app opens one
// (`listOpening`). All at once, the tiles, lies over the list, which stays
// built where it stood beneath; a group's header is drawn in the muted
// role, and a tap on it opens All at once. Sections carries the current
// app's number rail at its right edge (features/rail.contract), its top at
// the header's bottom (`listShift`: the title and tabs' height, more while
// the list is pulled past its top, as One's `railShift`), and a row the
// rail scrolls to lands under its pinned header (`listPin`), as a row
// scrolled to on another tab does. Where a scroll of the list comes to
// rest, its offset from the list's top in points, is `listTop`, so All at
// once can open at the group the reader was at.
// Deep in the list, an upward scroll pins a second tab row over the list's
// top under the status bar, and a downward one sends it away, as the
// current app's PinnedTabs (`ListTabsPinned`): a layer over the list, so the
// list's content and offset never move for it. The rule is the current
// app's `home/reveal.ts`, stepped in the data module (`listTabsStep`,
// src/list/reveal.ts) by each scroll report that can turn it (the rest kept
// back by the band each answer names, `listTabsReport`), by the app's own moves of the
// list (a tab chosen, a tile picked, the rail, a landing: `listTabsJump`,
// which turns nothing and holds the row until the reader touches the list)
// and by the reader's touch (`listTabsTouch`). A group's pinned header and
// a row scrolled to stand under it (`listTabs.cover`).
use PlayerBarRoom, PlayerView from "./player.contract"
use FindBar, FindPlaces, FindPort, FindTiles, FindView, findFoot, findSearchingAt, ListRow, RowSection from "./find.contract"
use HomeRail from "./rail.contract"

shape TabGroup
  slug: string
  name: string
  numbers: number[]
  repeats: number[]

shape RecentView
  shelf: ListRow[]
  all: ListRow[]

shape ListOpening
  how: string
  path: string

// The pinned tab row after an input (src/list/reveal.ts `TabsAt`): shown
// (its slide's end), in reach, the list past the resting place, the points
// of the list's top it covers, the offset it was stepped at, and its quiet
// band: the reports that can turn nothing are kept back while the view
// moves `edge` its `way` (1 deeper, -1 higher, 0 none kept back) and each
// stands within `travel` of it, past the same `rest`, the row `height` tall.
shape ListTabsAt
  shown: bool
  reach: bool
  past: bool
  cover: number
  at: number
  way: number
  edge: number
  travel: number
  rest: number
  height: number

// What the view draws of the pinned row: `ListTabsAt` but the offset, so a
// scroll report that turns nothing draws nothing again.
shape ListTabsShown
  shown: bool
  reach: bool
  past: bool
  cover: number

// Hymn n's title, from the book's titles at their numbers less one.
fn listTitle(titles: string[], n: number): string = match titles.at(n - 1) { case some(t) => t, case none => "" }

// A tab row's `testId` (`<kind>-<n>`), or, for a hymn a group above lists
// too, one that names the group as well (`<kind>-<slug>-<n>`).
fn listRowId(g: TabGroup, n: number, kind: string): string = g.repeats.includes(n) ? `${kind}-${g.slug}-${n}` : `${kind}-${n}`

// The room the list keeps after its last row, as the current app's
// `ListEnd` (src/reader/end.ts `listEndSpace` over src/player/bar.ts
// `findRoom`): from the list's foot up to the `#`'s top, then `END_ROOM`
// past it, so the last row scrolls clear of the find bar. With no player
// the `#` docks `lift` over the bottom inset; with the player's bar docked
// the list ends on the bar's room and the `#` stands `gap` over the bar,
// itself over the inset.
fn listEnd(port: FindPort, at: FindPlaces, overBar: bool): number = port.safeAreaBottom + (overBar ? at.gap : at.lift) + at.hash + at.end

members HymnalExact
  state listQuery = ""
  state listTab = "Sections" persist
  state listTop = 0
  state listLand = ""
  resource listRows = hymnRows(find.query, findAboutNow) as shape RowSection[] else empty()
  resource listTabNames = listTabs() as shape string[] else empty()
  resource listTitleOf = listTitles() when listTab != "Sections" as shape string[] else empty()
  resource listGroups = listTabRows(listTab, listTab == "Lists" ? favouriteList : [], listTab == "Lists" ? recentList : []) when listTab != "Sections" as shape TabGroup[] else empty()
  mutation listOpening as shape ListOpening queue then listOpened
  state listTabs = ListTabsShown(shown=false, reach=false, past=false, cover=0)
  state listTabsAt = 0
  state listTabsBand = ListTabsAt(shown=false, reach=false, past=false, cover=0, at=0, way=0, edge=0, travel=0, rest=0, height=0)
  state listTabsEdge = 0
  mutation listTabsMoved as shape ListTabsAt queue then listTabsTook
  action listTabsReport(y: number, rest: number, height: number)
    listTabsAt = y
    let b = listTabsBand
    let moved = b.way > 0 ? max(listTabsEdge, y) : min(listTabsEdge, y)
    if b.way != 0 and y > b.rest and rest == b.rest and height == b.height and (moved - y) * b.way < b.travel
      listTabsEdge = moved
    else
      send listTabsMoved = listTabsStep("scroll", y, rest, height, listTabsEdge)
  action listTabsJump
    send listTabsMoved = listTabsStep("here", listTabsAt, 0, 0, listTabsEdge)
  action listTabsTouch
    send listTabsMoved = listTabsStep("touch", listTabsAt, 0, 0, listTabsEdge)
  action listTabsTook
    match listTabsMoved
      case some(t)
        listTabsAt = t.at
        listTabsBand = t
        listTabsEdge = t.edge
        let drawn = ListTabsShown(shown=t.shown, reach=t.reach, past=t.past, cover=t.cover)
        if drawn != listTabs
          listTabs = drawn
      case none
        listTabsAt = listTabsAt
  action listChoose(name: string)
    if settingsFeel
      if name != listTab
        haptic("selection")
    if name != listTab
      send listTabsMoved = listTabsStep("jump", 0, 0, 0, listTabsEdge)
      scrollIntoView("list-top", block="start", behavior="instant")
      scrollIntoView(`tab-${name.toLowerCase()}`, block="nearest", inline="nearest", behavior="instant")
      scrollIntoView(`shown-tab-${name.toLowerCase()}`, block="nearest", inline="nearest", behavior="instant")
    listTab = name
  action listLanded(id: string, w: number, h: number)
    if h > 0
      listLand = ""
      listTabsJump()
      scrollIntoView(id, block="start", behavior="instant")
  action listRested
    listTop = max(0, frame("hymn-list").y - frame("list-top").y)
  action listOpen(n: number)
    send listOpening = listOpening(top(nav).url, n)
  action listOpened
    match listOpening
      case some(o)
        if o.how == "push"
          nav = push(nav, o.path)
        else if o.how == "replace"
          nav = replace(nav, o.path)
      case none
        nav = nav

component HymnList
  props
    entry: Entry
    query: string
    sections: RowSection[]
    tab: string
    tabs: string[]
    choose: action
    groups: TabGroup[]
    titles: string[]
    recent: RecentView
    favourites: number[]
    open: action
  inject
    findShown: FindView
    findWheel: action
    listRested: action
    listLand: string
    listTabs: ListTabsShown
    listTabsReport: action
    listTabsTouch: action
  state listHead = 0
  state listPull = 0
  state listPin = 0
  state listTabsHigh = 0
  derive listShift = listHead + listPull
  action listHeaded(w: number, h: number)
    listHead = h
  action listTabsSized(w: number, h: number)
    if h > 0 and h != listTabsHigh
      listTabsHigh = h
  action listScrolled(x: number, y: number)
    let s = max(0, 0 - y)
    if s != listPull
      listPull = s
    listTabsReport(y, listHead - listTabsHigh, listTabsHigh)
  action listWheeled(e: WheelEvent)
    listTabsTouch()
    findWheel(e)
  action listPinned(w: number, h: number)
    if h > 0 and h != listPin
      listPin = h
  view
    column navigationKey=`${entry.id}` navigationBar="none" navigationScroll="hymn-list" position="absolute" inset=0
      -exact-safe-area="top" padding-top="var(--exact-safe-area-inset-top)"
      display="flex" flex-direction="column" background-color="ground"
      if findShown.homeTiles
        HomeTitle(own=false)
        FindTiles()
      if findShown.results and findSearchingAt(findShown, entry.url)
        HomeTitle(own=true)
        HomeTabs(tab=tab, tabs=tabs, choose=choose, pinned=false, away=false)
        column flex="none" testId="home-searching"
      else if tab == "Sections"
        scroll id="hymn-list" flex=1 min-height=0 display=(findShown.homeTiles ? "none" : "flex") flex-direction="column" background-color="ground" wheel=listWheeled pointerdown=listTabsTouch scroll=listScrolled scrollend=listRested scroll-padding-top=`${listPin + listTabs.cover}px` testId="hymn-list"
          column id="list-top" flex-shrink=0 resize=listHeaded testId="list-head"
            HomeTitle(own=true)
            HomeTabs(tab=tab, tabs=tabs, choose=choose, pinned=false, away=listTabs.reach)
          if recent.shelf.length > 0
            section testId="recent-shelf"
              link href=path("recent") aria-label="Recent, see all" display="flex" flex-direction="row" align-items="center" justify-content="space-between"
                padding-left="space.s16" padding-right="space.s16" padding-top="space.s8" padding-bottom="space.s8" margin-right="size.target"
                position="relative" background-color="ground" testId="recent-all"
                text "Recent" font="type.topic" color="muted" line-clamp=1 position="relative" top="nudge.topic" testId="recent-header"
                text "See all ›" font="type.see-all" color="accent" line-clamp=1
                column position="absolute" left=0 right=0 bottom=0 height="line.hair" background-color="line"
              for r in recent.shelf key=r.number
                HymnRow(number=r.number, title=r.title, id=`shelf-${r.number}`, star=(favourites.includes(r.number) ? `shelf-star-${r.number}` : ""), gutter=true)
          for s, si in sections key=s.slug
            section display="flex" flex-direction="column"
              ListHeader(name=s.name, id=`section-${s.slug}`, gutter=true, measured=(si == 0), landing=false, sized=listPinned)
              for r in s.rows key=r.number
                HymnRow(number=r.number, title=r.title, id=`hymn-${r.number}`, star=(favourites.includes(r.number) ? `star-${r.number}` : ""), gutter=true)
          ListEnd()
        if not findShown.homeTiles
          ListRail(shift=listShift)
      else if groups.length == 0 and tab == "Lists"
        column flex=1 min-height=0 display=(findShown.homeTiles ? "none" : "flex") flex-direction="column" background-color="ground" testId="hymn-list"
          HomeTitle(own=true)
          HomeTabs(tab=tab, tabs=tabs, choose=choose, pinned=false, away=false)
          text "No hymns here yet." font="type.body" color="muted" padding="space.s16" testId="lists-empty"
      else
        scroll id="hymn-list" flex=1 min-height=0 display=(findShown.homeTiles ? "none" : "flex") flex-direction="column" background-color="ground" wheel=listWheeled pointerdown=listTabsTouch scroll=listScrolled scrollend=listRested scroll-padding-top=`${listPin + listTabs.cover}px` testId="hymn-list"
          column id="list-top" flex-shrink=0 resize=listHeaded testId="list-head"
            HomeTitle(own=true)
            HomeTabs(tab=tab, tabs=tabs, choose=choose, pinned=false, away=listTabs.reach)
          for g, gi in groups key=g.slug
            section display="flex" flex-direction="column"
              ListHeader(name=g.name, id=`group-${g.slug}`, gutter=false, measured=(gi == 0), landing=(g.name == listLand), sized=listPinned)
              for n in g.numbers key=n
                HymnRow(number=n, title=listTitle(titles, n), id=listRowId(g, n, "hymn"), star=(favourites.includes(n) ? listRowId(g, n, "star") : ""), gutter=false)
          ListEnd()
      if not findShown.homeTiles and not (findShown.results and findSearchingAt(findShown, entry.url)) and (tab == "Sections" or groups.length > 0 or tab != "Lists")
        ListTabsPinned(tab=tab, tabs=tabs, choose=choose, sized=listTabsSized)
      column position="absolute" top=0 left=0 right=0 height="var(--exact-safe-area-inset-top)" background-color="ground" aria-hidden=true testId="status-scrim"
      FindBar(entry=entry, results=true)
      PlayerBarRoom(id="bar-room")

// The list's end room (`listEnd`), past its last row: no row or hairline
// of its own, unseen, taking no touch.
component ListEnd
  inject
    playerShown: PlayerView
  resource listEndPort = exactViewport() as shape FindPort
  resource listEndPlaces = findPlaces() as shape FindPlaces
  view
    column flex="none" height=`${listEnd(listEndPort, listEndPlaces, playerShown.dock or playerShown.pageBar)}px` pointer-events="none" aria-hidden=true testId="list-end"

// Home's title row, as the current app's: "Hymns" and the Settings gear.
// It scrolls away with the list, as the current app's list header does;
// over All at once it stands alone above the tiles (`own` false: its
// copy in the hidden list keeps the ids).
component HomeTitle
  props
    own: bool
  inject
    settingsGear: action
  view
    row align-items="center" padding-left="space.s16" padding-right="space.s8" flex-shrink=0 testId=(own ? "title-row" : "tiles-title-row")
      text "Hymns" role="heading" aria-level=1 flex=1 min-width=0 padding-top="space.s4" padding-bottom="space.s4" position="relative" top="nudge.title" font="type.large-title" color="ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId=(own ? "title" : "tiles-title")
      button press=settingsGear aria-label="Settings" appearance="none" width="size.target" height="size.target" display="flex" align-items="center" justify-content="center"
        border-radius="radius.pill" -exact-press-opacity="opacity.pressed" flex-shrink=0 testId=(own ? "gear" : "tiles-gear")
        image "symbol:settings" width="nudge.gear" height="nudge.gear" position="relative" left="nudge.gear-left" object-fit="contain" color="accent"

// Home's tab row, as the current app's: a pill for each way to show the
// hymns, the chosen one filled; it scrolls away with the list. The
// `pinned` copy (`ListTabsPinned`) names its row and tabs `shown-…`, so
// each copy's ids stay its own. The list's own row is `away` (inert and
// hidden from the screen reader) while the pinned copy is in reach, so
// one tab row, never two, is reachable at any offset.
component HomeTabs
  props
    tab: string
    tabs: string[]
    choose: action
    pinned: bool
    away: bool
  view
    row role="tablist" aria-label="Show hymns by" appearance="none" overflow-x="auto" flex-shrink=0 gap="space.s8" inert=away aria-hidden=away
      padding-left="space.s16" padding-right="space.s16" padding-top="space.s8" padding-bottom="space.s8" testId=(pinned ? "shown-tabs-row" : "tabs")
      for t in tabs key=t
        button role="tab" aria-selected=(tab == t) press=choose(t) appearance="none" flex-shrink=0
          padding-left="space.s12" padding-right="space.s12" padding-top="space.s6" padding-bottom="space.s6" border-radius="radius.r16"
          background-color=(tab == t ? "selected" : "transparent") -exact-press-opacity="opacity.pressed"
          id=(pinned ? `shown-tab-${t.toLowerCase()}` : `tab-${t.toLowerCase()}`) testId=(pinned ? `shown-tab-${t.toLowerCase()}` : `tab-${t.toLowerCase()}`)
          text t font="type.topic" color=(tab == t ? "ink" : "accent") line-clamp=1 white-space="nowrap" position="relative" top="nudge.tab"

// The tab row pinned over the list's top, under the status bar, as the
// current app's PinnedTabs: a layer over the list, clipped to the row's
// height, whose row slides down into it as the row turns shown and back up
// out of it as it turns hidden (`listTabs.shown`), and with Reduce Motion
// fades in place instead, its box never moving. At or above the resting
// place it is out of sight at once (`listTabs.past`), as the list's own row
// stands there. Touches and the screen reader reach it exactly while the
// current `inReach` says (`listTabs.reach`); else it is inert and hidden. A
// tap on a tab chooses it as the list's own row does. Its height, as laid
// out, goes to `sized`: the room it covers.
component ListTabsPinned
  props
    tab: string
    tabs: string[]
    choose: action
    sized: action
  inject
    listTabs: ListTabsShown
    motionStill: bool
  view
    column position="absolute" top="var(--exact-safe-area-inset-top)" left=0 right=0 z-index=2 overflow="hidden"
      opacity=(listTabs.past ? 1 : 0) inert=(not listTabs.reach) aria-hidden=(not listTabs.reach) pointer-events=(listTabs.reach ? "auto" : "none")
      resize=sized testId="shown-tabs"
      column background-color="ground" translate=(motionStill or listTabs.shown ? "0px 0px" : "0px -100%") opacity=(motionStill and not listTabs.shown ? 0 : 1)
        transition=(motionStill ? "opacity duration.fade linear" : "translate duration.slide easing.slide") testId="shown-tabs-slide"
        HomeTabs(tab=tab, tabs=tabs, choose=choose, pinned=true, away=false)

// A group's header, as the current app's topic row: its name, quiet, on
// the ground over a hairline, as tall as its text's line and its padding
// at every text size. It stays at the list's top, under the pinned tab row
// while that shows (`listTabs.cover`), while its group's rows scroll under it, until the next group's header pushes it off, as the
// current app's pinned topic does. With `gutter` it ends before the
// Sections list's rail gutter, as every row of that list does. A tap on
// it zooms out to All at once, as the current app's group row does
// (HymnList.native.tsx `GroupHeader`); VoiceOver reads its name as a
// heading, with the current app's hint, and its activation presses the
// row: a heading on iOS is a `text`'s role, never a button's. Its `id`
// names its group to the point under the list's top that All at once
// opens at (`findAimAtTop`), pinned there or not. The `measured` one, the list's first, gives
// its height, as laid out, to `sized`: the room the list keeps over a row
// it scrolls to. One header measures, not each: each measure that
// changes `listPin` draws the whole list again. The `landing` one, the
// group About this hymn asked for (`listLand`), takes the list to itself
// once it is laid out, its header at the list's top (`listLanded`): what
// it scrolls into view is a mark at its foot, which the list's room over
// a row (`listPin`, the header's height) lands just under the top. The
// mark is a point wide and tall (`line.panel`, the brand's one point):
// iOS never lays out a node of no size, so a scroll to one goes nowhere.
component ListHeader
  props
    name: string
    id: string
    gutter: bool
    measured: bool
    landing: bool
    sized: action
  inject
    findPress: action
    listLanded: action
    listTabs: ListTabsShown
  view
    column id=id press=findPress("tilesShow", 0)
      display="flex" flex-direction="column" align-self="stretch" padding=0
      position="sticky" top=`${listTabs.cover}px` z-index=1 margin-right=(gutter ? "size.target" : "0px") background-color="ground" testId=`${id}-row`
      :active
        background-color="soft"
      row align-items="center" padding-left="space.s16" padding-right="space.s16" padding-top="space.s8" padding-bottom="space.s8" position="relative"
        text name role="heading" aria-description="Shows every group at once" font="type.topic" color="muted" line-clamp=1 position="relative" top="nudge.topic" testId=id
        column position="absolute" left=0 right=0 bottom=0 height="line.hair" background-color="line"
      if measured
        column position="absolute" inset=0 pointer-events="none" aria-hidden=true resize=sized
      column id=`${id}-land` position="absolute" top="100%" left=0 width="line.panel" height="line.panel" pointer-events="none" aria-hidden=true
      if landing
        column position="absolute" inset=0 pointer-events="none" aria-hidden=true resize=listLanded(`${id}-land`)

// The Sections list's rail (features/rail.contract), its foot `end` past
// the find bar's top (`findFoot`, wherever the bar rides, over the player's
// bar too), as the current app's rail ends at its list's `ListEnd` room.
component ListRail
  props
    shift: number
  inject
    playerShown: PlayerView
  resource listRailPort = exactViewport() as shape FindPort
  resource listRailPlaces = findPlaces() as shape FindPlaces
  view
    HomeRail(shift=shift, end=findFoot(listRailPort, listRailPlaces, playerShown.dock or playerShown.pageBar, playerShown.dock ? playerShown.bar.rise : 0) + listRailPlaces.hash + listRailPlaces.end)

// A hymn's row, as the current app's: its number in the accent, then its
// title, and a star at the row's end when it is a favourite; a hairline
// under it from the title's edge; as tall as its line and its padding at
// every text size, as the current app's row grows; a press opens the hymn. `id` is the
// row's `testId` and `star` its star's, each unique on its screen; no star
// when `star` is "". With `gutter` the row ends before the Sections list's
// rail gutter.
component HymnRow
  props
    number: number
    title: string
    id: string
    star: string
    gutter: bool
  view
    link href=path("hymn", `${number}`) display="flex" flex-direction="row" align-items="center" gap="space.s12"
      padding-left="space.s16" padding-right="space.s16" padding-top="space.s11" padding-bottom="space.s11"
      margin-right=(gutter ? "size.target" : "0px") border-bottom="none" position="relative" background-color="ground" id=id testId=id
      :active
        background-color="soft"
      text `${number}` font="type.row-number" font-variant-numeric="tabular-nums" text-align="right" min-width="size.button" flex="none" color="accent" line-clamp=1 position="relative" top="nudge.number"
      row flex=1 min-width=0 align-items="center" gap="space.s12" position="relative" top="nudge.row"
        text title flex=1 min-width=0 font="type.row-title" color="ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        if star != ""
          text "★" font="type.row-title" color="accent" aria-label="Favourite" testId=star
      column position="absolute" left="space.s64" right=0 bottom=0 height="line.hair" background-color="line"
