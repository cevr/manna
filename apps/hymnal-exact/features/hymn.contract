// A hymn's page, pushed over the list: its words in the order they are sung,
// each stanza under its number and the refrain written out each time it is
// sung (app.ts `hymnPage`, src/hymn/page.ts).
use EmptyState from "exact:content"

shape HymnPart
  key: string
  label: string
  text: string

shape HymnText
  number: number
  title: string
  topic: string
  parts: HymnPart[]

members HymnalExact
  derive hymnOpen = match stack(nav).filter(e => e.name == "hymn").at(-1) { case some(e) => e.params.n, case none => "" }
  resource hymnShown = hymnPage(hymnOpen) when hymnOpen != "" as shape HymnText

component HymnPage
  props
    entry: Entry
    page: HymnText
  view
    column navigationKey=`${entry.id}` navigationScroll="hymn-words" position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center" padding="8px 16px"
        text (page.number == 0 ? "No Such Hymn" : page.title) role="heading" aria-level=2 testId="hymn-title"
        if page.number != 0
          text `${page.number} · ${page.topic}`
      if page.number == 0
        EmptyState(symbol="symbol:alert", title="No Such Hymn", message="The hymnal has 695 hymns.")
      else
        scroll id="hymn-words" flex=1 min-height=0
          column padding=16 gap=20
            for p in page.parts key=p.key
              column gap=4
                text p.label font="-exact-headline" color="-exact-secondary-label"
                text p.text testId=p.key
