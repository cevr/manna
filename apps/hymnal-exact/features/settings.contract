// Settings: the gear in the list's title row opens it as a sheet over the
// book. Appearance first (System, Light, Dark), then one row per feature that
// has a setting, then About, pushed in the sheet. The choice is kept across
// launches and applied to the whole app at once through the host's scheme
// (src/look/look.ts holds its rules to the current hymnal's).
shape SettingsLook
  value: string
  label: string
  chosen: bool
  divided: bool

shape SettingsMedia
  prefersColorScheme: string
  prefersReducedMotion: bool

shape SettingsFeel
  on: bool

// `settingsScheme` is the scheme the root is drawn in from the first frame,
// as `shownOf` says: the kept choice is read before it, so a kept Dark never
// paints light first; `setScheme` takes the platform's own (sheets, bars).
// Sounds and haptics is on until the reader turns it off, kept as its
// word (`settingsFeelKept`, "on" or "off") and read by `feelOf`
// (src/settings/feel.ts); every `haptic` of the app plays only under it.
members HymnalExact
  state settingsLook = "system" persist
  state settingsFeelKept = "on" persist
  resource settingsLooks = settingsLooks(settingsLook) as shape SettingsLook[] else empty()
  resource settingsMedia = exactViewport() as shape SettingsMedia
  resource settingsFelt = settingsFeelOf(settingsFeelKept) as shape SettingsFeel else empty(on=true)
  derive settingsFeel = settingsFelt.on
  derive settingsScheme = settingsLook == "dark" or settingsLook == "light" ? settingsLook : (settingsMedia.prefersColorScheme == "dark" ? "dark" : "light")
  action settingsChoose(look: string)
    settingsLook = look
    if settingsFeel
      haptic("selection")
  action settingsFeelSet(on: bool)
    settingsFeelKept = on ? "on" : "off"
  action settingsApply
    setScheme(settingsLook)
  action settingsOpen
    nav = push(nav, "/settings")
  action settingsClose
    nav = back(nav)
  task settingsKept when settingsLook != "" key=settingsLook
    change(settingsApply)

// The gear: one call line in the list's title row, a button of the iOS
// navigation bar, opening Settings through the root's `settingsGear`.
component SettingsGear
  inject
    settingsGear: action
  view
    button press=settingsGear aria-label="Settings" testId="gear"
      image "symbol:settings"

// A group's heading, as the current hymnal's `Heading`: footnote type in the
// muted role, upper case, set in from the group's edge; `apart` stands it
// off the group above. The hairline above and the nudge below put its glyphs
// and the group under it on the current hymnal's pixels (src/look/tokens.ts,
// NUDGES).
component SettingsHeading
  props
    words: string
    apart: bool
  view
    text words role="heading" aria-level=2 font="type.footnote" color="muted" text-transform="uppercase" margin-left="space.s16" margin-top=(apart ? "space.s16" : 0) padding-top="line.hair" margin-bottom="nudge.settings-heading"

// A row holding a switch, alone in its own group, as the current hymnal's
// `ChordsSwitch` and `FeelSwitch`: the label, then UIKit's switch; `apart`
// stands the group off the one above.
component SettingsSwitchRow
  props
    label: string
    on: bool
    turn: action
    id: string
    apart: bool
  view
    row align-items="center" min-height="size.target" box-sizing="border-box" padding="space.s11 space.s16" margin-top=(apart ? "space.s16" : 0) border-radius="radius.r12" border-width="line.hair" border-style="solid" border-color="line" overflow="hidden"
      text label font="type.body" color="ink" flex=1 min-width=0 margin-top="nudge.settings-body" aria-hidden=true
      input type="checkbox" switch checked=on change=turn aria-label=label testId=id

// Sounds and haptics: a switch, on until the reader turns it off, as the
// current hymnal's `feel`.
component SettingsFeelRow
  inject
    settingsFeel: bool
    settingsFeelSwitch: action
  view
    SettingsSwitchRow(label="Sounds and haptics", on=settingsFeel, turn=settingsFeelSwitch, id="settings-feel", apart=true)

// Chords: whether the chords show, the same setting as the player sheet's
// switch, through the root's `chordsSwitchOn` and `chordsSwitch`.
component SettingsChordsRow
  inject
    chordsSwitchOn: bool
    chordsSwitch: action
  view
    SettingsHeading(words="Chords", apart=true)
    SettingsSwitchRow(label="Chords", on=chordsSwitchOn, turn=chordsSwitch, id="chords-toggle", apart=false)

// The sheet, drawn as the current hymnal's Settings (app/(hymnal)/settings.tsx
// in a form sheet of half and full height with its grabber, src/sheets.ts):
// its own title, Appearance's choices in one hairline group with the chosen
// one ticked, a group a switch, and About, pushed in the sheet, as a row
// with its chevron. Done, which the current hymnal's sheet has not (the
// owner keeps it, q1), sits at the title's trailing end without growing its
// row; a swipe down closes the sheet too.
component SettingsSheet
  props
    entry: Entry
    looks: SettingsLook[]
    choose: action
    done: action
  view
    column navigationKey=`${entry.id}` navigationPresentation="modal" navigationDetent="50% large" navigationGrabber="visible" navigationScroll="settings-list" position="absolute" inset=0 background-color="ground" testId="settings"
      scroll id="settings-list" flex=1 min-height=0
        column gap="space.s8" padding="space.s24 space.s16 space.s16"
          row position="relative" align-items="center" margin-bottom="space.s8" padding-bottom="nudge.settings-title"
            text "Settings" role="heading" aria-level=1 font="type.sheet-title" color="ink" flex=1 min-width=0
            button press=done appearance="none" position="absolute" top=0 bottom=0 right=0 display="flex" align-items="center" justify-content="flex-end" min-width="size.target" -exact-hit-slop="space.s8" testId="settings-done"
              :active
                opacity = "opacity.pressed"
              text "Done" font="type.strong" color="accent"
          SettingsHeading(words="Appearance", apart=false)
          column role="radiogroup" aria-label="Appearance" border-radius="radius.r12" border-width="line.hair" border-style="solid" border-color="line" overflow="hidden"
            for l in looks key=l.value
              button role="radio" aria-label=l.label aria-checked=l.chosen press=choose(l.value) appearance="none" padding=0 border-top-width=(l.divided ? "line.hair" : 0) border-top-style="solid" border-top-color="line" testId=`appearance-${l.value}`
                :active
                  background-color = "soft"
                row flex=1 min-width=0 align-items="center" min-height="size.target" box-sizing="border-box" padding="space.s11 space.s16"
                  text l.label font="type.body" color="ink" flex=1 min-width=0 margin-top="nudge.settings-body" text-align="start" testId=`appearance-${l.value}-label`
                  text (l.chosen ? "✓" : "") font="type.strong" color="accent" aria-hidden=true
          // Each feature with a setting adds its row here, one call line
          // (README.md, "Settings").
          SettingsChordsRow()
          SettingsFeelRow()
          link href=path("about") display="flex" flex-direction="row" align-items="center" min-height="size.target" box-sizing="border-box" padding="space.s11 space.s16" margin-top="space.s16" border-radius="radius.r12" border-width="line.hair" border-style="solid" border-color="line" overflow="hidden" testId="about-row"
            :active
              background-color = "soft"
            text "About" font="type.body" color="ink" flex=1 min-width=0 margin-top="nudge.settings-body"
            text "›" font="type.chevron" color="muted" aria-hidden=true
