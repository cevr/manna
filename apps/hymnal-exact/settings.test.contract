test "The gear opens Settings; Done and Back close it."
  tap "gear"
  clock settle
  clock data
  expect tree has "settings"
  expect text "appearance-system" == "System✓"
  expect text "appearance-system-label" == "System"
  expect text "appearance-light" == "Light"
  expect text "appearance-dark" == "Dark"
  tap "settings-done"
  clock settle
  expect tree missing "settings"
  expect text "title" == "Hymns"
  tap "gear"
  clock settle
  expect tree has "settings"
  back
  clock settle
  expect tree missing "settings"
  expect text "title" == "Hymns"

test "Dark at once, and kept."
  prefer prefers-color-scheme light
  tap "gear"
  clock settle
  clock data
  expect state settingsLooks.0 .chosen == true
  tap "appearance-dark"
  clock settle
  clock data
  expect state settingsLook == "dark"
  expect state settingsLooks.2 .chosen == true
  expect state settingsLooks.0 .chosen == false
  expect text "appearance-dark" == "Dark✓"
  expect text "appearance-system" == "System"
  tap "settings-done"
  clock settle
  reload
  clock data
  clock settle
  expect state settingsLook == "dark"
  tap "gear"
  clock settle
  clock data
  expect state settingsLooks.2 .chosen == true
  tap "appearance-system"
  clock settle
  clock data
  expect state settingsLook == "system"
  expect state settingsLooks.0 .chosen == true

// The relaunch with the store kept is tools/drive-motion.ts's.
test "Sounds and haptics is on, and stays off once turned off"
  tap "gear"
  clock settle
  clock data
  expect tree has "settings-feel"
  expect state settingsFeelKept == "on"
  expect state settingsFeel == true
  tap "settings-feel"
  clock settle
  clock data
  expect state settingsFeelKept == "off"
  expect state settingsFeel == false
  tap "appearance-dark"
  clock settle
  clock data
  expect state settingsFeel == false
  tap "settings-feel"
  clock settle
  clock data
  expect state settingsFeelKept == "on"
  expect state settingsFeel == true

test "About opens from the sheet and Back returns to it."
  tap "gear"
  clock settle
  clock data
  tap "about-row"
  clock settle
  clock data
  expect tree has "about"
  expect text "about-lead" == "The recordings are played from the hymnal's own scores."
  back
  clock settle
  expect tree missing "about"
  expect tree has "settings"
  expect text "appearance-dark" == "Dark"

test "Chord style and Chord placement show only while chords are on, as the current hymnal lists them."
  tap "gear"
  clock settle
  clock data
  expect tree missing "chord-style"
  expect tree missing "chord-placement"
  tap "chords-toggle"
  clock settle
  clock data
  expect tree has "chord-style"
  expect tree has "chord-placement"
  expect state settingsChordRows.style.0 .value == "simple"
  expect state settingsChordRows.style.1 .value == "advanced"
  expect state settingsChordRows.placement.0 .value == "beat"
  expect state settingsChordRows.placement.1 .value == "simpler"
  expect state settingsChordRows.placement.2 .value == "file"
  expect text "chord-style-simple" == "Simple✓"
  expect text "chord-style-advanced" == "Advanced"
  expect text "chord-placement-beat" == "On the beat✓"
  expect text "chord-placement-simpler" == "Simpler"
  expect text "chord-placement-file" == "As the file plays"
  tap "chords-toggle"
  clock settle
  clock data
  expect tree missing "chord-style"
  expect tree missing "chord-placement"

// Hymn 1's thirteenth syllable of its first line is the first place
// Advanced spells a chord other than Simple's (a Bun script over the
// current hymnal's chords: Gm against Gm7 C C7).
test "Advanced changes hymn 1's chords, and is kept."
  tap "gear"
  clock settle
  clock data
  tap "chords-toggle"
  clock settle
  clock data
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  expect text "chord-1-1-13" == "Gm"
  back
  clock settle
  tap "gear"
  clock settle
  clock data
  tap "chord-style-advanced"
  clock settle
  clock data
  expect state settingsChordStyle == "advanced"
  expect text "chord-style-advanced" == "Advanced✓"
  expect text "chord-style-simple" == "Simple"
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  expect text "chord-1-1-13" == "Gm7 C C7"
  reload
  clock data
  clock settle
  expect state settingsChordStyle == "advanced"
  expect text "chord-1-1-13" == "Gm7 C C7"

// As the file plays leaves hymn 1's chords where they are; hymn 31 is the
// first whose drawn chord changes under it (a Bun script over the current
// hymnal's chords: its first line's fifth syllable, G against Em).
test "As the file plays changes hymn 31's chords, and is kept."
  tap "gear"
  clock settle
  clock data
  tap "chords-toggle"
  clock settle
  clock data
  tap "chord-placement-file"
  clock settle
  clock data
  expect state settingsPlacement == "file"
  expect text "chord-placement-file" == "As the file plays✓"
  expect text "chord-placement-beat" == "On the beat"
  tap "settings-done"
  clock settle
  tap "find-search"
  clock settle
  clock data
  type "search" "31"
  clock settle
  clock data
  tap "hymn-31"
  clock settle
  clock data
  expect text "chord-1-1-5" == "Em"
  reload
  clock data
  clock settle
  expect state settingsPlacement == "file"
  expect text "chord-1-1-5" == "Em"
  back
  clock settle
  tap "gear"
  clock settle
  clock data
  tap "chord-placement-beat"
  clock settle
  clock data
  tap "settings-done"
  clock settle
  tap "find-search"
  clock settle
  clock data
  type "search" "31"
  clock settle
  clock data
  tap "hymn-31"
  clock settle
  clock data
  expect text "chord-1-1-5" == "G"
