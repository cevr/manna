test "At the top the pinned tab row is out of reach, and the list's own row is there."
  clock data
  expect tree has "tab-topics"
  expect state listTabs.reach == false
  expect state listTabs.past == false

test "Deep in the list nothing pins; 8 points up pins the row, 8 down sends it away, 7 either way turns nothing, and the list's offset never moves for it."
  tap "hymn-list" wheel 0 2000
  clock settle
  clock data
  expect state listTabsAt == 2000
  expect state listTabs.past == true
  expect state listTabs.shown == false
  tap "hymn-list" wheel 0 -7
  clock settle
  clock data
  expect state listTabsAt == 1993
  expect state listTabs.shown == false
  tap "hymn-list" wheel 0 -1
  clock settle
  clock data
  expect state listTabs.shown == true
  expect state listTabs.reach == true
  expect state listTabs.cover >= 40
  expect tree has "shown-tab-topics"
  expect state listTabsAt == 1992
  clock +500
  clock settle
  clock data
  expect state listTabsAt == 1992
  expect state listTop == 1992
  tap "hymn-list" wheel 0 7
  clock settle
  clock data
  expect state listTabsAt == 1999
  expect state listTabs.shown == true
  tap "hymn-list" wheel 0 1
  clock settle
  clock data
  expect state listTabs.shown == false
  expect state listTabs.reach == false
  expect state listTabs.cover == 0
  clock +500
  clock settle
  clock data
  expect state listTabsAt == 2000
  expect state listTop == 2000

test "Reports made before an answer lands fold in order as the current app's: hidden at 1000, up 8 then down 8 before it lands, the row ends hidden at 1000."
  tap "hymn-list" wheel 0 1000
  clock settle
  clock data
  expect state listTabs.shown == false
  tap "hymn-list" wheel 0 -8
  tap "hymn-list" wheel 0 8
  clock settle
  clock data
  expect state listTabsAt == 1000
  expect state listTabs.shown == false
  expect state listTabs.reach == false

test "Reports made before an answer lands are each folded: up 8 and 2 more before it lands, then down 8 from the highest hides the row, as the current app's."
  tap "hymn-list" wheel 0 1000
  clock settle
  clock data
  tap "hymn-list" wheel 0 -8
  tap "hymn-list" wheel 0 -2
  clock settle
  clock data
  expect state listTabsAt == 990
  expect state listTabs.shown == true
  tap "hymn-list" wheel 0 8
  clock settle
  clock data
  expect state listTabsAt == 998
  expect state listTabs.shown == false

test "Scrolled back to the top the pinned row is gone at once and the list's own row stands where it was."
  tap "hymn-list" wheel 0 2000
  clock settle
  tap "hymn-list" wheel 0 -100
  clock settle
  clock data
  expect state listTabs.shown == true
  tap "hymn-list" wheel 0 -1900
  clock settle
  clock data
  expect state listTabsAt == 0
  expect state listTabs.shown == false
  expect state listTabs.past == false
  expect state listTabs.reach == false
  expect tree has "tab-topics"
  expect state listTop == 0

test "A tap on a pinned tab chooses it as the list's own does: the list lands at its top, and the row is held until a touch."
  tap "hymn-list" wheel 0 2000
  clock settle
  tap "hymn-list" wheel 0 -20
  clock settle
  clock data
  expect state listTabs.reach == true
  tap "shown-tab-topics"
  clock settle
  clock data
  expect state listTab == "Topics"
  expect state listTabsAt == 0
  expect state listTabs.shown == true
  expect state listTabs.reach == false
  expect tree has "tab-topics"
  tap "hymn-list" wheel 0 2000
  clock settle
  clock data
  expect state listTabs.shown == false
  expect state listTabs.reach == false

test "On a group tab the row pins and turns as on Sections, under the group's pinned header."
  tap "tab-metres"
  clock settle
  clock data
  expect state listTab == "Metres"
  tap "hymn-list" wheel 0 3000
  clock settle
  clock data
  expect state listTabs.shown == false
  tap "hymn-list" wheel 0 -8
  clock settle
  clock data
  expect state listTabs.shown == true
  expect state listTabs.reach == true
  expect tree has "shown-tab-scripture"
  expect state listTabsAt == 2992
  tap "shown-tab-scripture"
  clock settle
  clock data
  expect state listTab == "Scripture"
  expect state listTabsAt == 0
  expect state listTabs.reach == false
  tap "hymn-list" wheel 0 3000
  clock settle
  tap "hymn-list" wheel 0 -8
  clock settle
  clock data
  expect state listTabs.reach == true
  expect tree has "shown-tab-sections"

test "On Lists the row pins over its rows, and the empty Lists has none."
  tap "tab-lists"
  clock settle
  clock data
  expect tree has "lists-empty"
  expect state listTabs.reach == false
  tap "tab-sections"
  clock settle
  clock data
  tap "hymn-100"
  clock settle
  clock data
  tap "favourite"
  clock settle
  clock data
  back
  clock settle
  clock data
  tap "hymn-200"
  clock settle
  clock data
  back
  clock settle
  clock data
  tap "tab-lists"
  clock settle
  clock data
  expect tree has "hymn-100"
  expect state listTabsAt == 0
  expect state listTabs.reach == false

test "With the player's bar docked the row pins and turns as without it."
  at "/settings"
  clock settle
  tap "settings-feel"
  clock settle
  expect state settingsFeel == false
  tap "settings-done"
  clock settle
  tap "hymn-1"
  clock settle
  clock data
  expect state player.fixture == true
  tap "play"
  clock data
  back
  clock settle
  clock data
  expect tree has "bar"
  tap "hymn-list" wheel 0 2000
  clock settle
  tap "hymn-list" wheel 0 -8
  clock settle
  clock data
  expect state listTabs.shown == true
  expect state listTabs.reach == true
  expect tree has "shown-tab-topics"
  tap "hymn-list" wheel 0 8
  clock settle
  clock data
  expect state listTabs.shown == false

test "A tile picked moves the list without turning the row: hidden stays hidden on a jump up, until a touch."
  tap "hymn-list" wheel 0 6000
  clock settle
  clock data
  expect state listTabs.shown == false
  expect state listTabs.past == true
  tap "tiles-show"
  clock settle
  clock data
  tap "group-tile-3"
  clock settle
  clock data
  expect tree missing "tiles"
  expect state listTabsAt <= 5900
  expect state listTabsAt >= 100
  expect state listTabs.shown == false
  expect state listTabs.reach == false

test "A tile picked moves the list without turning the row: pinned stays pinned on a jump down, until a touch."
  tap "hymn-list" wheel 0 300
  clock settle
  tap "hymn-list" wheel 0 -20
  clock settle
  clock data
  expect state listTabs.shown == true
  expect state listTabs.reach == true
  tap "tiles-show"
  clock settle
  clock data
  tap "group-tile-3"
  clock settle
  clock data
  expect tree missing "tiles"
  expect state listTabsAt >= 400
  expect state listTabs.shown == true
  expect state listTabs.reach == true
  tap "hymn-list" wheel 0 8
  clock settle
  clock data
  expect state listTabs.shown == false

test "The drums' follow moves the list without turning the row: pinned stays pinned on a jump down."
  tap "hymn-list" wheel 0 300
  clock settle
  tap "hymn-list" wheel 0 -20
  clock settle
  clock data
  expect state listTabs.shown == true
  tap "find-number"
  clock settle
  clock data
  type "drum-hundreds" "3"
  clock data
  clock settle
  expect state findFollowing.row == "hymn-300"
  expect state listTabsAt >= 400
  expect state listTabs.shown == true

test "With Reduce Motion the row turns as without it."
  prefer prefers-reduced-motion reduce
  tap "hymn-list" wheel 0 2000
  clock settle
  tap "hymn-list" wheel 0 -8
  clock settle
  clock data
  expect state motionStill == true
  expect state listTabs.shown == true
  expect tree has "shown-tab-topics"
  tap "hymn-list" wheel 0 8
  clock settle
  clock data
  expect state listTabs.shown == false
