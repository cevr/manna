{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "test:app",
        "test:films",
        "test:library",
        "test:storybook",
        "test:storybook-shots"
      ]
    },
    "test:app": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/.claude/skills/film/**",
        "!src/**/*.test.*"
      ]
    },
    "test:films": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/.claude/skills/film/**",
        "!*.test.*",
        "!src/library/**/*.test.*"
      ]
    },
    "test:library": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/.claude/skills/film/**",
        "!*.test.*",
        "!src/films/**/*.test.*"
      ]
    },
    "test:storybook": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/package.json",
        "!*.test.*",
        "!src/films/**/*.test.*",
        "!src/library/cutout/**/*.test.*",
        "!src/library/toon3d/**/*.test.*",
        "!src/library/cast/**/*.test.*"
      ]
    },
    "test:storybook-shots": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/package.json",
        "!*.test.*",
        "!src/films/**/*.test.*",
        "!src/library/cutout/**/*.test.*",
        "!src/library/toon3d/**/*.test.*",
        "!src/library/cast/**/*.test.*"
      ]
    }
  }
}
