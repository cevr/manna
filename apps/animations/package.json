    "test:storybook-faces": "bun test --parallel --path-ignore-patterns='**/*.slow.test.*' ./src/library/storybook/faces.test.ts",
    "test:storybook-shots": "bun test --parallel --path-ignore-patterns='**/*.slow.test.*' ./src/library/storybook/shots",
    "test:storybook-film": "bun test --parallel --path-ignore-patterns='**/*.slow.test.*' --path-ignore-patterns=src/films/in-its-order/storybook/heads.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/paints.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/proportions.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/mother.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/measured.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/strays.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/blinks.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/holds.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/resources.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/resources-close.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/resources-title.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/resources-milk.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/covers-baby.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/covers-letter.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/covers-ouch.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/covers-title.test.ts --path-ignore-patterns=src/films/in-its-order/storybook/covers-milk.test.ts ./src/films/in-its-order/storybook",
    "test:storybook-heads": "bun test --parallel ./src/films/in-its-order/storybook/heads.test.ts",
    "test:storybook-paints": "bun test --parallel ./src/films/in-its-order/storybook/paints.test.ts ./src/films/in-its-order/storybook/proportions.test.ts ./src/films/in-its-order/storybook/mother.test.ts",
    "test:storybook-measured": "bun test --parallel ./src/films/in-its-order/storybook/measured.test.ts",
    "test:storybook-strays": "bun test --parallel ./src/films/in-its-order/storybook/strays.test.ts",
    "test:storybook-resources": "bun test --parallel ./src/films/in-its-order/storybook/resources.test.ts",
    "test:storybook-resources-close": "bun test --parallel ./src/films/in-its-order/storybook/resources-close.test.ts",
    "test:storybook-resources-title": "bun test --parallel ./src/films/in-its-order/storybook/resources-title.test.ts",
    "test:storybook-resources-milk": "bun test --parallel ./src/films/in-its-order/storybook/resources-milk.test.ts",
    "test:storybook-blinks": "bun test --parallel ./src/films/in-its-order/storybook/blinks.test.ts ./src/films/in-its-order/storybook/holds.test.ts",
    "test:storybook-covers-table": "bun test --parallel ./src/films/in-its-order/storybook/covers-baby.test.ts ./src/films/in-its-order/storybook/covers-letter.test.ts",
    "test:storybook-covers-ouch": "bun test --parallel ./src/films/in-its-order/storybook/covers-ouch.test.ts",
    "test:storybook-covers-rest": "bun test --parallel ./src/films/in-its-order/storybook/covers-title.test.ts ./src/films/in-its-order/storybook/covers-milk.test.ts",
    "test:slow": "bun test .slow.test."
