    "test:films": "bun test --parallel --path-ignore-patterns='**/*.slow.test.*' ./src/films/righteousness-by-faith/rigs ./src/films/in-its-order/rigs",
    "test:library": "bun test --parallel --path-ignore-patterns='**/*.slow.test.*' ./src/library/cutout ./src/library/toon3d ./src/library/cast/filler-bases/cutout/crowd.test.ts",
    "test:storybook": "bun test --parallel --path-ignore-patterns='**/*.slow.test.*' ./src/library/storybook/sheet.test.ts ./src/library/storybook/shot.test.ts ./src/library/storybook/store.test.ts ./src/library/storybook/verify",
    "test:storybook-lines": "bun test --parallel --path-ignore-patterns='**/*.slow.test.*' ./src/library/storybook/lines.test.ts",
