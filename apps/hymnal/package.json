    "test:offline": "bun scripts/slow.ts test:slow:offline test:slow:http",
    "test:slow": "bun scripts/slow.ts test:slow: test:browser",
    "test:slow:shared": "bun test --preload ./src/test/setup.ts ./src/feel/feel.slow.test.tsx ./src/player/stanzas.choice.slow.test.ts ./src/player/stanzas.skipper.slow.test.ts ./src/follow/countin.slow.test.tsx ./src/follow/countline.slow.test.tsx ./src/player/countin.play.slow.test.ts ./src/player/bar.property.slow.test.tsx ./src/player/ui.slow.test.tsx ./src/player/thumb.slow.test.tsx ./src/player/wrap.property.slow.test.tsx ./src/player/seektap.property.slow.test.tsx ./src/player/world.property.slow.test.ts ./src/player/keyplay.slow.test.ts ./src/player/playswap.slow.test.ts ./src/player/tempos.switch.slow.test.ts ./src/hymns/search.property.slow.test.ts ./src/reader/HymnList.native.slow.test.ts ./src/reader/pager.slow.test.ts ./src/reader/reader.slow.test.tsx ./src/reader/chordtap.slow.test.tsx ./src/reader/reading.slow.test.tsx ./src/tuner/pitch.property.slow.test.ts",
    "test:slow:placement": "bun test --preload ./src/test/setup.ts ./src/player/placement.slow.test.tsx",
    "test:slow:follow": "bun test --preload ./src/test/setup.ts ./src/follow/follow.slow.test.tsx",
    "test:slow:wordlight": "bun test --preload ./src/test/setup.ts ./src/follow/wordlight.acceptance.slow.test.tsx",
