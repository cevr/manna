    "test:slow:redraw": "bun test --preload ./src/test/setup.ts ./src/player/redraw.slow.test.tsx",
    "test:slow:chordmode": "bun test --preload ./src/test/setup.ts ./src/player/chordmode.slow.test.tsx",
    "test:slow:numreplace": "bun test --preload ./src/test/setup.ts ./src/home/numreplace.slow.test.tsx",
    "test:slow:findglide": "bun test --preload ./src/test/setup.ts ./src/home/findglide.slow.test.tsx",
    "test:slow:findplace": "bun test --preload ./src/test/setup.ts ./src/home/findplace.render.slow.test.tsx",
    "test:slow:opening": "bun test --preload ./src/test/setup.ts ./src/home/opening.stack.slow.test.ts",
    "test:slow:focus": "bun test --preload ./src/test/setup.ts ./src/tuner/focus.property.slow.test.ts ./src/tuner/focus.screen.slow.test.tsx",
    "test:slow:infra": "bun test ./infra/audio/adapters.slow.test.ts ./scripts/follow.slow.test.ts",
    "test:slow:seek-targets": "bun test --parallel=3 --preload ./src/test/setup.ts ./src/follow/seek-targets.property.slow.test.ts",
    "test:slow:player-word-seek": "bun test --parallel=3 --preload ./src/test/setup.ts ./src/player/word-seek.property.slow.test.tsx",
    "test:slow:reader-word-seek": "bun test --parallel=3 --preload ./src/test/setup.ts ./src/reader/word-seek.property.slow.test.tsx",
    "test:slow:journeys": "bun test ./src/test/journeys.slow.test.ts",
    "test:slow:offline": "bun test --preload ./src/test/setup.ts ./src/offline/cache.slow.test.ts ./src/offline/repairs.slow.test.ts ./src/player/offline.slow.test.ts",
    "test:slow:http": "bun test ./src/offline/http.slow.test.ts",
    "icon": "bun scripts/icon.ts",
    "sim": "bun scripts/sim.ts",
    "follow": "bun scripts/follow.ts",
    "plan": "alchemy plan alchemy.run.ts --stage prod",
    "deploy": "turbo run test:slow --filter=@manna/hymnal-app && alchemy deploy alchemy.run.ts --stage prod",
    "audio:copy": "bun infra/audio/copy.ts",
    "audio:stream": "bun infra/audio/stream.ts",
    "audio:upload": "bun infra/audio/upload.ts"
  },
