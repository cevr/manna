  "scripts": {
    "postinstall": "one patch || true",
    "dev": "one dev",
    "ios": "one run:ios",
    "android": "one run:android",
    "build": "one build",
    "prebuild:native": "one prebuild",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo && tsc --noEmit -p tsconfig.test.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/test.tsbuildinfo && tsc --noEmit -p tsconfig.infra.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/infra.tsbuildinfo",
    "test:search": "bun test --no-isolate --parallel=3 --preload ./src/test/setup.ts --path-ignore-patterns='**/*.slow.test.*' ./src/home/Search.test.tsx ./src/home/pinch.test.tsx ./src/home/zoom.test.tsx ./src/home/reveal.test.ts",
    "test:find": "bun test --no-isolate --parallel=3 --preload ./src/test/setup.ts --path-ignore-patterns='**/*.slow.test.*' ./src/home/findlook.test.tsx ./src/home/FindBar.test.tsx ./src/home/findglass.test.tsx ./src/home/finding.test.ts",
    "test:home": "bun test --no-isolate --parallel=3 --preload ./src/test/setup.ts --path-ignore-patterns='**/*.slow.test.*' --path-ignore-patterns=src/home/Search.test.tsx --path-ignore-patterns=src/home/pinch.test.tsx --path-ignore-patterns=src/home/zoom.test.tsx --path-ignore-patterns=src/home/findlook.test.tsx --path-ignore-patterns=src/home/FindBar.test.tsx --path-ignore-patterns=src/home/findglass.test.tsx --path-ignore-patterns=src/home/finding.test.ts --path-ignore-patterns=src/home/reveal.test.ts ./src/home",
    "test:tempo": "bun test --no-isolate --parallel=3 --preload ./src/test/setup.ts --path-ignore-patterns='**/*.slow.test.*' ./src/player/TempoDial.reset.test.tsx ./src/player/TempoDial.tap.test.tsx ./src/player/tempo.test.ts ./src/player/tempo.beat.test.ts ./src/player/dial.test.ts ./src/player/find.test.tsx ./src/player/finddrums.open.test.tsx ./src/player/drums.test.ts ./src/player/findplace.property.test.ts ./src/player/findplace.static.test.ts ./src/player/glide.test.ts ./src/player/bar.test.ts ./src/player/button.test.ts ./src/player/title.test.ts",
    "test:player": "bun test --no-isolate --parallel=3 --preload ./src/test/setup.ts --path-ignore-patterns='**/*.slow.test.*' --path-ignore-patterns=src/player/TempoDial.reset.test.tsx --path-ignore-patterns=src/player/TempoDial.tap.test.tsx --path-ignore-patterns=src/player/tempo.test.ts --path-ignore-patterns=src/player/tempo.beat.test.ts --path-ignore-patterns=src/player/dial.test.ts --path-ignore-patterns=src/player/find.test.tsx --path-ignore-patterns=src/player/finddrums.open.test.tsx --path-ignore-patterns=src/player/drums.test.ts --path-ignore-patterns=src/player/findplace.property.test.ts --path-ignore-patterns=src/player/findplace.static.test.ts --path-ignore-patterns=src/player/glide.test.ts --path-ignore-patterns=src/player/bar.test.ts --path-ignore-patterns=src/player/button.test.ts --path-ignore-patterns=src/player/title.test.ts --path-ignore-patterns=src/player/tunerbar.test.tsx --path-ignore-patterns=src/player/tunerbar.wheel.test.tsx --path-ignore-patterns=src/player/tunerbar.motion.test.tsx ./src/player",
    "test:bar": "bun test --no-isolate --parallel=3 --preload ./src/test/setup.ts --path-ignore-patterns='**/*.slow.test.*' ./src/player/tunerbar.test.tsx ./src/player/tunerbar.wheel.test.tsx ./src/player/tunerbar.motion.test.tsx",
    "test:reader": "bun test --no-isolate --parallel=3 --preload ./src/test/setup.ts --path-ignore-patterns='**/*.slow.test.*' --path-ignore-patterns=src/reader/word-seek.test.ts --path-ignore-patterns=src/reader/WordSeek.test.tsx --path-ignore-patterns=src/reader/WordSeek.web.test.tsx ./src/reader",
    "test:seek": "bun test --no-isolate --parallel=3 --preload ./src/test/setup.ts --path-ignore-patterns='**/*.slow.test.*' ./src/reader/word-seek.test.ts ./src/reader/WordSeek.test.tsx ./src/reader/WordSeek.web.test.tsx",
    "test:follow": "bun test --no-isolate --parallel=3 --preload ./src/test/setup.ts --path-ignore-patterns='**/*.slow.test.*' ./src/follow",
    "test:hymns": "bun test --no-isolate --parallel=3 --preload ./src/test/setup.ts --path-ignore-patterns='**/*.slow.test.*' ./src/hymns",
