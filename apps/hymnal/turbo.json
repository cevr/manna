{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/packages/hymnal/src/**",
        "$TURBO_ROOT$/packages/hymnal/data/sdah-1985/**",
        "$TURBO_ROOT$/packages/hymnal/data/playback/**",
        "$TURBO_ROOT$/packages/hymnal/scripts/playback.ts"
      ],
      "outputs": ["dist/**"]
    },
    "test:search": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "!src/home/{back,home,open,opening,playing,PinnedTabs,settings,settings.chordmode,TabRow,tabs}.test.*",
        "!src/player/**/*.test.*",
        "!src/reader/**/*.test.*",
        "!src/follow/**/*.test.*",
        "!src/hymns/**/*.test.*",
        "!src/{tuner,feel,offline,test}/**/*.test.*",
        "!src/*.test.*",
        "!{infra,scripts,vite}/**/*.test.*"
      ]
    },
    "test:home": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "!src/home/{Search,pinch,zoom,findlook,FindBar,findglass,finding,reveal}.test.*",
        "!src/player/**/*.test.*",
        "!src/reader/**/*.test.*",
        "!src/follow/**/*.test.*",
        "!src/hymns/**/*.test.*",
        "!src/{tuner,feel,offline,test}/**/*.test.*",
        "!src/*.test.*",
        "!{infra,scripts,vite}/**/*.test.*"
      ]
    },
    "test:tempo": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "!src/home/**/*.test.*",
        "!src/player/{countin.lockplay,countin,keyplay,page,playback.live.rate,playback.live,player,scrub,scrubber.ios,sound.rate,sound,stanzas.play,stanzas,thumb,thumb.chordmode,tunerbar,buttonrole,wheel.property,word-seek}.test.*",
        "!src/reader/**/*.test.*",
        "!src/follow/**/*.test.*",
        "!src/hymns/**/*.test.*",
        "!src/{tuner,feel,offline,test}/**/*.test.*",
        "!src/*.test.*",
        "!{infra,scripts,vite}/**/*.test.*"
      ]
    },
    "test:player": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "!src/home/**/*.test.*",
        "!src/player/{TempoDial.reset,TempoDial.tap,tempo,tempo.beat,dial,find,finddrums.open,drums,findplace.property,findplace.static,glide,bar,button,title,tunerbar,buttonrole}.test.*",
        "!src/reader/**/*.test.*",
        "!src/follow/**/*.test.*",
        "!src/hymns/**/*.test.*",
        "!src/{tuner,feel,offline,test}/**/*.test.*",
        "!src/*.test.*",
        "!{infra,scripts,vite}/**/*.test.*"
      ]
    },
    "test:bar": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "!src/home/**/*.test.*",
        "!src/player/{TempoDial.reset,TempoDial.tap,tempo,tempo.beat,dial,find,finddrums.open,drums,findplace.property,findplace.static,glide,bar,button,title,countin.lockplay,countin,keyplay,page,playback.live.rate,playback.live,player,scrub,scrubber.ios,sound.rate,sound,stanzas.play,stanzas,thumb,thumb.chordmode,wheel.property,word-seek}.test.*",
        "!src/reader/**/*.test.*",
        "!src/follow/**/*.test.*",
        "!src/hymns/**/*.test.*",
        "!src/{tuner,feel,offline,test}/**/*.test.*",
        "!src/*.test.*",
        "!{infra,scripts,vite}/**/*.test.*"
      ]
    },
    "test:reader": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "!src/reader/{word-seek,WordSeek}.test.*",
        "!src/home/**/*.test.*",
        "!src/player/**/*.test.*",
        "!src/follow/**/*.test.*",
        "!src/hymns/**/*.test.*",
        "!src/{tuner,feel,offline,test}/**/*.test.*",
        "!src/*.test.*",
        "!{infra,scripts,vite}/**/*.test.*"
      ]
    },
    "test:seek": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "!src/reader/{About,SyllableWords,back,end,header,line-level,lists,pager,pin,place,rail-marks,reading,rows}.test.*",
        "!src/home/**/*.test.*",
        "!src/player/**/*.test.*",
        "!src/follow/**/*.test.*",
        "!src/hymns/**/*.test.*",
        "!src/{tuner,feel,offline,test}/**/*.test.*",
        "!src/*.test.*",
        "!{infra,scripts,vite}/**/*.test.*"
      ]
    },
    "test:follow": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "!src/home/**/*.test.*",
        "!src/player/**/*.test.*",
        "!src/reader/**/*.test.*",
        "!src/hymns/**/*.test.*",
        "!src/{tuner,feel,offline,test}/**/*.test.*",
        "!src/*.test.*",
        "!{infra,scripts,vite}/**/*.test.*"
      ]
    },
    "test:hymns": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "!src/home/**/*.test.*",
        "!src/player/**/*.test.*",
        "!src/reader/**/*.test.*",
        "!src/follow/**/*.test.*",
        "!src/{tuner,feel,offline,test}/**/*.test.*",
        "!src/*.test.*",
        "!{infra,scripts,vite}/**/*.test.*"
      ]
    },
    "test:rest": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"]
    },
    "test:infra": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/.claude/skills/verify-hymnal/features/*.journey.json"
      ]
    },
    "test:slow": {
      "passThroughEnv": ["HYMNAL_LIST_SEED"]
    },
    "test": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "test:search",
        "test:home",
        "test:tempo",
        "test:player",
        "test:bar",
        "test:reader",
        "test:seek",
        "test:follow",
        "test:hymns",
        "test:rest",
        "test:infra"
      ]
    }
  }
}
