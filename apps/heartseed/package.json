{
  "name": "@manna/heartseed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "one dev",
    "prebuild:native": "one prebuild",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo && tsc --noEmit -p tsconfig.test.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/test.tsbuildinfo",
    "test": "bun test --no-isolate --parallel=3 --preload ./src/test/setup.ts --path-ignore-patterns='**/*.slow.test.*' ./src ./vite"
  },
  "dependencies": {
    "@manna/core": "workspace:*",
    "@react-navigation/native": "8.0.0-alpha.51",
    "effect": "catalog:",
    "one": "2.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.3",
    "@react-native-community/template": "0.88.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxc-parser": "0.153.0",
    "vite": "8.3.4"
  }
}
