{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test:matcher": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/packages/core/assets/kjv.json",
        "!src/{core-import.property,core-import,display,matcher,today,voice.property}.test.*",
        "!src/voice/**/*.test.*",
        "!{scripts,vite}/**/*.test.*"
      ]
    },
    "test:voice": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/packages/core/assets/kjv.json",
        "!src/{core-import.property,core-import,display,matcher.property,matcher,today}.test.*",
        "!{scripts,vite}/**/*.test.*"
      ]
    },
    "test:rest": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/packages/core/assets/kjv.json"
      ]
    },
    "test:infra": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/packages/core/assets/kjv.json"
      ]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "test:matcher", "test:voice", "test:rest", "test:infra"]
    }
  }
}
