{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["react", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vite/plugin.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "ios",
    "android",
    "src/test",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
