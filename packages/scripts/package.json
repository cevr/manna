  "type": "module",
  "scripts": {
    "build:webster": "bun src/webster-compiler/main.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo && bun src/typecheck-coverage.ts",
    "test": "bun test --parallel=4 --path-ignore-patterns='**/*.slow.test.*' src lint",
    "test:slow": "bun test --parallel=4 .slow.test.",
    "build:topics": "bun src/topics-compiler/main.ts",
    "build:vectors": "bun src/vector-compiler/main.ts",
    "dead-exports": "bun src/dead-exports.ts",
    "judged:measure": "bun --no-env-file src/judged/measure.ts",
    "judged:quality": "bun --no-env-file src/judged/quality-run.ts"
  },
  "dependencies": {
    "@effect/ai-typesafe": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@manna/core": "workspace:*",
    "@manna/film": "workspace:*",
    "effect": "catalog:",
    "minimatch": "10.2.5",
    "oxc-parser": "0.153.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "effect-bun-test": "catalog:"
  }
