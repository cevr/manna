+    /// The agent's `type <range> adjust up|down`: the slider's accessibility
+    /// increment or decrement, as VoiceOver's swipe performs it.
+    func adjust(_ node: NodeView, up: Bool) -> [String: Any] {
+        guard let slider = controls[node.id] as? RangeSlider else { return ["error": "view \(node.id) is not a range: adjust moves an `input type=\"range\"`"] }
+        guard slider.isEnabled, !node.inert else { return ["error": "control #\(node.id) is disabled or inert"] }
+        if up { slider.accessibilityIncrement() } else { slider.accessibilityDecrement() }
+        return ["typed": Int(node.id), "value": RangeSpec.format(slider.exact), "delivery": "host-activation", "native": "control"]
+    }
+
+    /// VoiceOver's swipe up or down. A written `adjust-step` is one move;
+    /// else, as WebKit adjusts a range, a written `step`; without one, or
+    /// with `any`, a twentieth of the span, at least the default step.
