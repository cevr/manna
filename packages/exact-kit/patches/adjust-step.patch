+import { test, expect, beforeAll, afterAll } from 'bun:test';
+import { resolve } from 'node:path';
+import { readFileSync } from 'node:fs';
+import { suiteBrowser } from '../../../scripts/agent-launch.mjs';
+
+// `adjust-step` on a range (`data-exact-adjust-step`): an arrow key, the adjust a desktop screen reader sends, moves
+// it by that much and no further than its ends, `input` then `change`, where the browser's own arrow moves by `step`.
+// A range without it keeps the browser's arrow. Real key presses, through the input glue both web targets load.
+let server;
+beforeAll(() => {
+  server = Bun.serve({ hostname: '127.0.0.1', port: 0, fetch(request) {
+    const path = new URL(request.url).pathname;
+    if (path === '/') return new Response(`<!doctype html><div id="root">
+      <input id="seek" type="range" min="0" max="240" value="40" data-exact-adjust-step="10" aria-label="Seek">
+      <input id="plain" type="range" min="0" max="240" value="40" aria-label="Plain">
+      <input id="off" type="range" min="0" max="240" value="40" data-exact-adjust-step="10" disabled aria-label="Off"></div>`, { headers: { 'Content-Type': 'text/html' } });
+    if (path === '/favicon.ico') return new Response(null, { status: 204 });
+    if (path.startsWith('/web/')) return new Response(readFileSync(resolve(import.meta.dir, '..', path.slice(5))), { headers: { 'Content-Type': 'text/javascript' } });
+    return new Response(null, { status: 404 });
+  } });
+});
+afterAll(() => server?.stop(true));
+
+test('chromium: an arrow moves a range by its adjust-step, to its ends', async () => {
+  const browser = await suiteBrowser('chromium');
+  try {
+    const page = await browser.newPage();
+    await page.goto(server.url.href);
+    await page.evaluate(async () => {
+      const { createInputHandlers } = await import('/web/input-glue.js'), root = document.getElementById('root');
+      createInputHandlers({ root, views: new Map(), retiredViews: new Set(), ready: () => true, inertAncestor: () => null, editMenu: () => false, dispatch() {} });
+      window.heard = [];
+      for (const el of root.querySelectorAll('input')) for (const kind of ['input', 'change']) el.addEventListener(kind, () => window.heard.push(`${el.id} ${kind} ${el.value}`));
+    });
+    const press = async (id, key) => { await page.focus(`#${id}`); await page.keyboard.press(key); return page.evaluate(() => window.heard.splice(0)); };
+    expect(await press('seek', 'ArrowUp')).toEqual(['seek input 50', 'seek change 50']);
+    expect(await press('seek', 'ArrowLeft')).toEqual(['seek input 40', 'seek change 40']);
+    expect(await press('seek', 'ArrowRight')).toEqual(['seek input 50', 'seek change 50']);
+    expect(await press('seek', 'ArrowDown')).toEqual(['seek input 40', 'seek change 40']);
+    await page.evaluate(() => { document.getElementById('seek').value = '235'; });
+    expect(await press('seek', 'ArrowUp')).toEqual(['seek input 240', 'seek change 240']);
+    expect(await press('seek', 'ArrowUp')).toEqual([]);
+    await page.evaluate(() => { document.getElementById('seek').value = '4'; });
+    expect(await press('seek', 'ArrowDown')).toEqual(['seek input 0', 'seek change 0']);
+    expect(await press('plain', 'ArrowUp')).toEqual(['plain input 41', 'plain change 41']);
+    expect(await page.evaluate(() => document.getElementById('off').value)).toBe('40');
+  } finally { await browser.close(); }
+}, 30000);
