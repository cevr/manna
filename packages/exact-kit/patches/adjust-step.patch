+/// `adjust-step` is a range's: how far one accessibility adjust moves it,
+/// a positive number when written as a literal.
+fn adjust_step(tag: &str, attrs: &[contract_syntax::Attr]) -> Result<(), LowerError> {
+    let Some(a) = attrs.iter().find(|a| a.name == "adjust-step") else {
+        return Ok(());
+    };
+    if contract_syntax::input_control(tag, attrs) != Some("range") {
+        return err(
+            "lower-attr-tag",
+            "`adjust-step` belongs to `input type=\"range\"`: how far one accessibility adjust moves it",
+            a.span,
+        );
+    }
+    let literal = match &a.value {
+        Expr::Str(s, _) => Some(s.trim().parse::<f64>().unwrap_or(f64::NAN)),
+        e => super::values::numeric_literal(e),
+    };
+    if literal.is_some_and(|n| !(n.is_finite() && n > 0.0)) {
+        return err(
+            "lower-attr-value",
+            "`adjust-step` is a positive number: `adjust-step=10`",
+            a.span,
+        );
+    }
+    Ok(())
+}
