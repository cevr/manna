+/// One accessibility adjust of a range is a step, `up` or `down`.
+#[test]
+fn adjust_steps_parse_and_print() {
+    let tests =
+        contract::tests("test \"seek\"\n  type \"bar\" adjust up\n  type \"bar\" adjust down\n")
+            .unwrap();
+    let steps = &tests[0].steps;
+    assert!(
+        matches!(&steps[0], Step::Adjust { target, direction, .. } if target == "bar" && direction == "up")
+    );
+    assert!(matches!(&steps[1], Step::Adjust { direction, .. } if direction == "down"));
+    let json = contract::tests_json(&tests);
+    assert!(
+        json.contains("{\"op\":\"adjust\",\"target\":\"bar\",\"direction\":\"down\",\"line\":3}"),
+        "{json}"
+    );
+    let e = contract::tests("test \"seek\"\n  type \"bar\" adjust left\n").unwrap_err();
+    assert_eq!(e.id, "syntax-expected-step");
+}
