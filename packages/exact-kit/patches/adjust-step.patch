+/// `adjust-step` is a range's, a positive number, carried as HTML's text
+/// beside `step`; on any other tag, or zero, it is refused.
+#[test]
+fn adjust_step_is_a_ranges_positive_number() {
+    let r = boot(
+        r#"component App
+  state at = 40
+  state by = 5
+  view
+    column
+      input type="range" min=0 max=240 value=at adjust-step=10 testId="seek" aria-label="Seek"
+      input type="range" min=0 max=240 value=at adjust-step=by step="any" testId="bound" aria-label="Bound"
+"#,
+    );
+    let prop = |id: &str, p: PropId| {
+        r.kernel()
+            .node(view_of(&r, id))
+            .unwrap()
+            .props
+            .str(p)
+            .map(str::to_owned)
+    };
+    assert_eq!(prop("seek", PropId::AdjustStep).as_deref(), Some("10"));
+    assert_eq!(prop("seek", PropId::Step), None);
+    assert_eq!(prop("bound", PropId::AdjustStep).as_deref(), Some("5"));
+    for (view, id) in [
+        ("input type=\"checkbox\" adjust-step=10", "lower-attr-tag"),
+        ("input adjust-step=10", "lower-attr-tag"),
+        ("view adjust-step=10", "lower-attr-tag"),
+        ("input type=\"range\" adjust-step=0", "lower-attr-value"),
+        ("input type=\"range\" adjust-step=-10", "lower-attr-value"),
+        (
+            "input type=\"range\" adjust-step=\"ten\"",
+            "lower-attr-value",
+        ),
+    ] {
+        let src = format!("component App\n  view\n    {view}\n");
+        let e = contract::compile(&src).unwrap_err();
+        assert_eq!(e.id, id, "{view}: {e:?}");
+    }
+}
