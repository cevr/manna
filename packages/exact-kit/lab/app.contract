// Exact Lab: the Effect probe of ex-effect (docs/exact-data-layer.md). Each row's button asks
// app.ts to run one probe, with Effect's defaults or through @manna/exact-kit/effect's runner,
// on the call's time and seed; what it did shows beside the button.
shape Time
  epochAtZero: number
  seed: number

shape Outcome
  key: string
  text: string

shape Probe
  key: string
  label: string
  text: string

component ExactLab
  state outcomes = []
  resource time = exactTime() as shape Time
  resource probes = probes(outcomes) as shape Probe[] else empty()
  mutation ran as shape Outcome queue then landed
  action ask(key: string)
    send ran = probe(key, time.epochAtZero + performanceNow(), time.seed)
  action landed
    outcomes = match ran { case some(o) => outcomes.concat([o]), case none => outcomes }
  view
    main testId="root" width="100%" height="100%"
      scroll id="content" flex=1 min-height=0 padding=16 height="100%"
        column gap=8
          text "Exact Lab" role="heading" aria-level=1 testId="title"
          for p in probes key=p.key
            row gap=8 align-items="center"
              button press=ask(p.key) testId=`ask-${p.key}`
                text p.label
              text p.text testId=`out-${p.key}`
