{
  "name": "@manna/exact-kit",
  "private": true,
  "bin": {
    "manna-exact": "./src/bin.ts"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./main": "./src/main.ts",
    "./prepare": "./src/prepare/prepare.ts",
    "./drive": "./src/drive/drive.ts",
    "./effect": {
      "types": "./src/effect/runner.d.ts",
      "default": "./src/effect/runner.ts"
    },
    "./data-host/testing": "./src/data-host/testing.ts",
    "./no-copy/testing": "./src/no-copy/testing.ts"
  },
  "scripts": {
    "exact": "bun lab/tools/prepare.ts && cd lab && bun ../src/bin.ts",
    "drive:lab": "bun lab/tools/drive.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "test": "bun test ./src"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "effect-bun-test": "catalog:"
  }
}
