  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "test:lab": "bun test --parallel=2 --no-isolate --max-concurrency=3 --preload ./src/lab/fixtures/unit-tmp.ts --timings=node_modules/.cache/bun-test/timings-lab.json --update-timings --path-ignore-patterns='**/*.slow.test.*' ./src/lab ./src/tools/ask-evidence.test.ts ./src/tools/ask-store.test.ts ./src/tools/ask-wait.test.ts ./src/tools/board-cli.test.ts ./src/tools/board-http.test.ts ./src/tools/board-make.test.ts ./src/tools/board-stale.test.ts ./src/tools/choice-points.test.ts ./src/tools/choice-source.test.ts ./src/tools/choices-cli.test.ts ./src/tools/choices.test.ts ./src/tools/easel-client.test.ts ./src/tools/easel-mcp.test.ts ./src/tools/lab-command.test.ts ./src/tools/lab-events.test.ts ./src/tools/lab-gate.test.ts ./src/tools/lab-home.test.ts ./src/tools/mcp-calls.test.ts ./src/tools/sets-mcp.test.ts ./src/tools/timeline-mcp.test.ts",
    "test:tools": "bun test --parallel=6 --no-isolate --max-concurrency=3 --preload ./src/lab/fixtures/unit-tmp.ts --timings=node_modules/.cache/bun-test/timings-tools.json --update-timings --path-ignore-patterns='**/*.slow.test.*' --path-ignore-patterns=src/tools/ask-evidence.test.ts --path-ignore-patterns=src/tools/ask-store.test.ts --path-ignore-patterns=src/tools/ask-wait.test.ts --path-ignore-patterns=src/tools/board-cli.test.ts --path-ignore-patterns=src/tools/board-http.test.ts --path-ignore-patterns=src/tools/board-make.test.ts --path-ignore-patterns=src/tools/board-stale.test.ts --path-ignore-patterns=src/tools/choice-points.test.ts --path-ignore-patterns=src/tools/choice-source.test.ts --path-ignore-patterns=src/tools/choices-cli.test.ts --path-ignore-patterns=src/tools/choices.test.ts --path-ignore-patterns=src/tools/easel-client.test.ts --path-ignore-patterns=src/tools/easel-mcp.test.ts --path-ignore-patterns=src/tools/lab-command.test.ts --path-ignore-patterns=src/tools/lab-events.test.ts --path-ignore-patterns=src/tools/lab-gate.test.ts --path-ignore-patterns=src/tools/lab-home.test.ts --path-ignore-patterns=src/tools/mcp-calls.test.ts --path-ignore-patterns=src/tools/sets-mcp.test.ts --path-ignore-patterns=src/tools/timeline-mcp.test.ts ./src/tools",
    "test:engine": "bun test --parallel=4 --no-isolate --max-concurrency=3 --preload ./src/lab/fixtures/unit-tmp.ts --timings=node_modules/.cache/bun-test/timings-engine.json --update-timings --path-ignore-patterns='**/*.slow.test.*' --path-ignore-patterns=src/tools --path-ignore-patterns=src/lab src lint",
    "test:slow": "bun test --parallel --no-isolate --max-concurrency=3 .slow.test. && bun run test:e2e",
    "test:e2e": "bun src/lab/fixtures/run-suite.ts --parallel --no-isolate --max-concurrency=3 --preload ./e2e/preload.ts --timeout 20000 e2e",
    "test:e2e:check": "bun src/lab/fixtures/e2e-check.ts",
    "test:perf": "bun test test/perf"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
