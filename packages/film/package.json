{
  "name": "@manna/film",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./src/core/api.ts",
    "./core": "./src/core/index.ts",
    "./canvas": "./src/canvas/index.ts",
    "./player": "./src/player/index.ts",
    "./render": "./src/player/render.ts",
    "./player.css": "./src/player/player.css",
    "./tokens.css": "./src/player/tokens.css",
    "./tools": "./src/tools/index.ts",
    "./ask": "./src/lab/ask/mount.tsx",
    "./ask-server": "./src/lab/ask/server.tsx",
    "./solid-plugin": "./src/tools/solid-plugin.ts",
    "./stand-in": "./src/canvas/fixtures/stand-in.ts",
    "./rive": "./src/canvas/rive.ts",
    "./style": "./src/style/index.ts",
    "./style/build": "./src/style/build.ts",
    "./measure": "./src/measure.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "test": "bun test --parallel=6 --no-isolate --max-concurrency=3 --preload ./src/lab/fixtures/unit-tmp.ts --timings=node_modules/.cache/bun-test/timings.json --update-timings --path-ignore-patterns='**/*.slow.test.*' src lint",
    "test:slow": "bun test --parallel --no-isolate --max-concurrency=3 .slow.test. && bun run test:e2e",
    "test:e2e": "bun src/lab/fixtures/run-suite.ts --parallel --no-isolate --max-concurrency=3 --preload ./e2e/preload.ts --timeout 20000 e2e",
    "test:e2e:check": "bun src/lab/fixtures/e2e-check.ts",
    "test:perf": "bun test test/perf"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@manna/atom-solid": "workspace:*",
    "@manna/ui": "workspace:*",
    "@manna/url-state": "workspace:*",
    "@mediabunny/aac-encoder": "1.61.3",
    "@mediabunny/flac-encoder": "1.61.3",
    "@mediabunny/server": "1.61.3",
    "@rive-app/canvas-advanced": "2.43.1",
    "@rive-app/webgl2-advanced": "2.43.1",
    "@solidjs/compiler": "catalog:",
    "@solidjs/web": "catalog:",
    "effect": "catalog:",
    "effect-machine": "catalog:",
    "math": "0.1.0",
    "mediabunny": "1.61.3",
    "mpg123-decoder": "1.0.3",
    "node-av": "6.1.1",
    "oxc-parser": "0.153.0",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "effect-bun-test": "catalog:"
  }
}
