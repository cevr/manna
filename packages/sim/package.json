{
  "name": "@manna/sim",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./check": "./src/check.ts",
    "./command": "./src/command.ts",
    "./drive": "./src/drive.ts",
    "./errors": "./src/errors.ts",
    "./result": "./src/result.ts",
    "./screen": "./src/screen.ts",
    "./tools": "./src/tools.ts",
    "./journey": "./src/journey.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "test:host": "bun test --path-ignore-patterns='**/*.slow.test.*' ./src/host.test.ts",
    "test:drive": "bun test --parallel=3 --path-ignore-patterns='**/*.slow.test.*' --path-ignore-patterns=src/host.test.ts ./src",
    "test:slow": "bun test .slow.test.",
    "census:slow": "bun src/census-run.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "effect-bun-test": "catalog:"
  }
}
