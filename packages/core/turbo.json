{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json", "dist-native/**"]
    },
    "test:slow": {
      "passThroughEnv": ["BIBLE_MODEL_CACHE"]
    },
    "transit": {
      "inputs": ["$TURBO_DEFAULT$", "dist-native/**"]
    }
  }
}
