{
  "name": "@manna/hymnal",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./chord": "./src/chord.ts",
    "./fold": "./src/fold.ts",
    "./hymn": "./src/hymn.ts",
    "./indexes": "./src/indexes.ts",
    "./recordings": "./src/recordings.ts",
    "./recording-manifest": "./src/recording-manifest.ts",
    "./timing": "./src/timing.ts",
    "./placement": "./src/placement.ts",
    "./playback": "./src/playback.ts",
    "./playback/build": "./scripts/playback.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "test": "bun test --path-ignore-patterns='**/*.slow.test.*'",
    "test:slow": "bun test .slow.test.",
    "align": "bun scripts/align.ts",
    "chart": "bun scripts/chart.ts",
    "census": "bun scripts/census.ts",
    "compile": "bun scripts/compile.ts",
    "playback": "bun scripts/playback.ts",
    "compile:db": "bun scripts/compile-db.ts",
    "golden": "bun scripts/golden.ts",
    "indexes": "bun scripts/indexes.ts",
    "meaning": "bun scripts/meaning/build.ts --out ../../apps/hymnal/assets/meaning/meaning.js",
    "render": "bun scripts/render/render.ts",
    "split": "bun scripts/split.ts",
    "sync-check": "bun scripts/sync-check.ts"
  },
  "dependencies": {
    "cmu-pronouncing-dictionary": "3.0.0",
    "effect": "catalog:",
    "syllable": "5.0.1"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@manna/core": "workspace:*",
    "@manna/film": "workspace:*",
    "effect-bun-test": "catalog:",
    "node-av": "6.1.1"
  }
}
